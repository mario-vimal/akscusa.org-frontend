---
interface Props {
  href: string;
  /** `light` is for the dark masthead, `dark` for a light page. */
  tone?: "light" | "dark";
}

const { href, tone = "dark" } = Astro.props;

const toneClasses = {
  light: "text-white/70 hover:text-white",
  dark: "text-ambedkar-900/70 hover:text-ambedkar-950",
};
---

<!--
  A plain link with an arrow rather than a bordered chip. Boxing every
  navigational aid puts a control where a sentence would do, and the row of
  them was the first thing on each detail page.
-->
<a
  class:list={[
    "group inline-flex min-h-11 items-center gap-2 font-display text-[0.8125rem] font-medium tracking-[0.02em] transition-colors",
    toneClasses[tone],
  ]}
  href={href}
>
  <span
    class="inline-block transition-transform duration-300 ease-[var(--ease-out-firm)] group-hover:-translate-x-1"
    aria-hidden="true">&larr;</span
  >
  <slot />
</a>
