---
import type { ImageMetadata } from "astro";

import emblem from "~/assets/brand/aksc-emblem.webp";
import Container from "./Container.astro";
import ResponsiveImage from "./ResponsiveImage.astro";

interface ImageCredit {
  creator: string;
  sourceHref: string;
  license: string;
  licenseHref: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  /** Printed beside the description, for example "38 entries". */
  meta?: string;
  /** Widens the measure for pages whose title is a full sentence. */
  size?: "default" | "large";
  /** Optional decorative photograph behind the masthead content. */
  backgroundImage?: ImageMetadata;
  /** Identifies people shown in an archival background image. */
  backgroundLabel?: string;
  /** Required attribution for a Creative Commons background image. */
  backgroundCredit?: ImageCredit;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  meta,
  size = "default",
  backgroundImage,
  backgroundLabel,
  backgroundCredit,
  class: className,
} = Astro.props;

const hasAbove = Astro.slots.has("above");

/*
 * Whether the photograph is taller than it is wide, worked out from the file
 * rather than asked of the caller. It decides only how much of the band an
 * upright picture may take from `lg`.
 */
const isUpright = backgroundImage
  ? backgroundImage.height / backgroundImage.width > 1.1
  : false;

/*
 * The picture keeps its own proportions at every width: full height, automatic
 * width, flush to the right edge of the band.
 *
 * Stretching it across the band with `object-cover` meant the band enlarged the
 * picture until it filled a shape the picture does not have, which on a phone
 * showed a mouth or a single eye blown up across the screen. No amount of
 * `object-position` fixes that, because the mismatch is the aspect ratio and
 * not the framing.
 *
 * Full height with an automatic width never enlarges past the band, so nothing
 * is zoomed. An upright picture ends up occupying the right third or so and the
 * ink carries the rest; a landscape one is wider than the band and loses its
 * left edge, which is where the reading column sits anyway. From `lg` it is
 * held to roughly half the band so the text column stays clear of it. It fades
 * out at its left edge so the picture joins the panel rather than sitting on it
 * as a pasted rectangle.
 */
const backgroundClasses = [
  "absolute inset-y-0 right-0 -z-30 h-full w-auto max-w-full object-cover object-center duotone",
  "[mask-image:linear-gradient(to_right,transparent_0%,black_34%)]",
  isUpright ? "lg:max-w-[46%]" : "lg:max-w-[58%]",
].join(" ");

/*
 * One scrim for both. It is heavy everywhere below `lg`, where the band is
 * narrow enough that the text runs across the picture, and thins out to the
 * right from `lg`, where the picture has moved off the reading column and has
 * to stay legible.
 */
const scrimClasses = [
  "absolute inset-0 -z-10 bg-linear-to-r",
  "from-ambedkar-1000/96 via-ambedkar-950/88 to-ambedkar-950/78",
  "lg:from-ambedkar-1000/95 lg:from-30% lg:via-ambedkar-950/70 lg:to-ambedkar-950/25",
].join(" ");
---

<!--
  The masthead every page opens with. It is the one place the Ambedkar blue runs
  at full strength, so the brand colour leads each page rather than only edging
  it. Optional photographs remain decorative and are returned to the palette by
  the blue tint; the dark gradient protects the text across every image crop.

  The panel is a flat field with the column grid drawn faintly across it. The
  blurred colour blobs that used to sit here were decoration standing in for
  structure, and every generated page has them.
-->
<div
  class:list={[
    "on-dark relative isolate overflow-hidden bg-ambedkar-950 text-white",
    className,
  ]}
>
  {
    backgroundImage ? (
      <>
        <ResponsiveImage
          src={backgroundImage}
          alt=""
          class={backgroundClasses}
          loading="eager"
          sizes={
            isUpright
              ? "(min-width: 1024px) 46vw, 100vw"
              : "(min-width: 1024px) 58vw, 100vw"
          }
          widths={[640, 960, 1280, 1600]}
        />
        <div
          class="absolute inset-0 -z-20 bg-ambedkar-800 mix-blend-color"
          aria-hidden="true"
        />
        <div class={scrimClasses} aria-hidden="true" />
      </>
    ) : (
      <>
        <div
          class="absolute inset-0 -z-20 bg-linear-to-b from-ambedkar-900 to-ambedkar-1000"
          aria-hidden="true"
        />
        {/*
          A page with no photograph of its own opens on the organisation's mark
          instead of on an empty gradient, the same way the homepage does. It is
          anchored to the right and run past the edges so it reads as a mark the
          masthead is printed over rather than as a logo parked in a corner, and
          the ramp below keeps it clear of the heading it sits behind.
        */}
        <div class="absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
          <ResponsiveImage
            src={emblem}
            alt=""
            class="absolute top-1/2 -right-[30%] w-[118%] max-w-none -translate-y-1/2 opacity-25 sm:-right-[16%] sm:w-[80%] lg:-right-[4%] lg:w-[52%]"
            loading="eager"
            sizes="(min-width: 1024px) 52vw, (min-width: 640px) 80vw, 118vw"
            widths={[480, 768, 1114]}
          />
        </div>
        <div
          class="absolute inset-0 -z-10 bg-linear-to-r from-ambedkar-1000/92 via-ambedkar-950/80 to-ambedkar-950/55"
          aria-hidden="true"
        />
      </>
    )
  }
  <div class="absolute inset-0 -z-10 grain opacity-[0.035]" aria-hidden="true">
  </div>

  <Container class="pt-14 pb-16 sm:pt-20 sm:pb-24">
    <slot name="above" />

    <div
      class:list={[
        "rise",
        size === "large" ? "max-w-5xl" : "max-w-4xl",
        hasAbove && "mt-10",
      ]}
    >
      <p class="eyebrow eyebrow-light">{eyebrow}</p>
      <h1
        class="mt-6 font-display text-display-lg leading-[0.98] font-bold tracking-display text-balance"
      >
        {title}
      </h1>
      {
        description && (
          <p class="mt-7 max-w-2xl font-serif text-xl leading-[1.65] text-white/75 sm:text-[1.375rem]">
            {description}
          </p>
        )
      }
      {
        meta && (
          <p class="mt-8 font-display text-xs font-semibold tracking-[0.14em] text-white/70 uppercase">
            {meta}
          </p>
        )
      }
    </div>

    <slot />
  </Container>

  {
    backgroundImage && (backgroundLabel || backgroundCredit) && (
      <div class="absolute right-4 bottom-4 max-w-[calc(100%-2rem)] text-right sm:right-6 sm:bottom-5">
        {backgroundLabel && (
          <p class="font-display text-[0.625rem] font-semibold tracking-[0.12em] text-white/65 uppercase [text-shadow:0_1px_4px_var(--color-ambedkar-1000)]">
            Pictured: {backgroundLabel}
          </p>
        )}
        {backgroundCredit && (
          <p class="mt-1 text-[0.6875rem] leading-4 text-white/55 [text-shadow:0_1px_4px_var(--color-ambedkar-1000)]">
            Image:{" "}
            <a
              class="underline decoration-white/25 underline-offset-2 hover:text-white"
              href={backgroundCredit.sourceHref}
            >
              {backgroundCredit.creator}
            </a>{" "}
            ·{" "}
            <a
              class="underline decoration-white/25 underline-offset-2 hover:text-white"
              href={backgroundCredit.licenseHref}
              rel="license"
            >
              {backgroundCredit.license}
            </a>{" "}
            · cropped and recolored
          </p>
        )}
      </div>
    )
  }
</div>
