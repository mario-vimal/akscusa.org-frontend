---
import type { ImageMetadata } from "astro";

import emblem from "~/assets/brand/aksc-emblem.webp";
import Container from "./Container.astro";
import ResponsiveImage from "./ResponsiveImage.astro";

interface ImageCredit {
  creator: string;
  sourceHref: string;
  license: string;
  licenseHref: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  /** Printed beside the description, for example "38 entries". */
  meta?: string;
  /** Widens the measure for pages whose title is a full sentence. */
  size?: "default" | "large";
  /** Optional decorative photograph behind the masthead content. */
  backgroundImage?: ImageMetadata;
  /** Identifies people shown in an archival background image. */
  backgroundLabel?: string;
  /** Required attribution for a Creative Commons background image. */
  backgroundCredit?: ImageCredit;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  meta,
  size = "default",
  backgroundImage,
  backgroundLabel,
  backgroundCredit,
  class: className,
} = Astro.props;

const hasAbove = Astro.slots.has("above");

/*
 * Whether the photograph is taller than it is wide, worked out from the file
 * rather than asked of the caller. It decides which edge of the band the
 * picture is hung from, and how much of the band it may take from `lg`.
 */
const isUpright = backgroundImage
  ? backgroundImage.height / backgroundImage.width > 1.1
  : false;

/*
 * The picture keeps its own proportions at every width, so it is never enlarged
 * to fill a shape it does not have. Which edge it hangs from depends on which
 * way round it is, because a phone band is taller than it is wide and a desktop
 * band is much wider than it is tall.
 *
 * An upright picture hangs from the right at full height. It is narrower than
 * the band, so the ink carries the rest.
 *
 * A landscape picture hangs from the bottom at full width below `md`. Giving it
 * full height there instead — the shape of the band, not the shape of the
 * picture — meant a 3:2 photograph was scaled until only the middle half of it
 * was left on screen, which is a sculpture reduced to an unreadable slab. Full
 * width shows the whole picture at the foot of the band and lets the type sit
 * on the ink above it. From `md` the band is wide enough that the same picture
 * hangs from the right at full height, and from `lg` it is held to roughly half
 * the width so the reading column stays clear of it.
 *
 * `max-w-none` matters below the width cap: clamping an element to the band is
 * what reintroduces a crop, because the element then stops matching the picture
 * and the object fit makes up the difference. Where a cap is deliberate it can
 * only bite by a few per cent, so a right-hung picture covers and loses a sliver
 * of the edge the mask is already fading. The bottom-hung one contains instead,
 * because there is no cap on it and nothing to hide a horizontal seam.
 *
 * Each fades out along the edge it enters from, so the picture joins the panel
 * rather than sitting on it as a pasted rectangle.
 */
const backgroundClasses = (
  isUpright
    ? [
        "absolute inset-y-0 right-0 -z-30 h-full w-auto max-w-none object-cover object-right duotone",
        "[mask-image:linear-gradient(to_right,transparent_0%,black_34%)]",
        "lg:max-w-[46%]",
      ]
    : [
        "absolute inset-x-0 bottom-0 -z-30 h-auto w-full object-contain object-bottom duotone",
        "[mask-image:linear-gradient(to_top,black_58%,transparent_100%)]",
        "md:inset-y-0 md:right-0 md:left-auto md:h-full md:w-auto md:max-w-none md:object-cover md:object-right",
        "md:[mask-image:linear-gradient(to_right,transparent_0%,black_34%)]",
        "lg:max-w-[58%]",
      ]
).join(" ");

/*
 * The scrim follows the picture, so it turns at the same width the picture
 * does. While an upright picture is on the right and a landscape one is at the
 * foot of the band, the ramp runs across for the first and down for the second;
 * the down ramp lets go near the bottom, where only the credit sits and it
 * carries its own text shadow. Keeping the horizontal ramp there buried the
 * picture in ink.
 *
 * Once a picture has moved to the right of a wide band, off the reading column,
 * one ramp thinning to the right serves it.
 */
const scrimClasses = [
  "absolute inset-0 -z-10",
  isUpright
    ? "bg-linear-to-r from-ambedkar-1000/96 via-ambedkar-950/88 to-ambedkar-950/78"
    : [
        "bg-linear-to-b from-ambedkar-1000/94 via-ambedkar-950/82 via-60% to-ambedkar-950/50",
        "md:bg-linear-to-r md:from-ambedkar-1000/96 md:via-ambedkar-950/88 md:via-50% md:to-ambedkar-950/60",
      ].join(" "),
  "lg:bg-linear-to-r lg:from-ambedkar-1000/95 lg:from-30% lg:via-ambedkar-950/70 lg:via-50% lg:to-ambedkar-950/38",
].join(" ");
---

<!--
  The masthead every page opens with. It is the one place the Ambedkar blue runs
  at full strength, so the brand colour leads each page rather than only edging
  it. Optional photographs remain decorative and are returned to the palette by
  the blue tint; the dark gradient protects the text across every image crop.

  The panel is a flat field with the column grid drawn faintly across it. The
  blurred colour blobs that used to sit here were decoration standing in for
  structure, and every generated page has them.
-->
<div
  class:list={[
    "on-dark relative isolate overflow-hidden bg-ambedkar-950 text-white",
    className,
  ]}
>
  {
    backgroundImage ? (
      <>
        <ResponsiveImage
          src={backgroundImage}
          alt=""
          class={backgroundClasses}
          loading="eager"
          sizes={
            isUpright
              ? "(min-width: 1024px) 46vw, 100vw"
              : "(min-width: 1024px) 58vw, (min-width: 768px) 80vw, 100vw"
          }
          widths={[640, 960, 1280, 1600]}
        />
        <div
          class="absolute inset-0 -z-20 bg-ambedkar-800 mix-blend-color"
          aria-hidden="true"
        />
        <div class={scrimClasses} aria-hidden="true" />
      </>
    ) : (
      <>
        <div
          class="absolute inset-0 -z-20 bg-linear-to-b from-ambedkar-900 to-ambedkar-1000"
          aria-hidden="true"
        />
        {/*
          A page with no photograph of its own opens on the organisation's mark
          instead of on an empty gradient, the same way the homepage does. It is
          anchored to the right and run past the edges so it reads as a mark the
          masthead is printed over rather than as a logo parked in a corner, and
          the ramp below keeps it clear of the heading it sits behind.
        */}
        <div class="absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
          <ResponsiveImage
            src={emblem}
            alt=""
            class="absolute top-1/2 -right-[30%] w-[118%] max-w-none -translate-y-1/2 opacity-25 sm:-right-[16%] sm:w-[80%] lg:-right-[4%] lg:w-[52%]"
            loading="eager"
            sizes="(min-width: 1024px) 52vw, (min-width: 640px) 80vw, 118vw"
            widths={[480, 768, 1114]}
          />
        </div>
        <div
          class="absolute inset-0 -z-10 bg-linear-to-r from-ambedkar-1000/92 via-ambedkar-950/80 to-ambedkar-950/55"
          aria-hidden="true"
        />
      </>
    )
  }
  <div class="absolute inset-0 -z-10 grain opacity-[0.035]" aria-hidden="true">
  </div>

  <Container class="pt-14 pb-16 sm:pt-20 sm:pb-24">
    <slot name="above" />

    <div
      class:list={[
        "rise",
        size === "large" ? "max-w-5xl" : "max-w-4xl",
        hasAbove && "mt-10",
      ]}
    >
      <p class="eyebrow eyebrow-light">{eyebrow}</p>
      <h1
        class="mt-6 font-display text-display-lg leading-[0.98] font-bold tracking-display text-balance"
      >
        {title}
      </h1>
      {
        description && (
          <p class="mt-7 max-w-2xl font-serif text-xl leading-[1.65] text-white/75 sm:text-[1.375rem]">
            {description}
          </p>
        )
      }
      {
        meta && (
          <p class="mt-8 font-display text-xs font-semibold tracking-[0.14em] text-white/70 uppercase">
            {meta}
          </p>
        )
      }
    </div>

    <slot />

    {
      /*
      The attribution a Creative Commons photograph requires. It is pinned to
      the corner of the panel from `sm`, where there is room for it beside the
      reading column.

      Below that it stays in the flow, under the content it belongs to. Pinning
      it on a phone put a three-line credit on top of the masthead's own meta
      line, because an absolute box cannot know how tall the text above it has
      wrapped to; the two simply printed over each other.
    */
    }
    {
      backgroundImage && (backgroundLabel || backgroundCredit) && (
        <div class="mt-10 sm:absolute sm:right-6 sm:bottom-5 sm:mt-0 sm:max-w-[calc(100%-3rem)] sm:text-right">
          {backgroundLabel && (
            <p class="font-display text-[0.625rem] font-semibold tracking-[0.12em] text-white/90 uppercase [text-shadow:0_1px_4px_var(--color-ambedkar-1000)]">
              Pictured: {backgroundLabel}
            </p>
          )}
          {backgroundCredit && (
            <p class="mt-1 text-[0.6875rem] leading-4 text-white/85 [text-shadow:0_1px_4px_var(--color-ambedkar-1000)]">
              Image:{" "}
              <a
                class="underline decoration-white/25 underline-offset-2 hover:text-white"
                href={backgroundCredit.sourceHref}
              >
                {backgroundCredit.creator}
              </a>{" "}
              ·{" "}
              <a
                class="underline decoration-white/25 underline-offset-2 hover:text-white"
                href={backgroundCredit.licenseHref}
                rel="license"
              >
                {backgroundCredit.license}
              </a>{" "}
              · cropped and recolored
            </p>
          )}
        </div>
      )
    }
  </Container>
</div>
