---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import { measurePublicImage } from "~/lib/public-image";

interface Props {
  /**
   * An imported image, or a public `/media/` URL. CMS images live beside their
   * entry (or in the intentional shared library) and are served as uploaded,
   * so Astro cannot generate a responsive set for them.
   */
  src: ImageMetadata | string;
  alt: string;
  sizes: string;
  class?: string;
  loading?: "eager" | "lazy";
  widths?: number[];
}

const {
  src,
  alt,
  sizes,
  class: className,
  loading = "lazy",
  widths = [320, 640, 960, 1280],
} = Astro.props;
const responsiveWidths =
  typeof src === "string" ? [] : widths.filter((width) => width <= src.width);

/*
 * Public media is served byte for byte. The shared delivery resolver gives
 * measurement the same source file, so the browser can reserve its proportions
 * before the picture arrives.
 */
const size =
  typeof src === "string" ? await measurePublicImage(src) : undefined;
---

{
  typeof src === "string" ? (
    <img
      src={src}
      alt={alt}
      class={className}
      decoding="async"
      height={size?.height}
      loading={loading}
      width={size?.width}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      class={className}
      decoding="async"
      format="webp"
      loading={loading}
      quality={82}
      sizes={sizes}
      widths={responsiveWidths}
    />
  )
}
