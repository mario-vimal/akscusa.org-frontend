---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { Image } from "astro:assets";

import { measurePublicImage, type ImageSize } from "~/lib/public-image";

interface Props {
  /** An imported image, a public-file path, or a remote URL. */
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  /** Remote files are not fetched during the build; callers may supply their dimensions. */
  dimensions?: ImageSize;
  /** Sizes hint for imported images. */
  sizes?: string;
  widths?: number[];
  loading?: "eager" | "lazy";
  class?: string;
}

const {
  src,
  alt,
  caption,
  dimensions,
  sizes = "(min-width: 1024px) 380px, calc(100vw - 5rem)",
  widths = [320, 640, 960],
  loading = "lazy",
  class: className,
} = Astro.props;

const isImported = typeof src !== "string";
const size =
  typeof src === "string" && src.startsWith("/") && !src.startsWith("//")
    ? await measurePublicImage(src)
    : dimensions;

// The viewer shows one large file rather than the responsive set: it is opened
// deliberately, one poster at a time, so the extra bytes buy real detail.
const fullSrc = isImported
  ? (
      await getImage({
        src,
        format: "webp",
        quality: 90,
        width: Math.min(src.width, 1600),
      })
    ).src
  : src;

const responsiveWidths = isImported
  ? widths.filter((width) => width <= src.width)
  : widths;
---

<!--
  A poster on its own sheet. The artwork is a link to the full file, which the
  viewer script upgrades in place: with no JavaScript the poster still opens,
  and with it the poster opens over the page instead of navigating away and
  making the reader find their place again.
-->
<figure class:list={["card poster", className]}>
  <div class="poster__frame">
    {
      isImported ? (
        <Image
          class="poster__image"
          src={src}
          alt={alt}
          decoding="async"
          format="webp"
          loading={loading}
          quality={82}
          sizes={sizes}
          widths={responsiveWidths}
        />
      ) : (
        <img
          class="poster__image"
          src={src}
          alt={alt}
          loading={loading}
          decoding="async"
          width={size?.width}
          height={size?.height}
        />
      )
    }
    <a
      class="poster__open"
      href={fullSrc}
      data-poster-open
      data-poster-caption={caption}
    >
      <span class="sr-only">Enlarge poster</span>
      <span class="poster__zoom" aria-hidden="true">&#x2922;</span>
    </a>
  </div>
  {caption && <figcaption class="poster__caption">{caption}</figcaption>}
</figure>

<script>
  import { mountPosterViewer } from "~/components/ui/poster-viewer";

  mountPosterViewer();
</script>
