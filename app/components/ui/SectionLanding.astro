---
import type { ImageMetadata } from "astro";

import Container from "./Container.astro";
import PageMasthead from "./PageMasthead.astro";

interface ImageCredit {
  creator: string;
  sourceHref: string;
  license: string;
  licenseHref: string;
}

interface SectionItem {
  title: string;
  description: string;
  /** Set once the section has a page to send the reader to. */
  href?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  items: readonly SectionItem[];
  backgroundImage?: ImageMetadata;
  backgroundLabel?: string;
  backgroundCredit?: ImageCredit;
  backgroundPosition?: "center" | "portrait";
}

const {
  eyebrow,
  title,
  description,
  items,
  backgroundImage,
  backgroundLabel,
  backgroundCredit,
  backgroundPosition,
} = Astro.props;
---

<section>
  <PageMasthead
    eyebrow={eyebrow}
    title={title}
    description={description}
    backgroundImage={backgroundImage}
    backgroundLabel={backgroundLabel}
    backgroundCredit={backgroundCredit}
    backgroundPosition={backgroundPosition}
  />

  <Container class="pt-14 pb-20 sm:pt-16 sm:pb-28">
    <ul class="reveal-children grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <li class="card group p-7 sm:p-8">
            <h2 class="font-display text-[1.375rem] leading-[1.2] font-semibold tracking-[-0.015em] text-balance text-ambedkar-950">
              {item.href ? (
                <a class="after:absolute after:inset-0" href={item.href}>
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h2>
            <p class="mt-3 leading-7 text-ambedkar-900/70">
              {item.description}
            </p>
            {item.href && (
              <p
                class="mt-auto flex items-center gap-2 pt-6 text-sm font-bold tracking-[0.06em] text-ambedkar-700 uppercase group-hover:text-ambedkar-900"
                aria-hidden="true"
              >
                View
                <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">
                  &rarr;
                </span>
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </Container>
</section>
