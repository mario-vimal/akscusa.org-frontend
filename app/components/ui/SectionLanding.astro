---
import Container from "./Container.astro";

interface SectionItem {
  title: string;
  description: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  items: readonly SectionItem[];
}

const { eyebrow, title, description, items } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <div
    class="absolute inset-x-0 top-0 -z-10 h-[28rem] bg-[radial-gradient(circle_at_top_right,rgba(240,184,63,0.2),transparent_48%),radial-gradient(circle_at_top_left,rgba(31,98,170,0.18),transparent_42%)]"
    aria-hidden="true"
  >
  </div>

  <Container class="py-20 sm:py-28">
    <div class="max-w-3xl">
      <p
        class="text-sm font-bold tracking-[0.18em] text-ambedkar-700 uppercase"
      >
        {eyebrow}
      </p>
      <h1
        class="mt-4 text-5xl leading-none font-semibold tracking-[-0.05em] text-balance text-ambedkar-950 sm:text-7xl"
      >
        {title}
      </h1>
      <p
        class="mt-7 max-w-2xl text-lg leading-8 text-ambedkar-900/75 sm:text-xl"
      >
        {description}
      </p>
    </div>

    <div
      class="mt-16 grid gap-px overflow-hidden rounded-3xl border border-ambedkar-900/10 bg-ambedkar-900/10 md:grid-cols-3"
    >
      {
        items.map((item) => (
          <article class="bg-cream p-7 sm:p-8">
            <h2 class="text-xl font-semibold tracking-tight text-ambedkar-950">
              {item.title}
            </h2>
            <p class="mt-3 leading-7 text-ambedkar-900/70">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>
  </Container>
</section>
