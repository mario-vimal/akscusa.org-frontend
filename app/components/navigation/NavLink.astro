---
import { isCurrentPath } from "~/lib/navigation";
import type { NavigationItem } from "~/lib/navigation";

interface Props extends NavigationItem {
  currentPath: string;
  /** `mobile-child` is a link one level down inside the mobile sheet. */
  variant?: "default" | "action" | "mobile" | "mobile-child";
}

const { currentPath, href, label, variant = "default" } = Astro.props;
const isActive = isCurrentPath(currentPath, href);
const isMobile = variant === "mobile" || variant === "mobile-child";

const variantClasses = {
  default:
    "relative flex items-center rounded-xs py-4 font-display text-[0.875rem] font-medium whitespace-nowrap text-ambedkar-900/75 transition-colors hover:text-ambedkar-950 after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:bg-accent-600 after:transition-transform after:duration-300 after:ease-out-firm hover:after:scale-x-100",
  action: "btn btn-ink btn-sm w-full sm:w-auto",
  // `w-full` is what makes `justify-between` mean anything: without it the row
  // is only as wide as its label, the arrow sits against the text, and the
  // rule under each item stops at a different place down the sheet.
  mobile:
    "flex w-full items-center justify-between gap-3 border-b border-rule py-3.5 font-display text-lg font-medium text-ambedkar-900 transition-colors hover:text-ambedkar-950",
  // Indented and one step quieter, so the sheet shows the same subtree the
  // header dropdown does without asking for a second tap to reveal it. The
  // rule still runs the full width, so the indent is what marks the nesting
  // rather than a second, shorter set of lines.
  "mobile-child":
    "flex w-full items-center justify-between gap-3 border-b border-rule py-3 pl-4 font-display text-base font-medium text-ambedkar-900/70 transition-colors hover:text-ambedkar-950",
};
---

<a
  class:list={[
    variantClasses[variant],
    isActive &&
      variant === "default" &&
      "text-ambedkar-950 after:scale-x-100 after:bg-ambedkar-950",
    isActive && isMobile && "text-ambedkar-950",
  ]}
  href={href}
  aria-current={isActive ? "page" : undefined}
>
  {isMobile ? <span class="min-w-0 wrap-anywhere">{label}</span> : label}
  {
    isMobile && (
      <span
        class:list={[
          "shrink-0 text-accent-600 transition-opacity",
          isActive ? "opacity-100" : "opacity-0",
        ]}
        aria-hidden="true"
      >
        &rarr;
      </span>
    )
  }
</a>
