---
import type { NavigationItem } from "../../config/navigation";

interface Props extends NavigationItem {
  currentPath: string;
  variant?: "default" | "action" | "mobile";
}

const { currentPath, href, label, variant = "default" } = Astro.props;
const normalizedPath =
  currentPath === "/" ? currentPath : currentPath.replace(/\/+$/, "");
const isActive =
  href === "/"
    ? normalizedPath === href
    : normalizedPath === href || normalizedPath.startsWith(`${href}/`);

const variantClasses = {
  default:
    "link-underline relative rounded-sm px-1 py-2 text-[0.9375rem] font-semibold whitespace-nowrap text-ambedkar-900/80 transition-colors hover:text-ambedkar-950",
  action: "btn btn-ink w-full text-[0.9375rem] sm:w-auto",
  mobile:
    "flex items-center justify-between gap-3 rounded-xl px-4 py-3.5 text-lg font-semibold text-ambedkar-900 transition-colors hover:bg-ambedkar-50 hover:text-ambedkar-950",
};
---

<a
  class:list={[
    variantClasses[variant],
    isActive && variant === "default" && "text-ambedkar-950",
    isActive && variant === "mobile" && "bg-ambedkar-50 text-ambedkar-950",
  ]}
  href={href}
  aria-current={isActive ? "page" : undefined}
>
  {label}
  {
    variant === "mobile" && (
      <span
        class:list={[
          "text-accent-600 transition-opacity",
          isActive ? "opacity-100" : "opacity-0",
        ]}
        aria-hidden="true"
      >
        &rarr;
      </span>
    )
  }
</a>
