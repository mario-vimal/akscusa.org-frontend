---
import type { NavigationItem } from "~/config/navigation";

interface Props extends NavigationItem {
  currentPath: string;
  variant?: "default" | "action" | "mobile";
}

const { currentPath, href, label, variant = "default" } = Astro.props;
const normalizedPath =
  currentPath === "/" ? currentPath : currentPath.replace(/\/+$/, "");
const isActive =
  href === "/"
    ? normalizedPath === href
    : normalizedPath === href || normalizedPath.startsWith(`${href}/`);

const variantClasses = {
  default:
    "relative rounded-xs py-4 font-display text-[0.875rem] font-medium whitespace-nowrap text-ambedkar-900/75 transition-colors hover:text-ambedkar-950 after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:bg-accent-600 after:transition-transform after:duration-300 after:ease-[var(--ease-out-firm)] hover:after:scale-x-100",
  action: "btn btn-ink btn-sm w-full sm:w-auto",
  mobile:
    "flex items-center justify-between gap-3 border-b border-rule py-3.5 font-display text-lg font-medium text-ambedkar-900 transition-colors hover:text-ambedkar-950",
};
---

<a
  class:list={[
    variantClasses[variant],
    isActive &&
      variant === "default" &&
      "text-ambedkar-950 after:scale-x-100 after:bg-ambedkar-950",
    isActive && variant === "mobile" && "text-ambedkar-950",
  ]}
  href={href}
  aria-current={isActive ? "page" : undefined}
>
  {label}
  {
    variant === "mobile" && (
      <span
        class:list={[
          "text-accent-600 transition-opacity",
          isActive ? "opacity-100" : "opacity-0",
        ]}
        aria-hidden="true"
      >
        &rarr;
      </span>
    )
  }
</a>
