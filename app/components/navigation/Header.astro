---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

import logo from "../../assets/brand/aksc-logo.webp";
import { helplineNavigation } from "../../config/navigation";
import Container from "../ui/Container.astro";
import DesktopNav from "./DesktopNav.astro";
import MobileNav from "./MobileNav.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isHome = currentPath === "/";
const onHelpline = currentPath.replace(/\/+$/, "") === helplineNavigation.href;

// Read from the helpline page rather than restating the number here, so the
// strip and the helpline itself can never drift apart.
const helpline = await getEntry("pages", "anti-caste-helpline");
const phone =
  helpline?.data.pageType === "helpline" ? helpline.data.phone : undefined;
---

<!--
  The strip carries the helpline instead of the primary bar. Someone who needs
  it is not browsing section names, so it gets the question, the page, and the
  number, all above everything else.

  The strip scrolls away and only the bar below it sticks. Keeping the sticky
  element short leaves more of the page visible while reading, and keeps the
  offset that anchored headings scroll to small enough to stay honest.
-->{
  phone && (
    <div class="on-dark bg-ambedkar-1000 text-white">
      <Container class="flex flex-wrap items-center justify-between gap-x-5 gap-y-1 py-1">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.8125rem] leading-5">
          <span class="text-white/60">Facing casteism?</span>
          <a
            class="btn btn-primary btn-sm"
            href={`${helplineNavigation.href}/`}
            aria-current={onHelpline ? "page" : undefined}
          >
            {helplineNavigation.label}
          </a>
        </p>
        <a
          class="inline-flex min-h-11 items-center font-display text-[0.8125rem] font-semibold tracking-[0.02em] whitespace-nowrap text-accent-300"
          href={phone.href}
        >
          <span class="link-underline">Call 1-844-66-UNITE</span>
        </a>
      </Container>
    </div>
  )
}

<header
  class="sticky top-0 z-50 border-b border-rule bg-mist/88 backdrop-blur-xl"
>
  <Container class="flex items-center justify-between gap-4">
    <a
      class="inline-flex shrink-0 py-2"
      href="/"
      aria-label="AKSC USA home"
      aria-current={isHome ? "page" : undefined}
    >
      <Image
        src={logo}
        alt=""
        width={160}
        format="webp"
        quality={90}
        class="size-12 object-contain sm:size-13"
      />
    </a>
    <DesktopNav currentPath={currentPath} />
    <MobileNav currentPath={currentPath} />
  </Container>
</header>
