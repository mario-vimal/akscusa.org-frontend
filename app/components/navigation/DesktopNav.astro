---
import { donateNavigation, primaryNavigation } from "../../config/navigation";
import NavLink from "./NavLink.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<!--
  The bar carries nine sections plus the donate action, which only has room to
  breathe from 1280px up. Below that the sheet in MobileNav takes over, so the
  links are never squeezed to the point of being hard to hit or read.
-->
<nav class="hidden items-stretch gap-7 xl:flex" aria-label="Primary navigation">
  <ul class="flex items-stretch gap-6">
    {
      primaryNavigation.map((item) => (
        <li class="flex items-stretch">
          <NavLink {...item} currentPath={currentPath} />
        </li>
      ))
    }
  </ul>
  <div class="flex items-center">
    <NavLink {...donateNavigation} currentPath={currentPath} variant="action" />
  </div>
</nav>
