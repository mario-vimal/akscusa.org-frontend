---
import { donateNavigation, primaryNavigation } from "../../config/navigation";
import NavLink from "./NavLink.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<!--
  The bar carries eight sections plus the donate action, which only has room to
  breathe from 1280px up. Below that the sheet in MobileNav takes over, so the
  links are never squeezed to the point of being hard to hit or read.
-->
<nav class="hidden items-center gap-6 xl:flex" aria-label="Primary navigation">
  <ul class="flex items-center gap-5">
    {
      primaryNavigation.map((item) => (
        <li>
          <NavLink {...item} currentPath={currentPath} />
        </li>
      ))
    }
  </ul>
  <NavLink {...donateNavigation} currentPath={currentPath} variant="action" />
</nav>
