---
import { joinNavigation, primaryNavigation } from "~/config/navigation";
import { isNavigationGroup } from "~/lib/navigation";
import NavGroup from "./NavGroup.astro";
import NavLink from "./NavLink.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<!--
  Six items plus the join action, where there used to be nine. Gathering the
  four sections of AKSC's work under Actions is what brought the bar back to a
  width that fits from 1024px up, rather than only on a desktop at 1280px.

  The bar is stretched to the header's full height rather than centred in it,
  so the rule under an item and the panel under the group both meet the
  header's bottom edge. Centred, the panel opened seven pixels up inside the
  bar and cut across the item that had been clicked.

  The panel hangs off its own list item, so `relative` sits here and not around
  the whole bar; anchored to the bar it would open flush against the left edge
  of the page.
-->
<nav
  class="hidden min-w-0 items-stretch gap-7 self-stretch lg:flex"
  aria-label="Primary navigation"
>
  <ul class="flex min-w-0 flex-wrap items-stretch justify-end gap-x-6">
    {
      primaryNavigation.map((item, index) => (
        <li class="relative flex items-stretch has-[[open]]:z-10">
          {isNavigationGroup(item) ? (
            <NavGroup
              group={item}
              currentPath={currentPath}
              align={index === primaryNavigation.length - 1 ? "end" : "start"}
            />
          ) : (
            <NavLink {...item} currentPath={currentPath} />
          )}
        </li>
      ))
    }
  </ul>
  <div class="flex shrink-0 items-center">
    <NavLink {...joinNavigation} currentPath={currentPath} variant="action" />
  </div>
</nav>
