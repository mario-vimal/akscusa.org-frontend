---
import { Image } from "astro:assets";

import logo from "../../assets/brand/aksc-logo.webp";
import {
  donateNavigation,
  helplineNavigation,
  primaryNavigation,
  secondaryNavigation,
} from "../../config/navigation";
import { socialLinks } from "../../config/social";
import Container from "../ui/Container.astro";

// The helpline leads, as it does in the strip above the header. It is no
// longer in the primary bar, so the footer is the other place it has to appear.
const exploreLinks = [
  helplineNavigation,
  ...primaryNavigation,
  donateNavigation,
  ...secondaryNavigation,
];
---

<footer
  class="on-dark relative isolate mt-px overflow-hidden bg-ambedkar-1000 text-white"
>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(90%_120%_at_0%_0%,var(--color-ambedkar-900),transparent_55%),radial-gradient(80%_110%_at_100%_10%,var(--color-accent-950),transparent_55%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 pattern-grid mask-[radial-gradient(70%_80%_at_50%_0%,black,transparent)] text-white/6"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 -z-10 grain opacity-[0.05]" aria-hidden="true">
  </div>

  <Container class="py-14 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_1.5fr_1fr]">
      <div class="max-w-sm">
        <a
          class="inline-flex rounded-2xl bg-white p-2.5 shadow-soft"
          href="/"
          aria-label="AKSC USA home"
        >
          <Image
            src={logo}
            alt=""
            width={160}
            format="webp"
            quality={90}
            class="size-20 object-contain"
          />
        </a>
        <p
          class="mt-6 font-display text-2xl leading-snug font-semibold text-balance"
        >
          Forging an egalitarian society.
        </p>
        <p class="mt-3 leading-7 text-white/65">
          AKSC USA educates, agitates, and organizes to end caste discrimination
          wherever it travels.
        </p>
      </div>

      <nav aria-label="Footer navigation">
        <h2 class="eyebrow eyebrow-light">Explore</h2>
        <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {
            exploreLinks.map((item) => (
              <li>
                <a
                  class="link-underline inline-block text-white/75 transition-colors hover:text-white"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Social media">
        <h2 class="eyebrow eyebrow-light">Follow</h2>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            socialLinks.map((item) => (
              <li>
                <a
                  class="inline-flex rounded-full border border-white/20 bg-white/5 px-4 py-2 text-sm font-semibold text-white/85 transition-colors hover:border-white/50 hover:bg-white/12 hover:text-white"
                  href={item.href}
                  rel="me"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>

  <div class="border-t border-white/10">
    <Container
      class="flex flex-col gap-2 py-6 text-sm text-white/55 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {new Date().getFullYear()} AKSC USA</p>
      <p class="font-semibold tracking-[0.08em] text-accent-300 uppercase">
        Dignity. Equality. Liberation for all.
      </p>
    </Container>
  </div>
</footer>
