---
import { Image } from "astro:assets";

import logo from "../../assets/brand/aksc-logo.webp";
import { donateNavigation, primaryNavigation } from "../../config/navigation";
import { socialLinks } from "../../config/social";
import Container from "../ui/Container.astro";
---

<footer class="bg-ambedkar-950 text-white">
  <Container
    class="grid gap-12 py-14 md:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr]"
  >
    <div class="max-w-sm">
      <a
        class="inline-flex rounded-2xl bg-white p-2"
        href="/"
        aria-label="AKSC USA home"
      >
        <Image
          src={logo}
          alt=""
          width={112}
          format="webp"
          quality={90}
          class="size-20 object-contain"
        />
      </a>
      <h2 class="mt-5 text-xl font-bold">Ambedkar King Study Circle</h2>
      <p class="mt-2 leading-7 text-white/65">
        Forging an egalitarian society.
      </p>
    </div>

    <nav aria-label="Footer navigation">
      <h2 class="text-sm font-bold tracking-[0.16em] text-accent-300 uppercase">
        Explore
      </h2>
      <ul class="mt-5 space-y-3">
        {
          primaryNavigation.map((item) => (
            <li>
              <a
                class="text-white/75 transition hover:text-white"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="text-white/75 transition hover:text-white"
            href={donateNavigation.href}
          >
            {donateNavigation.label}
          </a>
        </li>
      </ul>
    </nav>

    <nav aria-label="Social media">
      <h2 class="text-sm font-bold tracking-[0.16em] text-accent-300 uppercase">
        Follow
      </h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          socialLinks.map((item) => (
            <li>
              <a
                class="inline-flex rounded-full border border-white/20 px-4 py-2 text-sm font-semibold text-white/80 transition hover:border-white/50 hover:bg-white/10 hover:text-white"
                href={item.href}
                rel="me"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>

  <div class="border-t border-white/10">
    <Container
      class="flex flex-col gap-2 py-6 text-sm text-white/55 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {new Date().getFullYear()} AKSC USA</p>
      <p>Dignity. Equality. Liberation for all.</p>
    </Container>
  </div>
</footer>
