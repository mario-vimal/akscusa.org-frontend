---
import { Image } from "astro:assets";

import logo from "~/assets/brand/aksc-logo.webp";
import {
  helplineNavigation,
  joinNavigation,
  primaryNavigation,
  secondaryNavigation,
} from "~/config/navigation";
import { socialLinks } from "~/config/social";
import { flattenNavigation } from "~/lib/navigation";
import Container from "~/components/ui/Container.astro";

// The helpline leads, as it does in the strip above the header. It is no
// longer in the primary bar, so the footer is the other place it has to appear.
//
// The tree is flattened rather than reproduced. The header can afford to hide
// four sections behind Actions because it has a control to open them; the
// footer is where a reader goes when they already know what they want, so
// every destination is one link.
const exploreLinks = [
  helplineNavigation,
  ...flattenNavigation(primaryNavigation),
  joinNavigation,
  ...secondaryNavigation,
];
---

<footer
  class="on-dark relative isolate mt-px overflow-hidden bg-ambedkar-1000 text-white"
>
  <div class="absolute inset-0 -z-10 grain opacity-[0.035]" aria-hidden="true">
  </div>

  <Container class="pt-16 pb-14 sm:pt-20 sm:pb-16">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1.5fr_0.9fr] lg:gap-16">
      <div class="max-w-sm">
        <a
          class="inline-flex bg-white p-2.5"
          href="/"
          aria-label="AKSC USA home"
        >
          <Image
            src={logo}
            alt=""
            width={160}
            format="webp"
            quality={90}
            class="size-18 object-contain"
          />
        </a>
        <p
          class="mt-8 font-display text-3xl leading-[1.05] font-bold tracking-display text-balance"
        >
          Forging an egalitarian society.
        </p>
        <p class="mt-4 max-w-xs leading-7 text-white/60">
          AKSC USA educates, agitates, and organizes to end caste discrimination
          wherever it travels.
        </p>
      </div>

      <nav aria-label="Footer navigation">
        <h2 class="eyebrow eyebrow-light">Explore</h2>
        <ul class="mt-6 grid gap-x-10 sm:grid-cols-2">
          {
            exploreLinks.map((item) => (
              <li class="border-b border-white/10">
                <a
                  class="block py-2.5 font-display text-[0.9375rem] font-medium text-white/70 transition-colors hover:text-white"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Social media">
        <h2 class="eyebrow eyebrow-light">Follow</h2>
        <ul class="mt-4 flex flex-wrap gap-x-6">
          {
            socialLinks.map((item) => (
              <li>
                <a
                  class="inline-flex min-h-11 items-center font-display text-[0.9375rem] font-medium text-white/70 transition-colors hover:text-white"
                  href={item.href}
                  rel="me"
                >
                  <span class="link-underline">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>

  <div class="border-t border-white/12">
    <Container
      class="flex flex-col gap-2 py-6 text-[0.8125rem] text-white/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {new Date().getFullYear()} AKSC USA</p>
      <p
        class="font-display font-semibold tracking-label text-accent-300/90 uppercase"
      >
        Dignity. Equality. Liberation for all.
      </p>
    </Container>
  </div>
</footer>
