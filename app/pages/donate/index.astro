---
import { render } from "astro:content";

import DonateOverview from "~/features/donate/components/DonateOverview.astro";
import { loadPage } from "~/features/page-copy/queries/entries";
import SiteLayout from "~/layouts/SiteLayout.astro";

const page = await loadPage("donate");

if (page.data.pageType !== "donate") {
  throw new Error("Donate content is missing or invalid.");
}

const { Content } = await render(page);
---

<SiteLayout title={page.data.title} description={page.data.description}>
  <DonateOverview {...page.data}>
    <Content />
  </DonateOverview>
</SiteLayout>
