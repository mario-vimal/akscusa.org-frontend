---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import ConferenceSpeakers from "~/features/conferences/components/ConferenceSpeakers.astro";
import { loadConferenceSpeakers } from "~/features/conferences/queries/speakers";
import EntryLayout from "~/features/editorial/components/EntryLayout.astro";
import { loadEditorialEntries } from "~/features/editorial/queries/entries";
import {
  conferenceBadge,
  conferenceDetails,
} from "~/features/editorial/presenters";
import SiteLayout from "~/layouts/SiteLayout.astro";

export const getStaticPaths = (async () => {
  const conferences = await loadEditorialEntries("conferences");
  return conferences.map((conference) => ({
    params: { slug: conference.id },
    props: { conference },
  }));
}) satisfies GetStaticPaths;

const { conference } = Astro.props;
const { Content } = await render(conference);
const speakers = await loadConferenceSpeakers(conference);
---

<SiteLayout title={conference.data.title} description={conference.data.summary}>
  <EntryLayout
    section="conferences"
    title={conference.data.title}
    summary={conference.data.summary}
    badge={conferenceBadge(conference)}
    details={conferenceDetails(conference)}
    links={{ heading: "Resources", items: conference.data.resources }}
    topics={conference.data.topics}
    heroImage={conference.data.heroImage}
    sourceUrl={conference.data.sourceUrl}
  >
    <ConferenceSpeakers
      slot="before-body"
      speakers={speakers.map((speaker) => speaker.data)}
    />
    <Content />
  </EntryLayout>
</SiteLayout>
