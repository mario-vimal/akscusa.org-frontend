---
import { getEntry, render } from "astro:content";

import OrganizationDocumentLayout from "~/features/organization/components/OrganizationDocumentLayout.astro";
import SiteLayout from "~/layouts/SiteLayout.astro";

const page = await getEntry("pages", "membership");

if (!page || page.data.pageType !== "membership") {
  throw new Error("Membership content is missing or invalid.");
}

const { Content } = await render(page);
---

<SiteLayout title={page.data.title} description={page.data.description}>
  <OrganizationDocumentLayout
    {...page.data}
    action={{
      label: "Open membership application",
      href: page.data.joinUrl,
      external: true,
    }}
  >
    <Content />
  </OrganizationDocumentLayout>
</SiteLayout>
