---
import { render } from "astro:content";

import OrganizationDocumentLayout from "~/features/organization/components/OrganizationDocumentLayout.astro";
import { loadPage } from "~/features/page-copy/queries/entries";
import SiteLayout from "~/layouts/SiteLayout.astro";

const page = await loadPage("constitution");

if (page.data.pageType !== "constitution") {
  throw new Error("Constitution content is missing or invalid.");
}

const { Content } = await render(page);
---

<SiteLayout title={page.data.title} description={page.data.description}>
  <OrganizationDocumentLayout
    {...page.data}
    action={{
      label: "Join AKSC",
      href: "/join/",
    }}
  >
    <Content />
  </OrganizationDocumentLayout>
</SiteLayout>
