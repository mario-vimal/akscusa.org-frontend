---
import { render } from "astro:content";

import GeneralBodyOverview from "~/features/organization/components/GeneralBodyOverview.astro";
import { loadPage } from "~/features/page-copy/queries/entries";
import SiteLayout from "~/layouts/SiteLayout.astro";

const page = await loadPage("general-body");

if (page.data.pageType !== "general-body") {
  throw new Error("General Body content is missing or invalid.");
}

const { Content } = await render(page);
---

<SiteLayout title={page.data.title} description={page.data.description}>
  <GeneralBodyOverview {...page.data}>
    <Content />
  </GeneralBodyOverview>
</SiteLayout>
