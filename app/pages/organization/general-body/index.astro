---
import { getEntry, render } from "astro:content";

import GeneralBodyOverview from "../../../features/organization/components/GeneralBodyOverview.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";

const page = await getEntry("pages", "general-body");

if (!page || page.data.pageType !== "general-body") {
  throw new Error("General Body content is missing or invalid.");
}

const { Content } = await render(page);
---

<SiteLayout title={page.data.title} description={page.data.description}>
  <GeneralBodyOverview {...page.data}>
    <Content />
  </GeneralBodyOverview>
</SiteLayout>
