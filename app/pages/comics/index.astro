---
import { render } from "astro:content";

import ComicsIndex from "~/features/comics/components/ComicsIndex.astro";
import { loadComicsIndex } from "~/features/comics/queries/comics";
import { loadPage } from "~/features/page-copy/queries/entries";
import SiteLayout from "~/layouts/SiteLayout.astro";

const page = await loadPage("comics");

if (page.data.pageType !== "comics") {
  throw new Error("Comics page content is missing or invalid.");
}

const { comics, totalPanels } = await loadComicsIndex();
const { Content } = await render(page);
---

<SiteLayout title={page.data.title} description={page.data.description}>
  <ComicsIndex
    eyebrow={page.data.eyebrow}
    title={page.data.headline}
    intro={page.data.intro}
    comics={comics}
    totalPanels={totalPanels}
    contribute={page.data.contribute}
  >
    <Content />
  </ComicsIndex>
</SiteLayout>
