---
import type { GetStaticPaths } from "astro";

import EditorialIndex from "~/features/editorial/components/EditorialIndex.astro";
import EntryCard from "~/features/editorial/components/EntryCard.astro";
import EntryLead from "~/features/editorial/components/EntryLead.astro";
import { editorialSections, entryHref } from "~/features/editorial/sections";
import {
  groupByTerm,
  splitLeadEntry,
} from "~/features/editorial/queries/entries";
import {
  interventionBadge,
  interventionEyebrow,
  interventionFilters,
  interventionMeta,
} from "~/features/editorial/presenters";
import { interventionKinds } from "~/features/editorial/taxonomy";
import SiteLayout from "~/layouts/SiteLayout.astro";

export const getStaticPaths = (async () => {
  const groups = await groupByTerm(
    "interventions",
    interventionKinds,
    (intervention) => intervention.data.kind,
  );

  return groups.map((group) => ({
    params: { kind: group.term.id },
    props: group,
  }));
}) satisfies GetStaticPaths;

const {
  term: kind,
  entries: interventions,
  all: allInterventions,
} = Astro.props;
const section = editorialSections.interventions;
const title = `${kind.label} — ${section.title}`;
const { lead, rest } = splitLeadEntry(interventions);
---

<SiteLayout title={title} description={kind.description}>
  <EditorialIndex
    eyebrow={section.eyebrow}
    title={kind.label}
    description={kind.description}
    count={`${interventions.length} ${interventions.length === 1 ? "intervention" : "interventions"}`}
    itemCount={rest.length}
    filters={interventionFilters(allInterventions, kind.id)}
    filtersLabel="Filter interventions by kind"
    listLabel="Earlier interventions"
  >
    {
      lead && (
        <EntryLead
          slot="lead"
          label="Latest intervention"
          href={entryHref("interventions", lead.id)}
          title={lead.data.title}
          summary={lead.data.summary}
          eyebrow={interventionEyebrow(lead)}
          badge={interventionBadge(lead)}
          meta={interventionMeta(lead)}
          topics={lead.data.topics}
        />
      )
    }
    {
      rest.map((intervention) => (
        <li>
          <EntryCard
            href={entryHref("interventions", intervention.id)}
            title={intervention.data.title}
            summary={intervention.data.summary}
            eyebrow={interventionEyebrow(intervention)}
            badge={interventionBadge(intervention)}
            meta={interventionMeta(intervention)}
            topics={intervention.data.topics}
          />
        </li>
      ))
    }
  </EditorialIndex>
</SiteLayout>
