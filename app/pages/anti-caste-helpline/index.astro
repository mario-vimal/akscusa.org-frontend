---
import { render } from "astro:content";

import AntiCasteHelpline from "~/features/anti-caste-helpline/components/AntiCasteHelpline.astro";
import { loadPage } from "~/features/page-copy/queries/entries";
import SiteLayout from "~/layouts/SiteLayout.astro";

const helpline = await loadPage("anti-caste-helpline");

if (helpline.data.pageType !== "helpline") {
  throw new Error("Anti-Caste Helpline content is missing or invalid.");
}

const { Content } = await render(helpline);
---

<SiteLayout title={helpline.data.title} description={helpline.data.description}>
  <AntiCasteHelpline {...helpline.data}>
    <Content />
  </AntiCasteHelpline>
</SiteLayout>
