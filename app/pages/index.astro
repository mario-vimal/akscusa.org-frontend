---
import { loadPage } from "~/features/page-copy/queries/entries";

import HomeCallToAction from "~/features/home/components/HomeCallToAction.astro";
import HomeComics from "~/features/home/components/HomeComics.astro";
import HomeHero from "~/features/home/components/HomeHero.astro";
import HomeLatest from "~/features/home/components/HomeLatest.astro";
import HomeQuotes from "~/features/home/components/HomeQuotes.astro";
import HomeReading from "~/features/home/components/HomeReading.astro";
import HomeSpotlight from "~/features/home/components/HomeSpotlight.astro";
import { loadHomeFeatures } from "~/features/home/queries/featured";
import SiteLayout from "~/layouts/SiteLayout.astro";

const home = await loadPage("home");

if (home.data.pageType !== "home") {
  throw new Error("Home content is missing or invalid.");
}

// The hero, the quotes, and the closing call are the homepage's own copy and
// live in app/content. Everything between them is drawn from the collections
// the rest of the site already has — mostly the newest entry of each kind,
// plus the shelf of books already read — and is chosen in
// features/home/queries.
//
// The shelf comes first because a study circle is what it has studied: the
// book on now, then the ones behind it. Below that the page runs from what is
// next, through the drawn work, to the writing and the recent record.
//
// The sections do not share a height. Every one of them used to be set to the
// same py-20 sm:py-28, so the page came down in six equal steps whatever was
// in them; the spotlight and the quotes are now held tighter and the three
// columns of latest work given more room, so the rhythm follows the content
// rather than the template.
const { spotlight, writing, book, previous, shelf, comics, recent } =
  await loadHomeFeatures();
---

<SiteLayout description={home.data.description}>
  <HomeHero hero={home.data.hero} />
  {
    (book || shelf.books.length > 0) && (
      <HomeReading book={book} previous={previous} shelf={shelf} />
    )
  }
  {spotlight && <HomeSpotlight spotlight={spotlight} />}
  {comics.length > 0 && <HomeComics comics={comics} />}
  <HomeLatest lead={writing.lead} more={writing.more} recent={recent} />
  <HomeQuotes quotes={home.data.quotes} />
  <HomeCallToAction closing={home.data.closing} />
</SiteLayout>
