---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import { loadReadingBooks } from "~/features/books/queries/books";
import {
  bookReadingBadge,
  bookReadingDetails,
} from "~/features/book-readings/presenters";
import EntryLayout from "~/features/editorial/components/EntryLayout.astro";
import { loadEditorialEntries } from "~/features/editorial/queries/entries";
import SiteLayout from "~/layouts/SiteLayout.astro";

export const getStaticPaths = (async () => {
  const [readings, books] = await Promise.all([
    loadEditorialEntries("bookReadings"),
    loadReadingBooks(),
  ]);

  return readings.map((reading) => ({
    params: { slug: reading.id },
    props: { reading, book: books.get(reading.id) },
  }));
}) satisfies GetStaticPaths;

const { reading, book } = Astro.props;
const { Content } = await render(reading);
---

<SiteLayout title={reading.data.title} description={reading.data.summary}>
  <EntryLayout
    section="bookReadings"
    title={reading.data.title}
    summary={reading.data.summary}
    badge={bookReadingBadge(reading)}
    details={bookReadingDetails(reading, book)}
    links={{ heading: "What we read", items: reading.data.resources }}
    topics={reading.data.topics}
    heroImage={reading.data.heroImage}
    posters={reading.data.posters}
    sourceUrl={reading.data.sourceUrl}
  >
    <Content />
  </EntryLayout>
</SiteLayout>
