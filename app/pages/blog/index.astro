---
import ambedkarPortrait from "~/assets/shared/leaders/ambedkar-portrait-public-domain.jpg";
import EditorialIndex from "~/features/editorial/components/EditorialIndex.astro";
import EntryCard from "~/features/editorial/components/EntryCard.astro";
import EntryLead from "~/features/editorial/components/EntryLead.astro";
import { editorialSections, entryHref } from "~/features/editorial/sections";
import {
  loadEditorialEntries,
  splitLeadEntry,
} from "~/features/editorial/queries/entries";
import { formatDate } from "~/lib/dates";
import { articleFilters, articleMeta } from "~/features/editorial/presenters";
import {
  loadTermLabels,
  loadTerms,
} from "~/features/editorial/queries/taxonomy";
import SiteLayout from "~/layouts/SiteLayout.astro";

const section = editorialSections.articles;
const [articles, categories, articleCategoryLabel] = await Promise.all([
  loadEditorialEntries("articles"),
  loadTerms("categories"),
  loadTermLabels("categories"),
]);
const { lead, rest } = splitLeadEntry(articles);
---

<SiteLayout title={section.title} description={section.description}>
  <EditorialIndex
    eyebrow={section.eyebrow}
    title={section.title}
    description={section.description}
    countNoun={{ one: "article", other: "articles" }}
    filters={articleFilters(articles, categories)}
    filtersLabel="Filter articles by category"
    filterKey="category"
    leadTerm={lead?.data.category}
    empty={section.empty}
    isEmpty={articles.length === 0}
    itemCount={rest.length}
    listLabel="Earlier articles"
    backgroundImage={ambedkarPortrait}
    backgroundLabel="B. R. Ambedkar"
  >
    {
      lead && (
        <EntryLead
          slot="lead"
          label="Latest article"
          href={entryHref("articles", lead.id)}
          title={lead.data.title}
          summary={lead.data.summary}
          eyebrow={formatDate(lead.data.date)}
          badge={{ label: articleCategoryLabel(lead.data.category) }}
          meta={articleMeta(lead)}
          topics={lead.data.topics}
        />
      )
    }
    {
      rest.map((article) => (
        <li data-filter-term={article.data.category}>
          <EntryCard
            href={entryHref("articles", article.id)}
            title={article.data.title}
            summary={article.data.summary}
            eyebrow={formatDate(article.data.date)}
            badge={{ label: articleCategoryLabel(article.data.category) }}
            meta={articleMeta(article)}
            topics={article.data.topics}
          />
        </li>
      ))
    }
  </EditorialIndex>
</SiteLayout>
