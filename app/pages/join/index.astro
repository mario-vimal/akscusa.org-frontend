---
import { render } from "astro:content";

import JoinOverview from "~/features/join/components/JoinOverview.astro";
import { loadPage } from "~/features/page-copy/queries/entries";
import SiteLayout from "~/layouts/SiteLayout.astro";

const page = await loadPage("join");

if (page.data.pageType !== "join") {
  throw new Error("Join content is missing or invalid.");
}

const { Content } = await render(page);
---

<SiteLayout title={page.data.title} description={page.data.description}>
  <JoinOverview {...page.data}>
    <Content />
  </JoinOverview>
</SiteLayout>
