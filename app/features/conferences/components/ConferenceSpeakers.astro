---
interface Speaker {
  name: string;
  role: string;
  bio: string;
  portrait?: {
    src: string;
    alt: string;
  };
  sourceUrl?: string;
}

interface Props {
  speakers: readonly Speaker[];
}

const { speakers } = Astro.props;

const initials = (name: string) =>
  name
    .replace(/^Dr\.\s+/, "")
    .split(/\s+/)
    .map((part) => part[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("");

const paragraphs = (bio: string) => bio.split(/\n\s*\n/).filter(Boolean);
---

{
  speakers.length > 0 && (
    <section class="mt-12 max-w-5xl" aria-labelledby="speakers-heading">
      <p class="eyebrow">People and movements</p>
      <h2
        id="speakers-heading"
        class="mt-4 font-display text-3xl leading-[1.05] font-bold tracking-display text-ambedkar-950 sm:text-4xl"
      >
        Conference speakers
      </h2>
      <p class="mt-4 max-w-2xl leading-7 text-ambedkar-900/75">
        Scholars and organisers working across anti-caste, feminist, housing,
        human rights, and solidarity movements.
      </p>

      <div class="mt-8 grid items-start gap-5 md:grid-cols-2">
        {speakers.map((speaker) => (
          <details class="card group h-auto">
            <summary class="cursor-pointer list-none p-6 marker:content-none sm:p-7">
              <div class="flex items-start gap-4">
                {speaker.portrait ? (
                  <img
                    class="size-14 shrink-0 rounded-2xl object-cover"
                    src={speaker.portrait.src}
                    alt={speaker.portrait.alt}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span
                    class="on-dark flex size-14 shrink-0 items-center justify-center rounded-2xl bg-ambedkar-950 font-display text-xl leading-[1.15] font-semibold tracking-title text-accent-300"
                    aria-hidden="true"
                  >
                    {initials(speaker.name)}
                  </span>
                )}
                <span class="min-w-0">
                  <span class="block font-display text-xl leading-[1.16] font-semibold tracking-title text-ambedkar-950 sm:text-2xl">
                    {speaker.name}
                  </span>
                  <span class="mt-2 block text-sm leading-6 text-ambedkar-900/70">
                    {speaker.role}
                  </span>
                </span>
              </div>
              <span class="mt-5 flex items-center justify-between border-t border-rule pt-4 font-display text-xs font-semibold tracking-[0.12em] text-ambedkar-700 uppercase">
                <span class="group-open:hidden">Read biography</span>
                <span class="hidden group-open:inline">Close biography</span>
                <span
                  class="text-xl leading-none transition-transform duration-200 group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </span>
            </summary>

            <div class="border-t border-rule px-6 pt-5 pb-7 sm:px-7">
              {paragraphs(speaker.bio).map((paragraph) => (
                <p class="mt-4 leading-7 text-ambedkar-900/78 first:mt-0">
                  {paragraph}
                </p>
              ))}
              {speaker.sourceUrl && (
                <p class="mt-5 text-sm">
                  <a
                    class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                    href={speaker.sourceUrl}
                  >
                    Original speaker biography
                  </a>
                </p>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}
