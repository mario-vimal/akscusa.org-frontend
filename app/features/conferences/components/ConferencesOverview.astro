---
import EditorialIndex from "../../editorial/components/EditorialIndex.astro";
import EntryCard from "../../editorial/components/EntryCard.astro";
import conferenceAudience from "../assets/conference-audience-6vajp0pscx0.jpg";
import {
  editorialSections,
  entryHref,
  formatDateRange,
  loadEditorialEntries,
} from "../../editorial/entries";
import { conferenceBadge, conferenceMeta } from "../../editorial/presenters";

const section = editorialSections.conferences;
const conferences = await loadEditorialEntries("conferences");
---

<EditorialIndex
  eyebrow={section.eyebrow}
  title={section.title}
  description={section.description}
  count={`${conferences.length} ${conferences.length === 1 ? "conference" : "conferences"}`}
  empty={section.empty}
  isEmpty={conferences.length === 0}
  backgroundImage={conferenceAudience}
>
  {
    conferences.map((conference) => (
      <li>
        <EntryCard
          href={entryHref("conferences", conference.id)}
          title={conference.data.title}
          summary={conference.data.summary}
          eyebrow={formatDateRange(
            conference.data.date,
            conference.data.endDate,
          )}
          badge={conferenceBadge(conference)}
          meta={conferenceMeta(conference)}
          topics={conference.data.topics}
        />
      </li>
    ))
  }
</EditorialIndex>
