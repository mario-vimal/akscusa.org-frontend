---
import Container from "~/components/ui/Container.astro";
import type { HomePageData } from "~/features/home/content";

interface Props {
  quotes: HomePageData["quotes"];
}

const { quotes } = Astro.props;
---

<section
  class="on-dark relative isolate overflow-hidden bg-ambedkar-950 text-white"
  aria-labelledby="voices-title"
  data-carousel
  data-carousel-noun="quotation"
  data-carousel-rotation="quotations"
>
  <div
    class="absolute inset-0 -z-10 bg-linear-to-b from-ambedkar-950 to-ambedkar-1000"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 -z-10 grain opacity-[0.035]" aria-hidden="true">
  </div>

  <Container class="py-16 sm:py-24">
    <div class="reveal section-head border-white/20">
      <p class="eyebrow eyebrow-light">Revolutionary voices</p>

      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2
          id="voices-title"
          class="max-w-2xl font-display text-display-md leading-[0.98] font-bold tracking-display text-balance"
        >
          Words for struggle, dignity, and liberation.
        </h2>

        <!--
          Hidden until the script is ready. Without JavaScript the quotations
          remain a touch-scrollable, scroll-snapping list rather than leaving a
          row of controls that does nothing.
        -->
        <div class="flex items-center" data-carousel-controls hidden>
          <button
            class="inline-flex size-10 items-center justify-center border border-white/25 text-white transition-colors hover:border-white/70 hover:bg-white/10"
            type="button"
            aria-label="Previous quotation"
            data-carousel-previous
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>

          <button
            class="-ml-px inline-flex size-10 items-center justify-center border border-white/25 text-white transition-colors hover:border-white/70 hover:bg-white/10"
            type="button"
            aria-label="Pause quotations"
            data-carousel-toggle
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              data-carousel-pause-icon
            >
              <path d="M6.5 5h3v14h-3zM14.5 5h3v14h-3z"></path>
            </svg>
            <svg
              class="hidden size-4"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              data-carousel-play-icon
            >
              <path d="m8 5 11 7-11 7z"></path>
            </svg>
          </button>

          <button
            class="-ml-px inline-flex size-10 items-center justify-center border border-white/25 text-white transition-colors hover:border-white/70 hover:bg-white/10"
            type="button"
            aria-label="Next quotation"
            data-carousel-next
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!--
      The quotation is set straight onto the ink rather than lifted onto a white
      panel. These are the words the organisation was founded on; a card would
      make them one more tile on a page of tiles.
    -->
    <div
      class="carousel-viewport mt-14 sm:mt-16"
      role="region"
      aria-roledescription="carousel"
      aria-label="Quotations by revolutionary leaders"
      aria-live="off"
      tabindex="0"
      data-carousel-viewport
    >
      <ul class="flex">
        {
          quotes.map((quote, index) => (
            <li
              class="w-full shrink-0 snap-start pr-6 sm:pr-10"
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${quotes.length}`}
              data-carousel-slide
            >
              {/*
                  Every slide is as tall as the longest quotation, because they
                  share one flex row. Aligned to the bottom of that row rather
                  than the top, a short quotation reads as air above the words
                  instead of a hole beneath them, and the citation lands in the
                  same place on every slide, so paging through them does not
                  make the band jump.
                */}
              <figure class="flex h-full flex-col justify-end">
                <blockquote class="max-w-5xl font-serif text-[1.75rem] leading-[1.18] font-normal tracking-[-0.02em] text-balance text-white sm:text-[2.5rem] lg:text-[3.25rem]">
                  {quote.text}
                </blockquote>

                <figcaption class="mt-8 border-t border-white/20 pt-4 sm:mt-10">
                  <p
                    class="font-display text-xs font-semibold tracking-[0.16em] text-accent-300 uppercase"
                    data-carousel-label
                  >
                    {quote.author}
                  </p>
                  <cite class="mt-1.5 block text-sm text-white/55 not-italic">
                    {quote.source}
                  </cite>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>

    <p
      class="sr-only"
      aria-live="polite"
      aria-atomic="true"
      data-carousel-status
    >
    </p>
  </Container>
</section>

<script>
  import { mountCarousels } from "~/features/home/carousel";

  mountCarousels();
</script>
