---
import Container from "../../../components/ui/Container.astro";
import type { HomePageData } from "../content";

interface Props {
  quotes: HomePageData["quotes"];
}

const { quotes } = Astro.props;
---

<section class="bg-mist" aria-labelledby="voices-title">
  <Container class="py-20 sm:py-28">
    <p class="text-sm font-bold tracking-[0.18em] text-ambedkar-700 uppercase">
      Voices for justice
    </p>
    <h2
      id="voices-title"
      class="mt-3 max-w-2xl text-4xl font-bold tracking-[-0.04em] text-balance text-ambedkar-950 sm:text-5xl"
    >
      Liberty must be lived by everyone.
    </h2>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {
        quotes.map((quote) => (
          <figure class="flex flex-col justify-between rounded-3xl border border-ambedkar-900/10 bg-white p-7 shadow-soft sm:p-10">
            <blockquote class="text-2xl leading-snug font-semibold tracking-[-0.02em] text-balance text-ambedkar-950 sm:text-3xl">
              “{quote.text}”
            </blockquote>
            <figcaption class="mt-8 text-sm font-bold tracking-[0.12em] text-ambedkar-700 uppercase">
              — {quote.author}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Container>
</section>
