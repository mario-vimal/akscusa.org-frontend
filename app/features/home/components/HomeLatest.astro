---
import Container from "~/components/ui/Container.astro";
import ResponsiveImage from "~/components/ui/ResponsiveImage.astro";
import { COVER_ALT, COVER_WIDTHS } from "~/features/books/covers";
import { formatDate, isoDate } from "~/lib/dates";
import type {
  BookFeature,
  FeaturedRef,
  LeadArticle,
  ReadingFeature,
} from "~/features/home/queries/featured";

interface Props {
  lead?: LeadArticle;
  more: readonly FeaturedRef[];
  reading?: ReadingFeature;
  book?: BookFeature;
  recent: readonly FeaturedRef[];
}

const { lead, more, reading, book, recent } = Astro.props;
---

<!--
  The latest work, in three different shapes rather than three of the same
  card. An essay is a piece of writing, so it leads at the size of writing; a
  book is an object, so it is shown as one; and the rest is an index, because a
  list of recent things is a list.
-->
<section class="bg-paper" aria-labelledby="latest-title">
  <Container class="py-20 sm:py-28">
    <div class="section-head reveal">
      <p class="eyebrow">Latest from AKSC</p>
      <h2
        id="latest-title"
        class="font-display text-display-sm leading-[1.04] font-bold tracking-display text-balance text-ambedkar-950"
      >
        What the circle is writing, reading, and taking on.
      </h2>
    </div>

    <div class="mt-14 grid gap-14 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
      <div class="reveal-children flex flex-col">
        {
          lead && (
            <article>
              <p class="label text-accent-700">{lead.section}</p>
              <h3 class="mt-4 font-display text-3xl leading-[1.08] font-bold tracking-title text-balance text-ambedkar-950 sm:text-[2.375rem]">
                <a class="link-underline" href={lead.href}>
                  {lead.title}
                </a>
              </h3>
              <p class="mt-5 max-w-xl font-serif text-lg leading-[1.7] text-ambedkar-900/80">
                {lead.summary}
              </p>
              <p class="mt-6 text-sm text-ambedkar-900/70">
                <time datetime={isoDate(lead.date)}>
                  {formatDate(lead.date)}
                </time>
                {lead.authors && <span> · {lead.authors}</span>}
              </p>
            </article>
          )
        }

        {
          more.length > 0 && (
            <div class="mt-12">
              <p class="label text-ambedkar-900/70">More writing</p>
              <ul class="mt-4 border-t border-rule">
                {more.map((item) => (
                  <li class="group relative border-b border-rule">
                    <a
                      class="flex items-baseline gap-5 py-4 after:absolute after:inset-0"
                      href={item.href}
                    >
                      <time
                        class="shrink-0 font-display text-[0.6875rem] font-semibold tracking-[0.12em] text-ambedkar-900/70 uppercase tabular-nums"
                        datetime={isoDate(item.date)}
                      >
                        {item.date.getUTCFullYear()}
                      </time>
                      <span class="font-display text-[1.0625rem] leading-[1.35] font-medium text-ambedkar-950 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
                        {item.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <p class="mt-6">
                <a class="btn btn-outline btn-sm" href="/blog/">
                  Read the blog
                </a>
              </p>
            </div>
          )
        }
      </div>

      <div class="reveal-children flex flex-col gap-12">
        {
          (book || reading) && (
            <article>
              <p class="label text-accent-700">Reading circle</p>

              {book && (
                <div class="mt-5 flex gap-5">
                  {book.cover && (
                    <a class="shrink-0 self-start" href={book.href}>
                      <ResponsiveImage
                        class="w-24 rounded-md shadow-lift sm:w-28"
                        src={book.cover}
                        alt={COVER_ALT}
                        sizes="(min-width: 640px) 112px, 96px"
                        widths={COVER_WIDTHS}
                      />
                    </a>
                  )}
                  <div class="min-w-0">
                    <p class="label label-sm text-ambedkar-900/70">
                      Latest book read
                    </p>
                    <h3 class="mt-2 font-display text-xl leading-[1.16] font-bold tracking-title text-balance text-ambedkar-950">
                      <a class="link-underline" href={book.href}>
                        {book.title}
                      </a>
                    </h3>
                    {book.authors && (
                      <p class="mt-2 font-serif text-base leading-6 text-ambedkar-900/80 italic">
                        {book.authors}
                      </p>
                    )}
                    <p class="mt-3 text-sm leading-6 text-ambedkar-900/70">
                      {book.sessions > 1
                        ? `Read over ${book.sessions} sessions`
                        : "Read in one session"}
                      <span> · </span>
                      <time datetime={isoDate(book.readOn)}>
                        {formatDate(book.readOn)}
                      </time>
                    </p>
                  </div>
                </div>
              )}

              {reading && (
                <div class="mt-7 border-t border-rule pt-6">
                  <p class="label label-sm text-ambedkar-900/70">
                    {reading.upcoming ? "Next session" : "Last met"}
                  </p>
                  <h3 class="mt-2 font-display text-lg leading-[1.25] font-bold tracking-title text-balance text-ambedkar-950">
                    <a class="link-underline" href={reading.href}>
                      {reading.title}
                    </a>
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-ambedkar-900/70">
                    <time datetime={isoDate(reading.date)}>
                      {formatDate(reading.date)}
                    </time>
                    <span class="block">{reading.location}</span>
                  </p>
                </div>
              )}

              <p class="mt-6">
                <a class="btn btn-outline btn-sm" href="/book-readings/">
                  All readings
                </a>
              </p>
            </article>
          )
        }

        {
          recent.length > 0 && (
            <div>
              <p class="label text-accent-700">Also recently</p>
              <ul class="mt-4 border-t border-rule">
                {recent.map((item) => (
                  <li class="group relative border-b border-rule">
                    <a
                      class="flex flex-col gap-1 py-4 after:absolute after:inset-0"
                      href={item.href}
                    >
                      <span class="label label-sm text-ambedkar-900/70">
                        {item.section}
                        <span> · </span>
                        <time datetime={isoDate(item.date)}>
                          {formatDate(item.date)}
                        </time>
                      </span>
                      <span class="font-display text-[1.0625rem] leading-[1.3] font-medium text-ambedkar-950 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
                        {item.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </Container>
</section>
