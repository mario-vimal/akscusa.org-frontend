---
import Container from "~/components/ui/Container.astro";
import { formatDate, isoDate } from "~/lib/dates";
import type {
  FeaturedRef,
  LeadArticle,
} from "~/features/home/queries/featured";

interface Props {
  lead?: LeadArticle;
  more: readonly FeaturedRef[];
  recent: readonly FeaturedRef[];
}

const { lead, more, recent } = Astro.props;
---

<!--
  The latest work, in two different shapes rather than two of the same card. An
  essay is a piece of writing, so it leads at the size of writing, and the rest
  is an index, because a list of recent things is a list.

  The reading circle used to be the right-hand column here. It now opens the
  page, in HomeReading: a study circle's books are not one of three things it
  did lately.
-->
<section class="bg-paper" aria-labelledby="latest-title">
  <Container class="py-24 sm:py-32">
    <div class="section-head reveal">
      <p class="eyebrow">Latest from AKSC</p>
      <h2
        id="latest-title"
        class="font-display text-display-sm leading-[1.04] font-bold tracking-display text-balance text-ambedkar-950"
      >
        What the circle is writing and taking on.
      </h2>
    </div>

    <div class="mt-14 grid gap-14 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
      <div class="reveal-children flex flex-col">
        {
          lead && (
            <article>
              <p class="label text-accent-700">{lead.section}</p>
              <h3 class="mt-4 font-display text-3xl leading-[1.08] font-bold tracking-title text-balance text-ambedkar-950 sm:text-[2.375rem]">
                <a class="link-underline" href={lead.href}>
                  {lead.title}
                </a>
              </h3>
              <p class="mt-5 max-w-xl font-serif text-lg leading-[1.7] text-ambedkar-900/80">
                {lead.summary}
              </p>
              <p class="mt-6 text-sm text-ambedkar-900/70">
                <time datetime={isoDate(lead.date)}>
                  {formatDate(lead.date)}
                </time>
                {lead.authors && <span> · {lead.authors}</span>}
              </p>
            </article>
          )
        }

        {
          more.length > 0 && (
            <div class="mt-12">
              <p class="label text-ambedkar-900/70">More writing</p>
              <ul class="mt-4 border-t border-rule">
                {more.map((item) => (
                  <li class="group relative border-b border-rule">
                    <a
                      class="flex items-baseline gap-5 py-4 after:absolute after:inset-0"
                      href={item.href}
                    >
                      <time
                        class="shrink-0 font-display text-[0.6875rem] font-semibold tracking-[0.12em] text-ambedkar-900/70 uppercase tabular-nums"
                        datetime={isoDate(item.date)}
                      >
                        {item.date.getUTCFullYear()}
                      </time>
                      <span class="font-display text-[1.0625rem] leading-[1.35] font-medium text-ambedkar-950 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
                        {item.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <p class="mt-6">
                <a class="btn btn-outline btn-sm" href="/blog/">
                  Read the blog
                </a>
              </p>
            </div>
          )
        }
      </div>

      <div class="reveal-children flex flex-col gap-12">
        {
          recent.length > 0 && (
            <div>
              <p class="label text-accent-700">Also recently</p>
              <ul class="mt-4 border-t border-rule">
                {recent.map((item) => (
                  <li class="group relative border-b border-rule">
                    <a
                      class="flex flex-col gap-1 py-4 after:absolute after:inset-0"
                      href={item.href}
                    >
                      <span class="label label-sm text-ambedkar-900/70">
                        {item.section}
                        <span> · </span>
                        <time datetime={isoDate(item.date)}>
                          {formatDate(item.date)}
                        </time>
                      </span>
                      <span class="font-display text-[1.0625rem] leading-[1.3] font-medium text-ambedkar-950 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
                        {item.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </Container>
</section>
