---
import Container from "../../../components/ui/Container.astro";
import ResponsiveImage from "../../../components/ui/ResponsiveImage.astro";
import organizeHero from "../assets/organize-hero.webp";
import type { HomePageData } from "../content";

interface Props {
  hero: HomePageData["hero"];
}

const { hero } = Astro.props;
---

<section
  class="on-dark relative isolate flex min-h-152 flex-col justify-end overflow-hidden bg-ambedkar-950 sm:min-h-176 lg:min-h-200"
>
  <ResponsiveImage
    src={organizeHero}
    alt={hero.imageAlt}
    class="absolute inset-0 -z-30 size-full object-cover duotone"
    loading="eager"
    sizes="100vw"
    widths={[640, 960, 1280, 1500]}
  />
  <!--
    Two layers over the photograph rather than four. The first returns the brand
    blue that `duotone` stripped out; the second is a single vertical ramp that
    carries the picture down into the ink the headline is set on. The dot field
    and the blurred teal blob that used to sit here were doing nothing the type
    was not already doing better.
  -->
  <div
    class="absolute inset-0 -z-20 bg-ambedkar-800 mix-blend-color"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,var(--color-ambedkar-950)_0%,rgb(12_30_54/0.96)_44%,rgb(12_30_54/0.6)_72%,rgb(12_30_54/0.42)_100%)]"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 -z-10 grain opacity-[0.04]" aria-hidden="true">
  </div>

  <Container class="pt-28 pb-16 sm:pt-36 sm:pb-20">
    <div class="rise max-w-5xl">
      <p class="eyebrow eyebrow-light">{hero.eyebrow}</p>
      <h1
        class="mt-7 font-display text-display-xl leading-[0.9] font-bold tracking-display text-balance text-white"
      >
        {hero.title}
      </h1>
      <p
        class="mt-8 max-w-2xl font-serif text-xl leading-[1.6] text-white/80 sm:text-2xl"
      >
        {hero.description}
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a class="btn btn-primary" href={hero.primaryAction.href}>
          {hero.primaryAction.label}
        </a>
        <a class="btn btn-outline-light" href={hero.secondaryAction.href}>
          {hero.secondaryAction.label}
        </a>
      </div>
    </div>
  </Container>
</section>
