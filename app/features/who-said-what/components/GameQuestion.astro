---
import type { GameQuestionView } from "~/features/who-said-what/presenters";
import GamePhoto from "./GamePhoto.astro";

interface Props {
  question: GameQuestionView;
}

const { question } = Astro.props;
const { id } = question;
---

<section
  class="section-head game-question"
  id={id}
  aria-labelledby={`${id}-heading`}
  data-game-question
  data-answer={question.answer}
>
  <h3 id={`${id}-heading`} class="label text-ambedkar-700">
    {question.label}
  </h3>

  <div class="min-w-0">
    <fieldset class="min-w-0" aria-describedby={`${id}-hint ${id}-feedback`}>
      <legend class="game-question__prompt">{question.prompt}</legend>
      {
        question.quotes.length > 0 && (
          <ul class="mt-5 list-disc space-y-2 pl-6 font-serif text-xl leading-relaxed text-ambedkar-900">
            {question.quotes.map((quote) => (
              <li>{quote}</li>
            ))}
          </ul>
        )
      }
      <p id={`${id}-hint`} class="label mt-6 text-ambedkar-700">
        {question.hint}
      </p>
      <div class="mt-4 grid gap-3">
        {
          question.choices.map((choice) => (
            <label class="game-question__choice" for={`${id}-${choice.value}`}>
              <input
                id={`${id}-${choice.value}`}
                type={question.inputType}
                name={id}
                value={choice.value}
                data-game-choice
              />
              <span>
                <span class="label label-sm mb-2 block text-ambedkar-700">
                  Choice {choice.letter}
                </span>
                {choice.text}
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="mt-5" data-question-actions hidden>
      <button
        class="btn btn-primary"
        type="button"
        data-check-answer
        aria-describedby={`${id}-heading`}
      >
        Check answer
      </button>
    </div>
    <p
      class="game-question__feedback"
      id={`${id}-feedback`}
      role="status"
      aria-atomic="true"
      data-answer-feedback
    >
    </p>

    <details class="game-question__answer mt-6" data-answer-details>
      <summary class="font-display text-base font-semibold text-ambedkar-800">
        Show answer and explanation<span class="sr-only">
          for {question.label.toLowerCase()}
        </span>
      </summary>
      <div class="pt-6">
        <p class="label text-ambedkar-700">{question.answerLabel}</p>
        <div
          class="mt-5 space-y-4 font-serif text-xl leading-relaxed text-ambedkar-900"
        >
          {question.explanation.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="mt-7 max-w-md">
          <GamePhoto
            photo={question.photo}
            sizes="(min-width: 768px) 448px, calc(100vw - 2.5rem)"
          />
        </div>
        {
          question.references.length > 0 && (
            <div class="mt-7">
              <h4 class="label text-ambedkar-700">References</h4>
              <ol class="mt-4 list-decimal space-y-3 pl-5 font-sans text-base leading-relaxed text-ambedkar-800">
                {question.references.map((reference) => (
                  <li class="pl-1">
                    {reference.before && `${reference.before} `}
                    <a
                      class="underline underline-offset-4"
                      href={reference.href}
                    >
                      {reference.label}
                    </a>
                    {reference.after && ` ${reference.after}`}
                  </li>
                ))}
              </ol>
            </div>
          )
        }
      </div>
    </details>
  </div>
</section>

<style>
  .game-question {
    scroll-margin-top: 8rem;
  }

  .game-question__prompt {
    max-width: 100%;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    line-height: 1.55;
    color: var(--color-ambedkar-950);
  }

  .game-question__choice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.875rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 0.375rem;
    padding: 1rem;
    background: var(--color-paper);
    font-family: var(--font-sans);
    line-height: 1.6;
    color: var(--color-ambedkar-950);
    cursor: pointer;
  }

  .game-question__choice:hover,
  .game-question__choice:has(:checked) {
    border-color: var(--color-ambedkar-700);
    background: var(--color-ambedkar-50);
  }

  .game-question__choice input {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.125rem;
    accent-color: var(--color-ambedkar-700);
  }

  .game-question__feedback {
    margin-top: 1rem;
    font-family: var(--font-sans);
    line-height: 1.6;
    color: var(--color-ambedkar-800);
  }

  .game-question__feedback:empty {
    margin-top: 0;
  }

  .game-question__answer summary {
    min-height: 2.875rem;
    padding-block: 0.75rem;
    cursor: pointer;
  }

  .game-question__answer summary::marker {
    color: var(--color-accent-700);
  }
</style>
