---
import Container from "../../../components/ui/Container.astro";
import PageMasthead from "../../../components/ui/PageMasthead.astro";
import { socialLinks } from "../../../config/social";

interface Channel {
  title: string;
  description: string;
  actionLabel: string;
  actionHref: string;
  note?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  intro: string;
  channels: readonly Channel[];
  socialHeading: string;
  socialIntro: string;
}

const { eyebrow, title, intro, channels, socialHeading, socialIntro } =
  Astro.props;
---

<section>
  <PageMasthead eyebrow={eyebrow} title={title} description={intro} />

  <Container class="pt-14 pb-20 sm:pt-16 sm:pb-28">
    <ul class="reveal-children grid gap-6 lg:grid-cols-2">
      {
        channels.map((channel) => (
          <li class="card p-6 sm:p-8">
            <h2 class="font-display text-[1.375rem] leading-[1.14] font-semibold tracking-title text-ambedkar-950">
              {channel.title}
            </h2>
            <p class="mt-3 leading-7 text-ambedkar-900/75">
              {channel.description}
            </p>

            {channel.note && (
              <p class="mt-4 rounded-l-md rounded-r-2xl border-l-4 border-alert-600 bg-alert-50 px-4 py-3 text-sm leading-6 font-semibold text-alert-950">
                {channel.note}
              </p>
            )}

            <p class="mt-auto pt-6">
              <a class="btn btn-ink" href={channel.actionHref}>
                {channel.actionLabel}
              </a>
            </p>
          </li>
        ))
      }
    </ul>

    <section class="card mt-8 p-6 sm:p-8">
      <h2
        class="font-display text-[1.375rem] leading-[1.14] font-semibold tracking-title text-ambedkar-950"
      >
        {socialHeading}
      </h2>
      <p class="mt-3 leading-7 text-ambedkar-900/75">{socialIntro}</p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          socialLinks.map((item) => (
            <li>
              <a
                class="inline-flex rounded-md border border-rule-strong bg-mist px-3.5 py-2 font-display text-[0.8125rem] font-medium text-ambedkar-800 transition-colors hover:border-ambedkar-950 hover:bg-white hover:text-ambedkar-950"
                href={item.href}
                rel="me"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</section>
