---
import type { CollectionEntry } from "astro:content";

import Container from "~/components/ui/Container.astro";
import ResponsiveImage from "~/components/ui/ResponsiveImage.astro";
import Poster from "~/components/ui/Poster.astro";
import helplineBanner from "~/features/anti-caste-helpline/assets/helpline-banner.jpg";
import helplineFlyer from "~/features/anti-caste-helpline/assets/helpline-flyer.jpg";

type Props = Extract<
  CollectionEntry<"pages">["data"],
  { pageType: "helpline" }
>;

const {
  title,
  eyebrow,
  emergencyDanger,
  emergencyCrisis,
  supportQuestions,
  phone,
  email,
  contactNote,
  bannerAlt,
  flyerAlt,
  flyerCaption,
} = Astro.props;
---

<!--
  The crimson is spent here and on the testimonies content note, and nowhere
  else, so that seeing it on this site still means something is urgent.
-->
<section
  class="border-b-2 border-alert-600/25 bg-alert-50 text-alert-950"
  aria-label="Emergency information"
>
  <Container
    class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 py-3 text-center text-sm leading-6 font-semibold"
  >
    <span
      class="rounded-sm bg-alert-600 px-1.5 py-0.5 font-display text-[0.625rem] font-semibold tracking-[0.1em] text-white uppercase"
    >
      Emergency
    </span>
    <span>
      {emergencyDanger}{" "}
      <a class="underline decoration-2 underline-offset-2" href="tel:911">911</a
      >. {emergencyCrisis}{" "}
      <a class="underline decoration-2 underline-offset-2" href="tel:988">988</a
      >.
    </span>
  </Container>
</section>

<section aria-labelledby="helpline-title">
  <Container size="wide" class="pt-8 sm:pt-12">
    <ResponsiveImage
      src={helplineBanner}
      alt={bannerAlt}
      class="w-full rounded-xl shadow-lift"
      loading="eager"
      sizes="(min-width: 1360px) 1296px, calc(100vw - 2.5rem)"
    />
  </Container>

  <Container class="pt-12 pb-16 sm:pb-20">
    <div
      class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,24rem)] lg:items-start"
    >
      <div class="min-w-0">
        <p class="eyebrow">{eyebrow}</p>
        <h1
          id="helpline-title"
          class="mt-5 font-display text-display-lg leading-[0.98] font-bold tracking-display text-balance text-ambedkar-950"
        >
          {title}
        </h1>

        <ul class="mt-8 space-y-4 text-lg leading-8 text-ambedkar-900/80">
          {
            supportQuestions.map((question) => (
              <li class="flex gap-4">
                <span
                  class="mt-3.5 size-2 shrink-0 rounded-full bg-accent-600"
                  aria-hidden="true"
                />
                <span>{question}</span>
              </li>
            ))
          }
        </ul>

        <div
          class="on-dark relative isolate mt-10 overflow-hidden rounded-xl bg-ambedkar-950 p-6 text-white sm:p-8"
          aria-labelledby="contact-title"
        >
          <div
            class="absolute inset-0 -z-10 bg-linear-to-br from-ambedkar-900 to-ambedkar-1000"
            aria-hidden="true"
          >
          </div>
          <h2
            id="contact-title"
            class="font-display text-2xl leading-[1.12] font-semibold tracking-title"
          >
            Contact the helpline
          </h2>
          <div class="mt-5 flex flex-col gap-3">
            <a
              class="w-fit text-xl font-bold text-accent-300 underline decoration-accent-300/40 decoration-2 underline-offset-4 transition-colors hover:decoration-accent-300 sm:text-2xl"
              href={phone.href}
            >
              {phone.display}
            </a>
            <a
              class="w-fit text-lg font-bold break-all text-accent-300 underline decoration-accent-300/40 decoration-2 underline-offset-4 transition-colors hover:decoration-accent-300 sm:text-xl"
              href={`mailto:${email}`}
            >
              {email}
            </a>
          </div>
          <p class="mt-5 leading-7 text-white/80">
            {contactNote}
          </p>
        </div>

        <div
          class="helpline-content mt-10 text-base leading-8 text-ambedkar-900/78"
        >
          <slot />
        </div>
      </div>

      <div class="lg:sticky lg:top-24">
        <Poster
          src={helplineFlyer}
          alt={flyerAlt}
          caption={flyerCaption}
          sizes="(min-width: 1024px) 380px, calc(100vw - 5rem)"
          widths={[320, 640, 960]}
        />
      </div>
    </div>
  </Container>
</section>

<style>
  .helpline-content :global(p + p) {
    margin-top: 1.5rem;
  }

  .helpline-content :global(ol) {
    margin-top: 1.5rem;
    list-style-type: decimal;
    padding-left: 1.5rem;
  }

  .helpline-content :global(li + li) {
    margin-top: 0.75rem;
  }

  .helpline-content :global(li::marker) {
    color: var(--color-accent-600);
    font-weight: 700;
  }

  .helpline-content :global(strong) {
    color: var(--color-ambedkar-950);
  }

  .helpline-content :global(a) {
    color: var(--color-ambedkar-700);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
</style>
