---
import Container from "../../../components/ui/Container.astro";

interface Category {
  label: string;
  id: string;
}

interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  contentNote: string;
  categories: Category[];
  shareUrl: string;
  solidarityUrl: string;
}

const {
  title,
  eyebrow,
  intro,
  contentNote,
  categories,
  shareUrl,
  solidarityUrl,
} = Astro.props;
---

<section class="relative isolate overflow-x-clip">
  <div
    class="absolute inset-x-0 top-0 -z-10 h-[34rem] bg-[radial-gradient(circle_at_top_right,rgba(240,184,63,0.2),transparent_48%),radial-gradient(circle_at_top_left,rgba(31,98,170,0.18),transparent_42%)]"
    aria-hidden="true"
  >
  </div>

  <Container class="pt-16 pb-20 sm:pt-24 sm:pb-28">
    <header class="max-w-4xl">
      <p
        class="text-sm font-bold tracking-[0.18em] text-ambedkar-700 uppercase"
      >
        {eyebrow}
      </p>
      <h1
        class="mt-4 text-4xl leading-[1.05] font-semibold tracking-[-0.045em] text-balance text-ambedkar-950 sm:text-6xl lg:text-7xl"
      >
        {title}
      </h1>
      <p
        class="mt-7 max-w-3xl text-lg leading-8 text-ambedkar-900/75 sm:text-xl"
      >
        {intro}
      </p>
      <p
        class="mt-7 max-w-3xl rounded-2xl border border-ambedkar-900/10 bg-white/75 px-5 py-4 text-sm leading-6 text-ambedkar-900/70 shadow-soft"
      >
        {contentNote}
      </p>
    </header>

    <details
      data-topic-menu
      class="sticky top-20 z-30 mt-10 rounded-2xl border border-ambedkar-900/10 bg-white p-5 shadow-soft lg:hidden"
    >
      <summary class="cursor-pointer font-semibold text-ambedkar-950">
        Browse by topic
      </summary>
      <nav
        class="mt-4 max-h-[60vh] overflow-y-auto"
        aria-label="Testimony topics"
      >
        <ol class="grid gap-1">
          {
            categories.map((category) => (
              <li>
                <a
                  class="block rounded-lg px-3 py-2 text-sm font-medium text-ambedkar-800 hover:bg-ambedkar-50 hover:text-ambedkar-950"
                  href={`#${category.id}`}
                >
                  {category.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </details>

    <div class="mt-12 lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-14">
      <aside class="sticky top-24 hidden self-start lg:block">
        <nav
          class="max-h-[calc(100vh-7rem)] overflow-y-auto rounded-2xl border border-ambedkar-900/10 bg-white p-5 shadow-soft"
          aria-label="Testimony topics"
        >
          <p
            class="px-3 text-xs font-bold tracking-[0.16em] text-ambedkar-700 uppercase"
          >
            Browse by topic
          </p>
          <ol class="mt-3 grid gap-1">
            {
              categories.map((category) => (
                <li>
                  <a
                    class="block rounded-lg px-3 py-2 text-sm leading-5 font-medium text-ambedkar-800 hover:bg-ambedkar-50 hover:text-ambedkar-950"
                    href={`#${category.id}`}
                  >
                    {category.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <article class="testimonies-content max-w-3xl min-w-0">
        <slot />
      </article>
    </div>

    <div
      class="mt-16 rounded-3xl bg-ambedkar-950 px-6 py-8 text-white sm:px-10 sm:py-10 lg:ml-[19.5rem]"
    >
      <p class="text-sm font-bold tracking-[0.16em] text-saffron-300 uppercase">
        Add your voice
      </p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">
        Help document and end caste practices in the USA.
      </h2>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a
          class="rounded-full bg-saffron-300 px-5 py-3 text-center font-semibold text-ambedkar-950 transition hover:bg-saffron-400"
          href={shareUrl}
        >
          Share your testimony
        </a>
        <a
          class="rounded-full border border-white/30 px-5 py-3 text-center font-semibold text-white transition hover:bg-white/10"
          href={solidarityUrl}
        >
          Sign the solidarity statement
        </a>
      </div>
    </div>
  </Container>
</section>

<script>
  const topicMenu =
    document.querySelector<HTMLDetailsElement>("[data-topic-menu]");

  if (topicMenu) {
    document.addEventListener("pointerdown", (event) => {
      if (
        topicMenu.open &&
        event.target instanceof Node &&
        !topicMenu.contains(event.target)
      ) {
        topicMenu.open = false;
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && topicMenu.open) {
        topicMenu.open = false;
        topicMenu.querySelector("summary")?.focus();
      }
    });

    topicMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        topicMenu.open = false;
      });
    });
  }
</script>

<style>
  :global(.testimonies-content > p) {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: color-mix(in srgb, var(--color-ambedkar-900) 78%, transparent);
  }

  :global(.testimonies-content > p:first-child) {
    margin-top: 0;
  }

  :global(.testimonies-content h2) {
    margin-top: 4.5rem;
    scroll-margin-top: 11rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-ambedkar-900) 14%, transparent);
    padding-bottom: 1rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--color-ambedkar-950);
    text-wrap: balance;
  }

  :global(.testimonies-content h3) {
    margin-top: 3rem;
    scroll-margin-top: 7rem;
    border-left: 0.25rem solid var(--color-saffron-400);
    padding-left: 1rem;
    font-size: 1.375rem;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--color-ambedkar-950);
    text-wrap: pretty;
  }

  :global(.testimonies-content h2 + h3) {
    margin-top: 2rem;
  }

  :global(.testimonies-content p:has(> em:only-child)) {
    margin-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ambedkar-700);
  }

  :global(.testimonies-content a) {
    font-weight: 600;
    color: var(--color-ambedkar-700);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 374px) {
    :global(.testimonies-content h2) {
      overflow-wrap: anywhere;
    }
  }

  @media (min-width: 64rem) {
    :global(.testimonies-content h2) {
      scroll-margin-top: 7rem;
    }
  }
</style>
