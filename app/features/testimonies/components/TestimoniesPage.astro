---
import savitribaiMural from "~/assets/shared/leaders/savitribai-phule-mural-cc-by-sa-4.jpg";
import Container from "~/components/ui/Container.astro";
import PageMasthead from "~/components/ui/PageMasthead.astro";

interface Category {
  label: string;
  id: string;
}

interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  contentNote: string;
  categories: Category[];
  shareUrl: string;
  solidarityUrl: string;
}

const {
  title,
  eyebrow,
  intro,
  contentNote,
  categories,
  shareUrl,
  solidarityUrl,
} = Astro.props;
---

<section>
  <PageMasthead
    eyebrow={eyebrow}
    title={title}
    description={intro}
    size="large"
    backgroundImage={savitribaiMural}
    backgroundLabel="Savitribai Phule mural in Pune"
    backgroundCredit={{
      creator: "Wander-earth / Wikimedia Commons",
      sourceHref:
        "https://commons.wikimedia.org/wiki/File:Portrait_of_Savitribai_Phule_in_Pune.tif",
      license: "CC BY-SA 4.0",
      licenseHref: "https://creativecommons.org/licenses/by-sa/4.0/",
    }}
  />

  <Container class="pt-10 pb-20 sm:pt-12 sm:pb-28">
    <p
      class="max-w-3xl rounded-l-md rounded-r-2xl border border-l-4 border-rule border-l-alert-600 bg-white px-5 py-4 text-sm leading-6 text-ambedkar-900/75 shadow-card"
    >
      {contentNote}
    </p>

    <details
      data-topic-menu
      class="group sticky top-22 z-30 mt-8 rounded-2xl border border-rule bg-white p-5 shadow-card lg:hidden"
    >
      <summary
        class="flex cursor-pointer items-center justify-between gap-3 font-semibold text-ambedkar-950"
      >
        Browse by topic
        <span
          class="text-accent-600 transition-transform group-open:rotate-180"
          aria-hidden="true">&darr;</span
        >
      </summary>
      <nav
        class="mt-4 max-h-[60vh] overflow-y-auto"
        aria-label="Testimony topics"
      >
        <ol class="grid gap-1">
          {
            categories.map((category) => (
              <li>
                <a
                  class="block rounded-lg px-3 py-2.5 text-sm font-medium text-ambedkar-800 transition-colors hover:bg-ambedkar-50 hover:text-ambedkar-950"
                  href={`#${category.id}`}
                >
                  {category.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </details>

    <div class="mt-10 lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-14">
      <aside class="sticky top-24 hidden self-start lg:block">
        <nav
          class="max-h-[calc(100vh-7rem)] overflow-y-auto rounded-2xl border border-rule bg-white p-5 shadow-card"
          aria-label="Testimony topics"
        >
          <p class="eyebrow px-1">Browse by topic</p>
          <ol class="mt-4 grid gap-1">
            {
              categories.map((category) => (
                <li>
                  <a
                    class="block rounded-lg px-3 py-2 text-sm leading-5 font-medium text-ambedkar-800 transition-colors hover:bg-ambedkar-50 hover:text-ambedkar-950"
                    href={`#${category.id}`}
                  >
                    {category.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <article class="testimonies-content max-w-3xl min-w-0">
        <slot />
      </article>
    </div>

    <div
      class="on-dark relative isolate mt-16 overflow-hidden rounded-xl bg-ambedkar-950 px-6 py-9 text-white sm:px-10 sm:py-11 lg:ml-78"
    >
      <div
        class="absolute inset-0 -z-10 bg-linear-to-br from-ambedkar-900 to-ambedkar-1000"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute inset-0 -z-10 grain opacity-[0.06]"
        aria-hidden="true"
      >
      </div>

      <p class="eyebrow eyebrow-light">Add your voice</p>
      <h2
        class="mt-4 font-display text-display-sm leading-[1.04] font-bold tracking-display text-balance"
      >
        Help document and end caste practices in the USA.
      </h2>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a class="btn btn-primary" href={shareUrl}> Share your testimony </a>
        <a class="btn btn-outline-light" href={solidarityUrl}>
          Sign the solidarity statement
        </a>
      </div>
    </div>
  </Container>
</section>

<script>
  const topicMenu =
    document.querySelector<HTMLDetailsElement>("[data-topic-menu]");

  if (topicMenu) {
    document.addEventListener("pointerdown", (event) => {
      if (
        topicMenu.open &&
        event.target instanceof Node &&
        !topicMenu.contains(event.target)
      ) {
        topicMenu.open = false;
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && topicMenu.open) {
        topicMenu.open = false;
        topicMenu.querySelector("summary")?.focus();
      }
    });

    topicMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        topicMenu.open = false;
      });
    });
  }
</script>

<style>
  :global(.testimonies-content) {
    overflow-wrap: break-word;
  }

  :global(.testimonies-content > p) {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: color-mix(in srgb, var(--color-ambedkar-900) 78%, transparent);
  }

  :global(.testimonies-content > p:first-child) {
    margin-top: 0;
  }

  :global(.testimonies-content h2) {
    margin-top: 4.5rem;
    scroll-margin-top: 11rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-ambedkar-900) 14%, transparent);
    padding-bottom: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-ambedkar-950);
    text-wrap: balance;
  }

  :global(.testimonies-content h3) {
    margin-top: 3rem;
    scroll-margin-top: 7rem;
    border-left: 0.1875rem solid var(--color-accent-600);
    padding-left: 1rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ambedkar-950);
    text-wrap: pretty;
  }

  :global(.testimonies-content h2 + h3) {
    margin-top: 2rem;
  }

  :global(.testimonies-content p:has(> em:only-child)) {
    margin-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ambedkar-700);
  }

  /* Testimonies cite sources as bare URLs, which have no space to break at. */
  :global(.testimonies-content a) {
    font-weight: 600;
    color: var(--color-ambedkar-700);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 374px) {
    :global(.testimonies-content h2) {
      overflow-wrap: anywhere;
    }
  }

  @media (min-width: 64rem) {
    :global(.testimonies-content h2) {
      scroll-margin-top: 7rem;
    }
  }
</style>
