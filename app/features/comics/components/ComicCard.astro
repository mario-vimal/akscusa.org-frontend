---
import type { SizedPanel } from "~/features/artwork/panels";

interface Props {
  href: string;
  title: string;
  summary: string;
  /** The comic's title panel, used as its cover. */
  cover: SizedPanel;
  credit: string;
  panelCount: string;
  /** Warns before a comic that depicts violence or a slur. */
  contentNote?: string;
}

const { href, title, summary, cover, credit, panelCount, contentNote } =
  Astro.props;
---

<article class="card group">
  <!--
    Two thin sheets sit behind the cover so a card reads as a sequence of
    panels rather than a single picture. They are drawn, not stacked images,
    so the effect costs nothing and cannot fall out of step with the artwork.
  -->
  <div class="relative isolate bg-mist">
    <div
      class="absolute inset-x-6 top-2 -z-10 h-6 rounded-t-xl bg-white/70 ring-1 ring-ambedkar-900/10"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-x-3 top-4 -z-10 h-6 rounded-t-xl bg-white/85 ring-1 ring-ambedkar-900/10"
      aria-hidden="true"
    >
    </div>

    <img
      class="mt-6 aspect-square w-full object-contain"
      src={cover.src}
      alt=""
      width={cover.width}
      height={cover.height}
      loading="lazy"
      decoding="async"
    />

    <p
      class="absolute right-3 bottom-3 rounded-sm bg-ambedkar-950/90 px-2 py-1 font-display text-[0.625rem] font-semibold tracking-[0.1em] text-white uppercase"
    >
      {panelCount}
    </p>
  </div>

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <h2
      class="font-display text-[1.375rem] leading-[1.14] font-semibold tracking-title text-balance text-ambedkar-950"
    >
      <a class="after:absolute after:inset-0" href={href}>{title}</a>
    </h2>

    <p class="mt-3 leading-7 text-ambedkar-900/70">{summary}</p>

    {
      contentNote && (
        <p class="mt-4 border-l-2 border-l-alert-600 pl-3 text-sm leading-6 text-ambedkar-900/70">
          {contentNote}
        </p>
      )
    }

    <p class="mt-auto pt-6 text-sm leading-6 text-ambedkar-900/70">{credit}</p>

    <p
      class="mt-3 flex items-center gap-2 font-display text-xs font-semibold tracking-[0.12em] text-ambedkar-700 uppercase transition-colors group-hover:text-ambedkar-950"
      aria-hidden="true"
    >
      Read
      <span
        class="inline-block transition-transform duration-300 group-hover:translate-x-1"
      >
        &rarr;
      </span>
    </p>
  </div>
</article>
