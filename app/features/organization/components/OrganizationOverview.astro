---
import kingPortrait from "~/assets/shared/leaders/martin-luther-king-jr-public-domain.jpg";
import Container from "~/components/ui/Container.astro";
import PageMasthead from "~/components/ui/PageMasthead.astro";
import ProseContent from "~/features/editorial/components/ProseContent.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  intro: string;
  sourceUrl: string;
}

const { title, eyebrow, intro, sourceUrl } = Astro.props;
---

<section>
  <PageMasthead
    {eyebrow}
    {title}
    description={intro}
    backgroundImage={kingPortrait}
    backgroundLabel="Martin Luther King Jr."
    backgroundPosition="portrait"
  />

  <Container class="pt-12 pb-20 sm:pt-16 sm:pb-28">
    <div
      class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-14"
    >
      <div class="min-w-0">
        <ProseContent>
          <slot />
        </ProseContent>

        <p class="mt-10 max-w-3xl text-sm wrap-break-word text-ambedkar-900/70">
          Originally published at{" "}
          <a
            class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
            href={sourceUrl}
          >
            {sourceUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")}
          </a>
          .
        </p>
      </div>

      <aside
        class="grid gap-5 lg:sticky lg:top-24"
        aria-label="Organization links"
      >
        <!--
          Membership leads the aside. The argument for it is the substance of
          this page, so the way to act on that argument should not sit below a
          list of documents.
        -->
        <section class="on-dark card h-auto bg-ambedkar-950 p-6 text-white">
          <p class="eyebrow eyebrow-light">Join the work</p>
          <h2
            class="mt-4 font-display text-2xl leading-[1.12] font-semibold tracking-title"
          >
            Build collective power
          </h2>
          <p class="mt-3 leading-7 text-white/75">
            Become a member and help organize programs, meetings,
            demonstrations, workshops, and conferences.
          </p>
          <a class="btn btn-primary mt-5" href="/join/"> Join AKSC </a>
        </section>

        <section class="card h-auto p-6">
          <p class="eyebrow">Records</p>
          <h2
            class="mt-4 font-display text-2xl leading-[1.12] font-semibold tracking-title text-ambedkar-950"
          >
            General Body
          </h2>
          <p class="mt-3 leading-7 text-ambedkar-900/75">
            Read AKSC's constitution, annual reports, and resolutions adopted by
            the General Body.
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a class="btn btn-outline" href="/organization/constitution/">
              Read the constitution
            </a>
            <a class="btn btn-outline" href="/organization/general-body/">
              General Body records
            </a>
          </div>
        </section>
      </aside>
    </div>
  </Container>
</section>
