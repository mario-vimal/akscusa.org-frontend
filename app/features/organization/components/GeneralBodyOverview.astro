---
import EditorialIndex from "../../editorial/components/EditorialIndex.astro";
import ProseContent from "../../editorial/components/ProseContent.astro";
import {
  formatDate,
  formatMonth,
  isoDate,
  ordinal,
} from "../../editorial/entries";
import { generalBodyPaperKindLabel } from "../../editorial/taxonomy";
import {
  loadGeneralBodyMeetings,
  type GeneralBodyMeeting,
} from "../queries/general-body";

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  meetingsHeading: string;
  meetingsIntro: string;
  meetingsNote?: string;
}

const {
  eyebrow,
  title,
  description,
  meetingsHeading,
  meetingsIntro,
  meetingsNote,
} = Astro.props;

const meetings = await loadGeneralBodyMeetings();

// The 4th meeting is recorded only as having been held in October 2020, so the
// precision on the entry decides both the wording and the machine-readable
// value rather than printing a day that was never recorded.
const meetingDate = (meeting: GeneralBodyMeeting) =>
  meeting.data.datePrecision === "month"
    ? formatMonth(meeting.data.date)
    : formatDate(meeting.data.date);

const meetingDateTime = (meeting: GeneralBodyMeeting) =>
  meeting.data.datePrecision === "month"
    ? isoDate(meeting.data.date).slice(0, 7)
    : isoDate(meeting.data.date);

const meetingTitle = (meeting: GeneralBodyMeeting) =>
  `${ordinal(meeting.data.edition)} General Body Meeting`;

// Announced as part of the link, so the format and length of the download are
// known before it is followed.
const paperLabel = (paper: GeneralBodyMeeting["data"]["papers"][number]) =>
  paper.pageCount ? `PDF, ${paper.pageCount} pages` : "PDF";
---

<EditorialIndex
  eyebrow={eyebrow}
  title={title}
  description={description}
  count={`${meetings.length} ${meetings.length === 1 ? "meeting" : "meetings"}`}
  empty="No General Body meetings have been published yet."
  isEmpty={meetings.length === 0}
  list={false}
>
  <div slot="intro">
    <ProseContent>
      <slot />
    </ProseContent>
  </div>

  <section class="mt-14" aria-labelledby="general-body-meetings">
    <h2
      id="general-body-meetings"
      class="font-display text-display-sm leading-[1.04] font-bold tracking-display text-ambedkar-950"
    >
      {meetingsHeading}
    </h2>
    <p class="mt-2 text-ambedkar-900/75">{meetingsIntro}</p>
    {
      meetingsNote && (
        <p class="mt-4 max-w-2xl rounded-2xl border border-rule bg-white px-5 py-4 text-sm leading-6 text-ambedkar-900/80 shadow-card">
          {meetingsNote}
        </p>
      )
    }

    <ol class="reveal-children mt-8 space-y-4">
      {
        meetings.map((meeting) => (
          <li class="card p-6 sm:p-8">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 class="font-display text-xl leading-[1.18] font-semibold tracking-title text-ambedkar-950 sm:text-2xl">
                {meetingTitle(meeting)}
              </h3>
              <p class="text-sm text-ambedkar-900/70">
                <time datetime={meetingDateTime(meeting)}>
                  {meetingDate(meeting)}
                </time>
                &middot; {meeting.data.location}
              </p>
            </div>

            <ul class="mt-5 flex flex-wrap gap-3">
              {meeting.data.papers.map((paper) => (
                <li>
                  <a
                    class="inline-flex flex-wrap items-baseline gap-x-2 rounded-2xl border border-rule-strong bg-mist px-4 py-3 font-semibold text-ambedkar-800 transition-colors hover:border-ambedkar-950 hover:bg-ambedkar-50 hover:text-ambedkar-950"
                    href={paper.file}
                  >
                    {generalBodyPaperKindLabel(paper.kind)}
                    <span class="text-sm font-normal text-ambedkar-900/70">
                      {paperLabel(paper)} &darr;
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>
</EditorialIndex>
