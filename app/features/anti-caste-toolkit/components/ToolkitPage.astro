---
import malcolmX from "~/assets/shared/leaders/malcolm-x-public-domain.jpg";
import Container from "~/components/ui/Container.astro";
import PageMasthead from "~/components/ui/PageMasthead.astro";
import ContributeCallout from "~/features/artwork/components/ContributeCallout.astro";
import ProseContent from "~/features/editorial/components/ProseContent.astro";
import type { ScenarioView } from "~/features/anti-caste-toolkit/queries/scenarios";
import ToolkitScenario from "./ToolkitScenario.astro";

interface Action {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  lede: string;
  scenariosHeading: string;
  scenariosIntro: string;
  form: Action;
  scenarios: readonly ScenarioView[];
  contribute: {
    eyebrow: string;
    title: string;
    description: string;
  };
  sourceUrl?: string;
}

const {
  eyebrow,
  title,
  description,
  lede,
  scenariosHeading,
  scenariosIntro,
  form,
  scenarios,
  contribute,
  sourceUrl,
} = Astro.props;

const panelTotal = scenarios.reduce(
  (total, scenario) => total + scenario.panels.length,
  0,
);
---

<section>
  <PageMasthead
    eyebrow={eyebrow}
    title={title}
    description={description}
    size="large"
    backgroundImage={malcolmX}
    backgroundLabel="Malcolm X, 1964"
  >
    <p class="mt-9">
      <a class="btn btn-primary" href={form.href} rel="noopener">
        {form.label}
      </a>
    </p>
  </PageMasthead>

  <Container class="pt-14 pb-20 sm:pt-16 sm:pb-28">
    <!--
      The sentence that names the freeze response leads, set in the display
      serif at pull-quote size. It is the recognition the rest of the page is
      built on, so it is given the weight of an argument rather than of an
      introduction.
    -->
    <p class="toolkit__lede">{lede}</p>

    <div class="mt-10">
      <ProseContent>
        <slot />
      </ProseContent>
    </div>

    <div class="mt-16 border-t border-rule pt-12 sm:mt-20 sm:pt-14">
      <p class="eyebrow">The playbook so far</p>
      <h2 class="toolkit__heading">{scenariosHeading}</h2>
      <p class="toolkit__intro">{scenariosIntro}</p>

      {
        scenarios.length > 1 && (
          <nav class="mt-8" aria-label="Scenarios in this playbook">
            <ol class="flex flex-wrap gap-2">
              {scenarios.map((scenario, index) => (
                <li>
                  <a
                    class="inline-flex items-center gap-2 rounded-md border border-rule-strong bg-white px-3.5 py-2 font-display text-[0.8125rem] font-medium text-ambedkar-800 shadow-card transition-colors hover:border-ambedkar-950 hover:text-ambedkar-950"
                    href={`#${scenario.id}`}
                  >
                    <span class="font-bold text-accent-700" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    {scenario.title}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <p class="mt-6 text-sm text-ambedkar-900/70">
        {scenarios.length}{" "}
        {scenarios.length === 1 ? "scenario" : "scenarios"}, {panelTotal} illustrated
        panels. Every panel carries a transcript and can be opened full screen.
      </p>
    </div>

    {
      scenarios.length === 0 ? (
        <p class="card mt-12 max-w-2xl px-6 py-8 leading-7 text-ambedkar-900/75">
          The first scenarios are being illustrated. Please check back soon.
        </p>
      ) : (
        <div class="mt-14 grid gap-16 sm:gap-20">
          {scenarios.map((scenario, index) => (
            <ToolkitScenario
              number={index + 1}
              id={scenario.id}
              title={scenario.title}
              setting={scenario.setting}
              summary={scenario.summary}
              prompt={scenario.prompt}
              panels={scenario.panels}
              credits={scenario.credits}
              form={form}
            />
          ))}
        </div>
      )
    }

    <ContributeCallout
      class="mt-16 sm:mt-20"
      eyebrow={contribute.eyebrow}
      title={contribute.title}
      description={contribute.description}
      primaryAction={form}
      secondaryAction={{ label: "Read the AKSC comics", href: "/comics/" }}
    />

    {
      sourceUrl && (
        <p class="mt-8 text-sm text-ambedkar-900/70">
          First published at{" "}
          <a
            class="link-underline font-semibold"
            href={sourceUrl}
            rel="noopener"
          >
            {sourceUrl}
          </a>
          .
        </p>
      )
    }
  </Container>
</section>

<style>
  .toolkit__lede {
    max-width: 52rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1rem + 1.9vw, 2rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--color-ambedkar-950);
    text-wrap: pretty;
  }

  .toolkit__heading {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ambedkar-950);
    text-wrap: balance;
  }

  .toolkit__intro {
    margin-top: 1rem;
    max-width: 44rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: color-mix(in srgb, var(--color-ambedkar-900) 78%, transparent);
  }
</style>
