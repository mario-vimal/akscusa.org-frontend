---
interface Action {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  /** What a contributor is asked to send, listed as numbered steps. */
  steps?: readonly string[];
  primaryAction: Action;
  secondaryAction?: Action;
  /** A qualification, such as how work is credited. */
  note?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  steps = [],
  primaryAction,
  secondaryAction,
  note,
  class: className,
} = Astro.props;
---

<!--
  The invitation to add to this work. Both the comics and the toolkit are
  unfinished on purpose, so the call to contribute is part of the page rather
  than a footnote to it, and it says plainly what to send and where.
-->
<aside
  class:list={[
    "on-dark relative isolate overflow-hidden rounded-xl bg-ambedkar-950 px-6 py-9 text-white sm:px-10 sm:py-12",
    className,
  ]}
>
  <div
    class="absolute inset-0 -z-10 bg-linear-to-br from-ambedkar-900 to-ambedkar-1000"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 -z-10 grain opacity-[0.06]" aria-hidden="true">
  </div>

  <div class="max-w-3xl">
    <p class="eyebrow eyebrow-light">{eyebrow}</p>
    <h2
      class="mt-4 font-display text-display-sm leading-[1.04] font-bold tracking-display text-balance"
    >
      {title}
    </h2>
    <p class="mt-5 leading-8 text-white/78">{description}</p>

    {
      steps.length > 0 && (
        <ol class="mt-8 grid gap-4 sm:grid-cols-3">
          {steps.map((step, index) => (
            <li class="rounded-lg bg-white/8 p-5 ring-1 ring-white/12 ring-inset">
              <p
                class="font-display text-2xl leading-none font-bold tracking-display text-accent-300"
                aria-hidden="true"
              >
                {index + 1}
              </p>
              <p class="mt-3 text-sm leading-6 text-white/80">{step}</p>
            </li>
          ))}
        </ol>
      )
    }

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a class="btn btn-primary" href={primaryAction.href}>
        {primaryAction.label}
      </a>
      {
        secondaryAction && (
          <a class="btn btn-outline-light" href={secondaryAction.href}>
            {secondaryAction.label}
          </a>
        )
      }
    </div>

    {note && <p class="mt-6 text-sm leading-6 text-white/70">{note}</p>}
  </div>
</aside>
