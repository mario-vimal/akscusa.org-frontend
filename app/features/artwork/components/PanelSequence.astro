---
import type { SizedPanel } from "../panels";
import PanelTranscript from "./PanelTranscript.astro";

interface Props {
  panels: readonly SizedPanel[];
  /** Names the sequence for assistive technology, usually the work's title. */
  label: string;
  /** Unique on the page. Anchors each panel so a reader can link to one. */
  id: string;
  /**
   * `strip` is one tall column, the way a comic is read. `grid` pairs the
   * panels, which suits a short scenario read at a glance.
   */
  layout?: "strip" | "grid";
  /** The word counters use, so a scenario can say "Panel" and a book "Page". */
  unit?: string;
  /** Matches the surface the sequence is placed on. */
  tone?: "light" | "dark";
  /** Eager-loads the opening panels rather than waiting for the scroll. */
  eagerCount?: number;
}

const {
  panels,
  label,
  id,
  layout = "strip",
  unit = "Panel",
  tone = "light",
  eagerCount = 2,
} = Astro.props;

const total = panels.length;
const hasTranscripts = panels.some((panel) => panel.transcript);
---

<!--
  A sequence of drawn panels, and everything needed to actually read one.

  Three things carry the reading rather than the image alone. Each panel is
  numbered and anchored, so a panel can be linked to and argued about. Each
  panel's lettering is published as a transcript, because a comic bakes its
  words into a picture and would otherwise be closed to a screen reader, to
  translation, and to search. And each panel can be opened full screen, because
  hand-lettered dialogue at phone width is small.

  The transcripts sit in `details` elements, so they work with no JavaScript at
  all. The full-screen viewer cannot, so its controls stay hidden until the
  script that gives them meaning has run.
-->
<div
  class="panel-sequence"
  data-panel-sequence
  data-panel-unit={unit}
  data-tone={tone}
>
  {
    hasTranscripts && (
      <div class="panel-sequence__controls">
        <button
          class="panel-sequence__toggle"
          type="button"
          data-transcripts-toggle
          aria-controls={id}
          aria-pressed="false"
          hidden
        >
          Show every transcript
        </button>
      </div>
    )
  }

  <ol class:list={["panel-sequence__list", `is-${layout}`]} id={id}>
    {
      panels.map((panel, index) => (
        <li
          class="panel"
          id={`${id}-${index + 1}`}
          data-panel
          data-panel-width={panel.width}
          data-panel-height={panel.height}
        >
          <figure class="panel__figure">
            <div class="panel__frame">
              <img
                class="panel__image"
                src={panel.src}
                alt={panel.alt}
                width={panel.width}
                height={panel.height}
                loading={index < eagerCount ? "eager" : "lazy"}
                decoding="async"
              />
              <button class="panel__open" type="button" data-panel-open hidden>
                <span class="sr-only">
                  Open {unit.toLowerCase()} {index + 1} full screen
                </span>
                <span class="panel__zoom" aria-hidden="true">
                  &#x2922;
                </span>
              </button>
              <p class="panel__number" aria-hidden="true">
                {index + 1}
              </p>
            </div>

            <figcaption class="panel__caption">
              <a class="panel__count" href={`#${id}-${index + 1}`}>
                {unit} {index + 1} of {total}
              </a>
              {panel.transcript && (
                <details class="panel__transcript">
                  <summary>Transcript</summary>
                  <div data-panel-transcript-source>
                    <PanelTranscript transcript={panel.transcript} />
                  </div>
                </details>
              )}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ol>

  <dialog class="panel-viewer" data-panel-dialog aria-label={`${label} viewer`}>
    <div class="panel-viewer__bar">
      <p class="panel-viewer__counter" data-panel-counter aria-live="polite">
      </p>
      <button class="panel-viewer__close" type="button" data-panel-close>
        Close
      </button>
    </div>

    <div class="panel-viewer__stage">
      <img class="panel-viewer__image" data-panel-image alt="" />
      <button
        class="panel-viewer__step panel-viewer__step--previous"
        type="button"
        data-panel-previous
        aria-label={`Previous ${unit.toLowerCase()}`}
      >
        <span aria-hidden="true">&#8592;</span>
      </button>
      <button
        class="panel-viewer__step panel-viewer__step--next"
        type="button"
        data-panel-next
        aria-label={`Next ${unit.toLowerCase()}`}
      >
        <span aria-hidden="true">&#8594;</span>
      </button>
    </div>

    <div class="panel-viewer__transcript" data-panel-transcript></div>
  </dialog>
</div>

<style>
  .panel-sequence {
    --panel-ink: var(--color-ambedkar-950);
    /*
     * 78% of the brand blue over the page surface clears 4.5:1, which the
     * lighter tint this replaces did not. Panel captions and transcripts are
     * body text at 14 and 15 pixels, so they need the full ratio.
     */
    --panel-muted: color-mix(
      in srgb,
      var(--color-ambedkar-900) 78%,
      transparent
    );
    --panel-line: color-mix(
      in srgb,
      var(--color-ambedkar-900) 12%,
      transparent
    );
    --panel-chip: #fff;
  }

  .panel-sequence[data-tone="dark"] {
    --panel-ink: #fff;
    --panel-muted: rgb(255 255 255 / 68%);
    --panel-line: rgb(255 255 255 / 16%);
    --panel-chip: rgb(255 255 255 / 10%);
  }

  .panel-sequence__controls {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
  }

  .panel-sequence__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    border: 1px solid var(--panel-line);
    border-radius: 999px;
    background: var(--panel-chip);
    padding: 0.5rem 1.125rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--panel-ink);
    transition: border-color 200ms var(--ease-out-soft);
  }

  /*
   * The control is served hidden and revealed by the script that gives it
   * meaning. An author `display` beats the user agent's `[hidden]` rule, so
   * hiding it has to be restated here or it would show and do nothing.
   */
  .panel-sequence__toggle[hidden],
  .panel__open[hidden] {
    display: none;
  }

  .panel-sequence__toggle:hover {
    border-color: var(--color-accent-600);
  }

  .panel-sequence__list {
    display: grid;
    gap: 2.5rem;
  }

  .panel-sequence__list.is-strip {
    margin-inline: auto;
    max-width: 46rem;
  }

  @media (width >= 48rem) {
    .panel-sequence__list.is-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .panel {
    scroll-margin-top: 6rem;
  }

  .panel__figure {
    display: grid;
    gap: 0.875rem;
  }

  /*
   * The artwork is drawn on light grounds, so every panel sits on white however
   * dark the page around it is. The frame is the page's own radius, clipped, so
   * a square drawing takes the site's corners without being cropped.
   */
  .panel__frame {
    position: relative;
    overflow: clip;
    border: 1px solid var(--panel-line);
    border-radius: 1.25rem;
    background: #fff;
    box-shadow: var(--shadow-card);
  }

  .panel__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .panel__open {
    position: absolute;
    inset: 0;
    cursor: zoom-in;
  }

  /*
   * The frame clips its overflow so a square drawing takes the rounded corners,
   * which would also discard the site's focus ring: the button's box is exactly
   * the frame's, so a ring drawn outside it lands beyond the clip edge. Drawing
   * it inside instead would put it on top of the artwork, where the palette's
   * contrast guarantee does not hold — the accent all but vanishes on a light
   * drawing. An element's own outline is not clipped by its own overflow, so
   * the ring is moved onto the frame and lands back on the page surface.
   */
  .panel__open:focus-visible {
    outline: none;
  }

  .panel__frame:has(.panel__open:focus-visible) {
    outline: 3px solid var(--color-accent-600);
    outline-offset: 3px;
  }

  .panel-sequence[data-tone="dark"]
    .panel__frame:has(.panel__open:focus-visible) {
    outline-color: var(--color-accent-300);
  }

  .panel__zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    height: 2.5rem;
    width: 2.5rem;
    place-items: center;
    border-radius: 999px;
    background: var(--color-ambedkar-950);
    font-size: 1.125rem;
    color: #fff;
    opacity: 0;
    transition: opacity 200ms var(--ease-out-soft);
  }

  .panel__open:hover .panel__zoom,
  .panel__open:focus-visible .panel__zoom {
    opacity: 1;
  }

  /* Coarse pointers get no hover, so the affordance is simply always there. */
  @media (pointer: coarse) {
    .panel__zoom {
      opacity: 0.85;
    }
  }

  .panel__number {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    border-radius: 999px;
    background: rgb(16 35 62 / 78%);
    padding: 0.1875rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .panel__caption {
    display: grid;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--panel-muted);
  }

  .panel__count {
    justify-self: start;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .panel__count:hover {
    color: var(--panel-ink);
  }

  .panel__transcript {
    border: 1px solid var(--panel-line);
    border-radius: 1rem;
    background: var(--panel-chip);
    padding: 0.75rem 1rem;
    color: var(--panel-muted);
  }

  .panel__transcript summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--panel-ink);
  }

  .panel__transcript summary::marker {
    color: var(--color-accent-600);
  }

  .panel-sequence[data-tone="dark"] .panel__transcript summary::marker {
    color: var(--color-accent-300);
  }

  .panel__transcript[open] summary {
    margin-bottom: 0.75rem;
  }

  .panel__transcript :global(.panel-transcript__speaker) {
    color: var(--color-accent-700);
  }

  .panel-sequence[data-tone="dark"]
    .panel__transcript
    :global(.panel-transcript__speaker) {
    color: var(--color-accent-300);
  }

  /* --- Full-screen viewer ------------------------------------------------ */

  .panel-viewer {
    margin: 0;
    max-width: none;
    max-height: none;
    height: 100dvh;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 0;
    color: #fff;
    overflow: hidden;
  }

  .panel-viewer:not([open]) {
    display: none;
  }

  .panel-viewer::backdrop {
    background: rgb(10 23 43 / 94%);
  }

  .panel-viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .panel-viewer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
  }

  .panel-viewer__counter {
    font-size: 0.8125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-300);
  }

  .panel-viewer__close {
    min-height: 2.75rem;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 999px;
    padding: 0.5rem 1.25rem;
    font-weight: 700;
    transition: background-color 200ms var(--ease-out-soft);
  }

  .panel-viewer__close:hover {
    background: rgb(255 255 255 / 14%);
  }

  /*
   * The paging controls float over the edges of the stage rather than sitting
   * beside it. A column each side would take 7rem from a 320px screen, leaving
   * the artwork smaller full screen than it was in the page, which defeats the
   * point of opening it.
   */
  .panel-viewer__stage {
    position: relative;
    display: grid;
    place-items: stretch;
    min-height: 0;
    padding-inline: 0.5rem;
  }

  /*
   * The image box fills the stage and the artwork is letterboxed inside it.
   * Sizing it with `max-height: 100%` instead does not work: the stage's height
   * comes from stretching into a `1fr` row rather than from a specified height,
   * so the percentage never resolves and a square panel is laid out at the full
   * stage width — taller than the viewport on any landscape screen, and clipped.
   */
  .panel-viewer__image {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  .panel-viewer__step {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    height: 3rem;
    width: 3rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: 999px;
    background: rgb(10 23 43 / 72%);
    font-size: 1.25rem;
    transition:
      background-color 200ms var(--ease-out-soft),
      opacity 200ms var(--ease-out-soft);
  }

  .panel-viewer__step--previous {
    left: 0.25rem;
  }

  .panel-viewer__step--next {
    right: 0.25rem;
  }

  .panel-viewer__step:hover:not(:disabled) {
    background: var(--color-ambedkar-800);
  }

  .panel-viewer__step:disabled {
    opacity: 0.25;
  }

  /*
   * The transcript travels with the panel into the viewer, so the words are
   * still available at the size the drawing is being read at.
   */
  .panel-viewer__transcript {
    max-height: 32vh;
    overflow-y: auto;
    padding: 1rem 1.25rem 1.5rem;
    color: rgb(255 255 255 / 78%);
  }

  .panel-viewer__transcript:empty {
    display: none;
  }

  .panel-viewer__transcript :global(.panel-transcript__speaker) {
    color: var(--color-accent-300);
  }

  @media (width >= 48rem) {
    .panel-viewer__bar {
      padding: 1rem 1.5rem;
    }

    .panel-viewer__stage {
      padding-inline: 4.5rem;
    }

    .panel-viewer__step--previous {
      left: 1rem;
    }

    .panel-viewer__step--next {
      right: 1rem;
    }

    .panel-viewer__transcript {
      margin-inline: auto;
      max-width: 52rem;
    }
  }
</style>

<script>
  /*
   * Turns a published sequence of panels into a reader: a full-screen viewer
   * with keyboard paging, and one control that opens every transcript at once.
   *
   * Everything this adds is additive. The panels, their numbers, their anchors
   * and their transcripts are all in the served HTML, so a reader without
   * JavaScript loses the viewer and keeps the comic.
   */
  const sequences = document.querySelectorAll<HTMLElement>(
    "[data-panel-sequence]",
  );

  for (const sequence of sequences) {
    const items = [...sequence.querySelectorAll<HTMLElement>("[data-panel]")];
    const dialog = sequence.querySelector<HTMLDialogElement>(
      "[data-panel-dialog]",
    );

    const toggle = sequence.querySelector<HTMLButtonElement>(
      "[data-transcripts-toggle]",
    );

    if (toggle) {
      const panelTranscripts = [
        ...sequence.querySelectorAll<HTMLDetailsElement>(".panel__transcript"),
      ];

      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-pressed") === "true";

        for (const transcript of panelTranscripts) transcript.open = !open;
        toggle.setAttribute("aria-pressed", String(!open));
        toggle.textContent = open
          ? "Show every transcript"
          : "Hide every transcript";
      });
    }

    if (!dialog || items.length === 0) continue;

    const image = dialog.querySelector<HTMLImageElement>("[data-panel-image]");
    const counter = dialog.querySelector<HTMLElement>("[data-panel-counter]");
    const transcript = dialog.querySelector<HTMLElement>(
      "[data-panel-transcript]",
    );
    const previous = dialog.querySelector<HTMLButtonElement>(
      "[data-panel-previous]",
    );
    const next = dialog.querySelector<HTMLButtonElement>("[data-panel-next]");
    const close = dialog.querySelector<HTMLButtonElement>("[data-panel-close]");
    const stage = dialog.querySelector<HTMLElement>(".panel-viewer__stage");

    if (
      !image ||
      !counter ||
      !transcript ||
      !previous ||
      !next ||
      !close ||
      !stage
    ) {
      continue;
    }

    const unit = sequence.dataset.panelUnit ?? "Panel";
    let current = 0;
    let openedAt = 0;

    const show = (index: number) => {
      current = Math.min(Math.max(index, 0), items.length - 1);

      const item = items[current];
      const source = item.querySelector("img");
      if (!source) return;

      image.src = source.src;
      image.alt = source.alt;
      image.width = Number(item.dataset.panelWidth);
      image.height = Number(item.dataset.panelHeight);
      counter.textContent = `${unit} ${current + 1} of ${items.length}`;

      const lines = item.querySelector("[data-panel-transcript-source] ol");
      transcript.replaceChildren(...(lines ? [lines.cloneNode(true)] : []));

      const focused = document.activeElement;

      previous.disabled = current === 0;
      next.disabled = current === items.length - 1;

      // Disabling a button blurs it synchronously, dropping focus onto the
      // body. The arrow key handler is bound to the dialog, so paging by
      // keyboard would silently stop working at either end of the sequence.
      // The focused element is therefore read before the assignments above.
      if (focused === previous && previous.disabled) {
        (next.disabled ? close : next).focus();
      } else if (focused === next && next.disabled) {
        (previous.disabled ? close : previous).focus();
      }
    };

    for (const [index, item] of items.entries()) {
      const opener = item.querySelector<HTMLButtonElement>("[data-panel-open]");
      if (!opener) continue;

      opener.hidden = false;
      opener.addEventListener("click", () => {
        openedAt = index;
        show(index);
        dialog.showModal();
      });
    }

    previous.addEventListener("click", () => show(current - 1));
    next.addEventListener("click", () => show(current + 1));
    close.addEventListener("click", () => dialog.close());

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(current - 1);
      }

      if (event.key === "ArrowRight") {
        event.preventDefault();
        show(current + 1);
      }
    });

    // Clicking away from the artwork closes, which is what a lightbox is
    // expected to do. The image box fills the stage, so "away" is either the
    // stage's own gutter or the letterbox `object-fit: contain` leaves inside
    // that box, and the second of those has to be measured.
    stage.addEventListener("click", (event) => {
      if (event.target === stage) {
        dialog.close();
        return;
      }

      if (event.target !== image) return;

      const box = image.getBoundingClientRect();
      const scale = Math.min(
        box.width / image.naturalWidth,
        box.height / image.naturalHeight,
      );
      const drawnWidth = image.naturalWidth * scale;
      const drawnHeight = image.naturalHeight * scale;
      const x = event.clientX - box.left - (box.width - drawnWidth) / 2;
      const y = event.clientY - box.top - (box.height - drawnHeight) / 2;

      if (x < 0 || y < 0 || x > drawnWidth || y > drawnHeight) dialog.close();
    });

    // Someone who paged through the viewer comes back to the panel they
    // finished on rather than the one they opened, so closing does not lose
    // their place. Closing without paging leaves the page exactly as it was.
    dialog.addEventListener("close", () => {
      const item = items[current];
      const opener = item.querySelector<HTMLButtonElement>("[data-panel-open]");

      opener?.focus({ preventScroll: true });

      if (current !== openedAt) {
        item.scrollIntoView({ block: "center", behavior: "auto" });
      }
    });
  }
</script>
