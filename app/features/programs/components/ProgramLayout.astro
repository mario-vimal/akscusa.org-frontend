---
import BackLink from "~/components/ui/BackLink.astro";
import Container from "~/components/ui/Container.astro";
import PageMasthead from "~/components/ui/PageMasthead.astro";
import Poster from "~/components/ui/Poster.astro";
import ProseContent from "~/features/editorial/components/ProseContent.astro";
import type {
  Badge,
  Detail,
  ProgramPoster,
} from "~/features/editorial/presenters";
import { loadTermLabels } from "~/features/editorial/queries/taxonomy";

interface LinkItem {
  label: string;
  url: string;
}

interface Props {
  title: string;
  summary: string;
  badge: Badge;
  details: readonly Detail[];
  posters?: readonly ProgramPoster[];
  links?: readonly LinkItem[];
  topics?: readonly string[];
  sourceUrl?: string;
}

const {
  title,
  summary,
  badge,
  details,
  posters = [],
  links = [],
  topics = [],
  sourceUrl,
} = Astro.props;

const hasPosters = posters.length > 0;
const hasMultiplePosters = posters.length > 1;
const badgeClasses =
  badge.tone === "muted"
    ? "border-white/40 text-white/85"
    : "border-accent-400/70 text-accent-300";

const topicLabel = await loadTermLabels("topics");
---

<article>
  <PageMasthead
    eyebrow="Programs"
    title={title}
    description={summary}
    size="large"
  >
    <BackLink slot="above" href="/programs/" tone="light">
      Back to Programs
    </BackLink>

    <p class="mt-8">
      <span
        class:list={[
          "inline-block rounded-sm border px-1.5 py-0.5 font-display text-[0.625rem] font-semibold tracking-[0.1em] uppercase",
          badgeClasses,
        ]}
      >
        {badge.label}
      </span>
    </p>
  </PageMasthead>

  <Container class="pt-10 pb-20 sm:pt-14 sm:pb-28">
    <div
      class:list={[
        "items-start gap-10 lg:gap-14",
        hasPosters && "grid lg:grid-cols-[minmax(0,1fr)_minmax(20rem,26rem)]",
      ]}
    >
      {
        hasPosters && (
          <aside
            class:list={[
              "grid auto-rows-max content-start items-start gap-5 lg:order-2 lg:grid-cols-1",
              hasMultiplePosters && "sm:grid-cols-2",
            ]}
            aria-label="Original program posters"
          >
            {posters.map((poster, index) => (
              <Poster
                src={poster.src}
                alt={poster.alt}
                caption={poster.caption}
                loading={index === 0 ? "eager" : "lazy"}
              />
            ))}
          </aside>
        )
      }

      <div class:list={["min-w-0", hasPosters && "mt-10 lg:order-1 lg:mt-0"]}>
        <dl class="card gap-x-8 gap-y-5 p-6 sm:grid sm:grid-cols-2 sm:p-8">
          {
            details.map((detail) => (
              <div>
                <dt class="label text-ambedkar-700">{detail.term}</dt>
                <dd class="mt-1 leading-7 text-ambedkar-900/80">
                  {detail.href ? (
                    <a
                      class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                      href={detail.href}
                    >
                      {detail.description}
                    </a>
                  ) : (
                    detail.description
                  )}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10 sm:mt-12">
          <ProseContent>
            <slot />
          </ProseContent>
        </div>

        {
          links.length > 0 && (
            <section class="card mt-12 p-6 sm:p-8">
              <h2 class="font-display text-xl font-semibold tracking-title text-ambedkar-950">
                Resources
              </h2>
              <ul class="mt-4 space-y-3">
                {links.map((item) => (
                  <li>
                    <a
                      class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                      href={item.url}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          topics.length > 0 && (
            <section class="mt-12">
              <h2 class="eyebrow">Topics</h2>
              <ul class="mt-4 flex flex-wrap gap-2">
                {topics.map((topic) => (
                  <li class="tag px-3 py-1.5 text-sm">{topicLabel(topic)}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          sourceUrl && (
            <p class="mt-10 text-sm wrap-break-word text-ambedkar-900/70">
              Originally published at{" "}
              <a
                class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                href={sourceUrl}
              >
                {sourceUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")}
              </a>
              .
            </p>
          )
        }
      </div>
    </div>
  </Container>
</article>
