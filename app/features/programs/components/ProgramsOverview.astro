---
import phuleTeachingSculpture from "~/assets/shared/leaders/phule-teaching-sculpture-cc-by-sa-4.jpg";
import EditorialIndex from "~/features/editorial/components/EditorialIndex.astro";
import EntryLead from "~/features/editorial/components/EntryLead.astro";
import { editorialSections, entryHref } from "~/features/editorial/sections";
import {
  loadEditorialEntries,
  splitLeadEntry,
} from "~/features/editorial/queries/entries";
import {
  programBadge,
  programCover,
  programEyebrow,
  programMeta,
} from "~/features/editorial/presenters";
import ProgramCard from "./ProgramCard.astro";

const section = editorialSections.programs;
const programs = await loadEditorialEntries("programs");

// The newest program leads the index and the rest follow as cards, the way the
// interventions, blog, and press release indexes already read. Seventeen equal
// tiles said nothing about which of them a reader had not already seen.
const { lead, rest } = splitLeadEntry(programs);

// Measured up front, so the index makes one pass over the poster files rather
// than one per card.
const leadCover = lead ? await programCover(lead) : undefined;
const covers = await Promise.all(rest.map(programCover));
---

<EditorialIndex
  eyebrow={section.eyebrow}
  title={section.title}
  description={section.description}
  count={`${programs.length} ${programs.length === 1 ? "program" : "programs"}`}
  empty={section.empty}
  isEmpty={programs.length === 0}
  itemCount={rest.length}
  listLabel="Earlier programs"
  backgroundImage={phuleTeachingSculpture}
  backgroundLabel="Jyotirao and Savitribai Phule, sculpted at Phulewada in Pune"
  backgroundCredit={{
    creator: "Wander-earth / Wikimedia Commons",
    sourceHref:
      "https://commons.wikimedia.org/wiki/File:Jotirao_Phule_Savitribai_Phule_Phulewada_Pune.jpg",
    license: "CC BY-SA 4.0",
    licenseHref: "https://creativecommons.org/licenses/by-sa/4.0/",
  }}
>
  {
    lead && (
      <EntryLead
        slot="lead"
        href={entryHref("programs", lead.id)}
        title={lead.data.title}
        summary={lead.data.summary}
        eyebrow={programEyebrow(lead)}
        badge={programBadge(lead)}
        label={
          lead.data.status === "scheduled" ? "Next program" : "Latest program"
        }
        meta={programMeta(lead)}
        topics={lead.data.topics}
        poster={leadCover}
      />
    )
  }

  {
    rest.map((program, index) => (
      <li>
        <ProgramCard
          href={entryHref("programs", program.id)}
          title={program.data.title}
          summary={program.data.summary}
          eyebrow={programEyebrow(program)}
          badge={programBadge(program)}
          meta={programMeta(program)}
          topics={program.data.topics}
          poster={covers[index]}
        />
      </li>
    ))
  }
</EditorialIndex>
