---
import phuleTeachingSculpture from "~/assets/shared/leaders/phule-teaching-sculpture-cc-by-sa-4.jpg";
import EditorialIndex from "~/features/editorial/components/EditorialIndex.astro";
import { editorialSections, entryHref } from "~/features/editorial/sections";
import { loadEditorialEntries } from "~/features/editorial/queries/entries";
import {
  programBadge,
  programEyebrow,
  programMeta,
} from "~/features/editorial/presenters";
import ProgramCard from "./ProgramCard.astro";

const section = editorialSections.programs;
const programs = await loadEditorialEntries("programs");
---

<EditorialIndex
  eyebrow={section.eyebrow}
  title={section.title}
  description={section.description}
  count={`${programs.length} ${programs.length === 1 ? "program" : "programs"}`}
  empty={section.empty}
  isEmpty={programs.length === 0}
  backgroundImage={phuleTeachingSculpture}
  backgroundLabel="Jyotirao and Savitribai Phule, sculpted at Phulewada in Pune"
  backgroundCredit={{
    creator: "Wander-earth / Wikimedia Commons",
    sourceHref:
      "https://commons.wikimedia.org/wiki/File:Jotirao_Phule_Savitribai_Phule_Phulewada_Pune.jpg",
    license: "CC BY-SA 4.0",
    licenseHref: "https://creativecommons.org/licenses/by-sa/4.0/",
  }}
>
  {
    programs.map((program) => (
      <li>
        <ProgramCard
          href={entryHref("programs", program.id)}
          title={program.data.title}
          summary={program.data.summary}
          eyebrow={programEyebrow(program)}
          badge={programBadge(program)}
          meta={programMeta(program)}
          topics={program.data.topics}
          poster={program.data.posters[0]}
        />
      </li>
    ))
  }
</EditorialIndex>
