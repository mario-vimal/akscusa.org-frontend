---
import type { EditorialTopic } from "~/features/editorial/taxonomy";
import type { Badge, ProgramPoster } from "~/features/editorial/presenters";
import { topicLabel } from "~/features/editorial/taxonomy";

interface Props {
  href: string;
  title: string;
  summary: string;
  eyebrow: string;
  badge: Badge;
  meta?: readonly string[];
  topics?: readonly EditorialTopic[];
  poster?: ProgramPoster;
}

const {
  href,
  title,
  summary,
  eyebrow,
  badge,
  meta = [],
  topics = [],
  poster,
} = Astro.props;

const badgeClasses =
  badge.tone === "muted"
    ? "border-rule-strong text-ambedkar-900/70"
    : "border-accent-600 text-accent-700";
---

<article class="card group overflow-hidden">
  {
    poster ? (
      /*
        The poster is taken out of flow. An absolutely positioned box
        contributes nothing to an ancestor's intrinsic size, so a 1800px
        artwork can never report its intrinsic width up through the card into
        the grid track, whichever way an engine resolves a percentage-sized
        replaced element while measuring.

        The figure keeps the 4:3 well and `object-contain` centres the artwork
        inside it, which is what the flex centring did before. The padding is
        on the image because `object-contain` fits the artwork to the content
        box, so it insets the artwork rather than the well.
      */
      <div class="relative aspect-4/3 bg-white">
        <img
          class="absolute inset-0 size-full object-contain p-3 sm:p-4"
          src={poster.src}
          alt={poster.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      <div class="on-dark relative isolate flex aspect-4/3 items-end overflow-hidden bg-ambedkar-950 p-6 text-white">
        <div
          class="absolute inset-0 -z-10 bg-linear-to-br from-ambedkar-800 to-ambedkar-1000"
          aria-hidden="true"
        />
        <p class="font-display text-4xl leading-none font-bold tracking-display">
          AKSC
        </p>
      </div>
    )
  }

  <div class="flex flex-1 p-6 sm:p-8">
    <div class="flex min-w-0 flex-1 flex-col">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <p class="label text-ambedkar-700">
          {eyebrow}
        </p>
        <span
          class:list={[
            "rounded-sm border px-1.5 py-0.5 font-display text-[0.625rem] font-semibold tracking-[0.1em] uppercase",
            badgeClasses,
          ]}
        >
          {badge.label}
        </span>
      </div>

      <h2
        class="mt-3 font-display text-[1.375rem] leading-[1.14] font-semibold tracking-title text-balance text-ambedkar-950 sm:text-2xl"
      >
        <a
          class="after:absolute after:inset-0 focus-visible:outline-none"
          href={href}
        >
          {title}
        </a>
      </h2>

      <p class="mt-3 leading-7 text-ambedkar-900/75">{summary}</p>

      {
        meta.length > 0 && (
          <ul class="mt-4 space-y-1 text-sm text-ambedkar-900/70">
            {meta.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }

      <div class="mt-auto pt-6">
        {
          topics.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {topics.map((topic) => (
                <li class="tag">{topicLabel(topic)}</li>
              ))}
            </ul>
          )
        }
        <p
          class="mt-5 flex items-center gap-2 font-display text-xs font-semibold tracking-[0.12em] text-ambedkar-700 uppercase transition-colors group-hover:text-ambedkar-950"
          aria-hidden="true"
        >
          View program
          <span
            class="inline-block transition-transform duration-300 group-hover:translate-x-1"
            >&rarr;</span
          >
        </p>
      </div>
    </div>
  </div>
</article>
