---
import type {
  Badge,
  SizedProgramPoster,
} from "~/features/editorial/presenters";
import { loadTermLabels } from "~/features/editorial/queries/taxonomy";

interface Props {
  href: string;
  title: string;
  summary: string;
  eyebrow: string;
  badge: Badge;
  meta?: readonly string[];
  topics?: readonly string[];
  poster?: SizedProgramPoster;
}

const {
  href,
  title,
  summary,
  eyebrow,
  badge,
  meta = [],
  topics = [],
  poster,
} = Astro.props;

const badgeClasses =
  badge.tone === "muted"
    ? "border-rule-strong text-ambedkar-900/70"
    : "border-accent-600 text-accent-700";

const topicLabel = await loadTermLabels("topics");
---

<article class="card group">
  {
    poster ? (
      /*
        The flyer is printed at its own proportions rather than fitted into a
        well. A fixed well can only suit one shape, and these arrive both
        upright and landscape: the 4:3 well cut an upright poster down to about
        half the card's width and set it between two bars of white, which is
        how the section's only real colour came to read as a stamp.

        Sized from the committed file, so a column of them does not reflow as
        each one loads, and so a row of cards is allowed to come out uneven.
        That unevenness is the point: it is what separates an index of real
        posters from a grid of identical tiles.
      */
      <img
        class="w-full bg-white"
        src={poster.src}
        alt={poster.alt}
        width={poster.width}
        height={poster.height}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="on-dark relative isolate flex aspect-16/9 items-end overflow-hidden bg-ambedkar-950 p-6 text-white">
        <div
          class="absolute inset-0 -z-10 bg-linear-to-br from-ambedkar-800 to-ambedkar-1000"
          aria-hidden="true"
        />
        <p class="font-display text-4xl leading-none font-bold tracking-display">
          AKSC
        </p>
      </div>
    )
  }

  <div class="flex flex-1 p-6 sm:p-8">
    <div class="flex min-w-0 flex-1 flex-col">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <p class="label text-accent-700">
          {eyebrow}
        </p>
        <span
          class:list={[
            "rounded-sm border px-1.5 py-0.5 font-display text-[0.625rem] font-semibold tracking-[0.1em] uppercase",
            badgeClasses,
          ]}
        >
          {badge.label}
        </span>
      </div>

      <h2
        class="mt-3 font-display text-[1.375rem] leading-[1.14] font-semibold tracking-title text-balance text-ambedkar-950 sm:text-2xl"
      >
        <a
          class="after:absolute after:inset-0 focus-visible:outline-none"
          href={href}
        >
          {title}
        </a>
      </h2>

      <p class="mt-3 leading-7 text-ambedkar-900/75">{summary}</p>

      {
        meta.length > 0 && (
          <ul class="mt-4 space-y-1 text-sm text-ambedkar-900/70">
            {meta.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }

      {
        /* See EntryCard: the repeated "View program →" is gone from every index. */
      }
      {
        topics.length > 0 && (
          <ul class="mt-auto flex flex-wrap gap-2 pt-6">
            {topics.map((topic) => (
              <li class="tag">{topicLabel(topic)}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>
