---
import Container from "../../../components/ui/Container.astro";
import ResponsiveImage from "../../../components/ui/ResponsiveImage.astro";
import { formatPacificDate } from "../../editorial/entries";
import { topicLabel } from "../../editorial/taxonomy";
import { COVER_ALT, COVER_WIDTHS, coverForIsbn } from "../covers";
import { openLibraryUrl } from "../isbn";
import type { BookWithReadings } from "../queries/books";

interface Props {
  entry: BookWithReadings;
}

const { entry } = Astro.props;
const { book, readings } = entry;
const { data } = book;

const authors = data.authors.join(", ");
const cover = coverForIsbn(data.isbn);

const facts = [
  { term: "Author", description: authors },
  data.publisher ? { term: "Publisher", description: data.publisher } : null,
  data.publishedYear
    ? { term: "Edition", description: String(data.publishedYear) }
    : null,
  data.firstPublishedYear
    ? { term: "First published", description: String(data.firstPublishedYear) }
    : null,
].filter((fact) => fact !== null);
---

<article class="relative isolate overflow-x-clip">
  <div
    class="absolute inset-x-0 top-0 -z-10 h-[24rem] bg-[radial-gradient(circle_at_top_right,rgba(127,224,210,0.18),transparent_50%),radial-gradient(circle_at_top_left,rgba(31,98,170,0.16),transparent_45%)]"
    aria-hidden="true"
  >
  </div>

  <Container class="pt-10 pb-20 sm:pt-14 sm:pb-28">
    <a
      class="inline-flex items-center gap-2 rounded-full border border-ambedkar-900/15 bg-white px-4 py-2 text-sm font-semibold text-ambedkar-800 transition hover:border-ambedkar-900/40 hover:text-ambedkar-950"
      href="/books/"
    >
      <span aria-hidden="true">&larr;</span>
      Back to Books
    </a>

    <div class="mt-8 gap-10 lg:flex lg:items-start">
      {
        cover && (
          <figure class="lg:order-last lg:shrink-0">
            <ResponsiveImage
              class="w-40 rounded-2xl border border-ambedkar-900/10 shadow-soft sm:w-48 lg:w-56"
              src={cover}
              alt={COVER_ALT}
              sizes="(min-width: 1024px) 14rem, (min-width: 640px) 12rem, 10rem"
              widths={COVER_WIDTHS}
              loading="eager"
            />
            <figcaption class="mt-2 max-w-56 text-xs text-ambedkar-900/55">
              Cover art via{" "}
              <a
                class="underline underline-offset-2 hover:text-ambedkar-900"
                href={openLibraryUrl(data.isbn)}
              >
                Open Library
              </a>
              .
            </figcaption>
          </figure>
        )
      }

      <header class="mt-6 max-w-3xl lg:mt-0">
        <p
          class="text-sm font-bold tracking-[0.18em] text-ambedkar-700 uppercase"
        >
          Book
        </p>
        <h1
          class="mt-4 text-3xl leading-[1.1] font-semibold tracking-[-0.04em] text-balance text-ambedkar-950 sm:text-5xl"
        >
          {data.title}
        </h1>
        {
          data.subtitle && (
            <p class="mt-3 text-xl text-ambedkar-900/70">{data.subtitle}</p>
          )
        }
        <p class="mt-4 text-lg font-semibold text-ambedkar-800">By {authors}</p>
        <p class="mt-6 text-lg leading-8 text-ambedkar-900/75">
          {data.summary}
        </p>
      </header>
    </div>

    <dl
      class="mt-10 grid max-w-3xl gap-x-8 gap-y-4 rounded-3xl border border-ambedkar-900/10 bg-white p-6 sm:grid-cols-2 sm:p-8"
    >
      {
        facts.map((fact) => (
          <div>
            <dt class="text-xs font-bold tracking-[0.14em] text-ambedkar-700 uppercase">
              {fact.term}
            </dt>
            <dd class="mt-1 leading-7 text-ambedkar-900/80">
              {fact.description}
            </dd>
          </div>
        ))
      }
      <div>
        <dt
          class="text-xs font-bold tracking-[0.14em] text-ambedkar-700 uppercase"
        >
          ISBN
        </dt>
        <dd class="mt-1 leading-7 break-words text-ambedkar-900/80">
          <a
            class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
            href={openLibraryUrl(data.isbn)}
          >
            {data.isbn}
          </a>
          <span class="mt-1 block text-sm text-ambedkar-900/55">
            Look this edition up on Open Library.
          </span>
        </dd>
      </div>
    </dl>

    <section class="mt-12 max-w-3xl">
      <h2 class="text-2xl font-semibold tracking-tight text-ambedkar-950">
        {
          readings.length === 0
            ? "Not yet read"
            : readings.length === 1
              ? "Read at one session"
              : `Read across ${readings.length} sessions`
        }
      </h2>
      {
        readings.length === 0 ? (
          <p class="mt-4 leading-7 text-ambedkar-900/75">
            The circle has not scheduled a session on this book yet.
          </p>
        ) : (
          <ul class="mt-6 space-y-4">
            {readings.map((reading) => (
              <li class="rounded-3xl border border-ambedkar-900/10 bg-white p-6">
                <p class="text-sm font-semibold text-ambedkar-700">
                  <time datetime={reading.data.date.toISOString()}>
                    {formatPacificDate(reading.data.date)}
                  </time>
                </p>
                <h3 class="mt-2 text-lg font-semibold tracking-tight text-ambedkar-950">
                  <a
                    class="underline decoration-ambedkar-900/25 underline-offset-4 hover:decoration-ambedkar-900"
                    href={`/book-readings/${reading.id}/`}
                  >
                    {reading.data.title}
                  </a>
                </h3>
                <p class="mt-2 leading-7 text-ambedkar-900/75">
                  {reading.data.summary}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      data.resources.length > 0 && (
        <section class="mt-12 max-w-3xl rounded-3xl border border-ambedkar-900/10 bg-white p-6 sm:p-8">
          <h2 class="text-lg font-semibold tracking-tight text-ambedkar-950">
            Where to read it
          </h2>
          <ul class="mt-4 space-y-3">
            {data.resources.map((resource) => (
              <li>
                <a
                  class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                  href={resource.url}
                >
                  {resource.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.topics.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="text-xs font-bold tracking-[0.14em] text-ambedkar-700 uppercase">
            Topics
          </h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {data.topics.map((topic) => (
              <li class="rounded-full bg-ambedkar-50 px-3 py-1.5 text-sm font-semibold text-ambedkar-800">
                {topicLabel(topic)}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </Container>
</article>
