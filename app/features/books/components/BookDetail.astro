---
import BackLink from "../../../components/ui/BackLink.astro";
import Container from "../../../components/ui/Container.astro";
import PageMasthead from "../../../components/ui/PageMasthead.astro";
import ResponsiveImage from "../../../components/ui/ResponsiveImage.astro";
import { formatPacificDate } from "../../editorial/entries";
import { topicLabel } from "../../editorial/taxonomy";
import { COVER_ALT, COVER_WIDTHS, coverForIsbn } from "../covers";
import { openLibraryUrl } from "../isbn";
import type { BookWithReadings } from "../queries/books";

interface Props {
  entry: BookWithReadings;
}

const { entry } = Astro.props;
const { book, readings } = entry;
const { data } = book;

const authors = data.authors.join(", ");
const cover = coverForIsbn(data.isbn);

const facts = [
  { term: "Author", description: authors },
  data.publisher ? { term: "Publisher", description: data.publisher } : null,
  data.publishedYear
    ? { term: "Edition", description: String(data.publishedYear) }
    : null,
  data.firstPublishedYear
    ? { term: "First published", description: String(data.firstPublishedYear) }
    : null,
].filter((fact) => fact !== null);
---

<article>
  <PageMasthead
    eyebrow="Book"
    title={data.title}
    description={data.summary}
    size="large"
  >
    <BackLink slot="above" href="/books/" tone="light">Back to Books</BackLink>

    {
      data.subtitle && (
        <p class="mt-5 max-w-2xl font-display text-xl text-white/70 italic">
          {data.subtitle}
        </p>
      )
    }
    <p class="mt-5 text-lg font-semibold text-accent-300">By {authors}</p>
  </PageMasthead>

  <Container class="pt-12 pb-20 sm:pt-14 sm:pb-28">
    <div class="gap-10 lg:flex lg:items-start">
      <div class="min-w-0 lg:flex-1">
        <dl
          class="card max-w-3xl gap-x-8 gap-y-5 p-6 sm:grid sm:grid-cols-2 sm:p-8"
        >
          {
            facts.map((fact) => (
              <div>
                <dt class="font-display text-[0.6875rem] font-semibold tracking-[0.14em] text-ambedkar-700 uppercase">
                  {fact.term}
                </dt>
                <dd class="mt-1 leading-7 text-ambedkar-900/80">
                  {fact.description}
                </dd>
              </div>
            ))
          }
          <div>
            <dt
              class="font-display text-[0.6875rem] font-semibold tracking-[0.14em] text-ambedkar-700 uppercase"
            >
              ISBN
            </dt>
            <dd class="mt-1 leading-7 wrap-break-word text-ambedkar-900/80">
              <a
                class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                href={openLibraryUrl(data.isbn)}
              >
                {data.isbn}
              </a>
              <span class="mt-1 block text-sm text-ambedkar-900/70">
                Look this edition up on Open Library.
              </span>
            </dd>
          </div>
        </dl>
      </div>

      {
        cover && (
          <figure class="mt-10 lg:order-last lg:mt-0 lg:shrink-0">
            <ResponsiveImage
              class="w-40 rounded-2xl shadow-lift sm:w-48 lg:w-56"
              src={cover}
              alt={COVER_ALT}
              sizes="(min-width: 1024px) 14rem, (min-width: 640px) 12rem, 10rem"
              widths={COVER_WIDTHS}
              loading="eager"
            />
            <figcaption class="mt-3 max-w-56 text-xs text-ambedkar-900/70">
              Cover art via{" "}
              <a
                class="underline underline-offset-2 hover:text-ambedkar-900"
                href={openLibraryUrl(data.isbn)}
              >
                Open Library
              </a>
              .
            </figcaption>
          </figure>
        )
      }
    </div>

    <section class="mt-12 max-w-3xl">
      <h2
        class="font-display text-display-sm leading-[1.04] font-bold tracking-display text-ambedkar-950"
      >
        {
          readings.length === 0
            ? "Not yet read"
            : readings.length === 1
              ? "Read at one session"
              : `Read across ${readings.length} sessions`
        }
      </h2>
      {
        readings.length === 0 ? (
          <p class="mt-4 leading-7 text-ambedkar-900/75">
            The circle has not scheduled a session on this book yet.
          </p>
        ) : (
          <ul class="mt-6 space-y-4">
            {readings.map((reading) => (
              <li class="card p-6">
                <p class="font-display text-[0.6875rem] font-semibold tracking-[0.14em] text-ambedkar-700 uppercase">
                  <time datetime={reading.data.date.toISOString()}>
                    {formatPacificDate(reading.data.date)}
                  </time>
                </p>
                <h3 class="mt-2 font-display text-xl leading-[1.18] font-semibold tracking-title text-ambedkar-950">
                  <a
                    class="after:absolute after:inset-0"
                    href={`/book-readings/${reading.id}/`}
                  >
                    {reading.data.title}
                  </a>
                </h3>
                <p class="mt-2 leading-7 text-ambedkar-900/75">
                  {reading.data.summary}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      data.resources.length > 0 && (
        <section class="card mt-12 max-w-3xl p-6 sm:p-8">
          <h2 class="font-display text-xl font-semibold tracking-title text-ambedkar-950">
            Where to read it
          </h2>
          <ul class="mt-4 space-y-3">
            {data.resources.map((resource) => (
              <li>
                <a
                  class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                  href={resource.url}
                >
                  {resource.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.topics.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="eyebrow">Topics</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {data.topics.map((topic) => (
              <li class="tag px-3 py-1.5 text-sm">{topicLabel(topic)}</li>
            ))}
          </ul>
        </section>
      )
    }
  </Container>
</article>
