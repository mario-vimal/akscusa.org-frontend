---
import EditorialIndex from "../../editorial/components/EditorialIndex.astro";
import { bookHref, loadBooksWithReadings } from "../queries/books";
import BookCard from "./BookCard.astro";

const entries = await loadBooksWithReadings();
---

<EditorialIndex
  eyebrow="Reading and Discussions"
  title="Books"
  description="Every book the reading circle has worked through, with the sessions that covered it. Each entry is identified by the ISBN of the edition we read."
  count={`${entries.length} ${entries.length === 1 ? "book" : "books"}`}
  empty="No books have been published yet."
  isEmpty={entries.length === 0}
>
  {
    entries.map(({ book, readings }) => (
      <li>
        <BookCard
          href={bookHref(book)}
          title={book.data.title}
          subtitle={book.data.subtitle}
          authors={book.data.authors.join(", ")}
          summary={book.data.summary}
          isbn={book.data.isbn}
          publisher={book.data.publisher}
          sessions={readings.length}
          topics={book.data.topics}
        />
      </li>
    ))
  }
</EditorialIndex>
