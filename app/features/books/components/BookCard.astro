---
import ResponsiveImage from "~/components/ui/ResponsiveImage.astro";
import { topicLabel, type EditorialTopic } from "~/features/editorial/taxonomy";
import { COVER_ALT, COVER_WIDTHS, coverForIsbn } from "~/features/books/covers";

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  authors?: string;
  summary?: string;
  isbn: string;
  publisher?: string;
  sessions: number;
  topics?: readonly EditorialTopic[];
}

const {
  href,
  title,
  subtitle,
  authors,
  summary,
  isbn,
  publisher,
  sessions,
  topics = [],
} = Astro.props;

const cover = coverForIsbn(isbn);

const sessionLabel =
  sessions === 0
    ? "Not yet scheduled"
    : `${sessions} ${sessions === 1 ? "session" : "sessions"}`;
---

<article class="card group p-6 sm:p-8">
  <div class="flex gap-5">
    {
      cover ? (
        <ResponsiveImage
          class="w-20 shrink-0 self-start rounded-lg shadow-card sm:w-24"
          src={cover}
          alt={COVER_ALT}
          sizes="(min-width: 640px) 6rem, 5rem"
          widths={COVER_WIDTHS}
        />
      ) : (
        <div
          class="w-20 shrink-0 self-start rounded-lg border border-dashed border-rule-strong bg-ambedkar-50 py-8 sm:w-24"
          aria-hidden="true"
        />
      )
    }

    <div class="min-w-0">
      {
        /*
        A byline is a person's name, not a label, so the label's uppercase and
        its letterspacing are dropped here. bell hooks set her pen name in
        lower case deliberately; a card that prints "BELL HOOKS" has quietly
        overruled the one thing about that name its owner chose.
      */
      }
      {
        authors && (
          <p class="label tracking-normal text-ambedkar-700 normal-case">
            {authors}
          </p>
        )
      }
      <h2
        class="mt-2 font-display text-xl leading-[1.16] font-semibold tracking-title text-balance text-ambedkar-950"
      >
        <a
          class="after:absolute after:inset-0 focus-visible:outline-none"
          href={href}
        >
          {title}
        </a>
      </h2>
      {subtitle && <p class="mt-1 text-sm text-ambedkar-900/70">{subtitle}</p>}
      <span
        class:list={[
          "mt-3 inline-block rounded-sm border px-1.5 py-0.5 font-display text-[0.625rem] font-semibold tracking-[0.1em] uppercase",
          sessions > 0
            ? "border-rule-strong text-ambedkar-900/70"
            : "border-accent-600 text-accent-700",
        ]}
      >
        {sessionLabel}
      </span>
    </div>
  </div>

  {
    summary && (
      <p class="card-summary mt-5 leading-7 text-ambedkar-900/75">{summary}</p>
    )
  }

  <ul class="mt-4 space-y-1 text-sm text-ambedkar-900/70">
    <li class="wrap-break-word">ISBN {isbn}</li>
    {publisher && <li>{publisher}</li>}
  </ul>

  {/* See EntryCard: the repeated "Read more →" is gone from every index. */}
  {
    topics.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-2 pt-6">
        {topics.map((topic) => (
          <li class="tag">{topicLabel(topic)}</li>
        ))}
      </ul>
    )
  }
</article>
