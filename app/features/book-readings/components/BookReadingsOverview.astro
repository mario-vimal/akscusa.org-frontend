---
import { getCollection } from "astro:content";

import Container from "../../../components/ui/Container.astro";
import SectionLanding from "../../../components/ui/SectionLanding.astro";

const readings = (await getCollection("bookReadings")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const dateFormat = new Intl.DateTimeFormat("en-US", {
  dateStyle: "full",
  timeStyle: "short",
  timeZone: "America/Los_Angeles",
});

const contentAreas = [
  {
    title: "Upcoming readings",
    description:
      "Feature scheduled readings with dates, locations, participants, and registration details.",
  },
  {
    title: "Reading archive",
    description:
      "Preserve recordings, transcripts, and highlights from previous community events.",
  },
  {
    title: "Featured publications",
    description:
      "Connect each reading with relevant books, authors, and supporting material.",
  },
];
---

{
  readings.length === 0 ? (
    <SectionLanding
      eyebrow="Programs"
      title="Book Readings"
      description="Discover upcoming literary gatherings and revisit readings from across the AKSC USA community."
      items={contentAreas}
    />
  ) : (
    <section class="relative isolate overflow-hidden">
      <div
        class="absolute inset-x-0 top-0 -z-10 h-[28rem] bg-[radial-gradient(circle_at_top_right,rgba(240,184,63,0.2),transparent_48%),radial-gradient(circle_at_top_left,rgba(31,98,170,0.18),transparent_42%)]"
        aria-hidden="true"
      />

      <Container class="py-20 sm:py-28">
        <div class="max-w-3xl">
          <p class="text-sm font-bold tracking-[0.18em] text-ambedkar-700 uppercase">
            Programs
          </p>
          <h1 class="mt-4 text-5xl leading-none font-semibold tracking-[-0.05em] text-balance text-ambedkar-950 sm:text-7xl">
            Book Readings
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-ambedkar-900/75 sm:text-xl">
            Discover upcoming literary gatherings and revisit readings from
            across the AKSC USA community.
          </p>
        </div>

        <ul class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {readings.map((reading) => (
            <li class="flex flex-col rounded-3xl border border-ambedkar-900/10 bg-cream p-7 sm:p-8">
              <p class="text-sm font-semibold text-ambedkar-700">
                <time datetime={reading.data.date.toISOString()}>
                  {dateFormat.format(reading.data.date)}
                </time>
              </p>
              <h2 class="mt-3 text-xl font-semibold tracking-tight text-ambedkar-950">
                {reading.data.title}
              </h2>
              <p class="mt-2 text-ambedkar-900/70">
                <cite class="not-italic">{reading.data.book.title}</cite> by{" "}
                {reading.data.book.author}
              </p>
              <p class="mt-3 leading-7 text-ambedkar-900/70">
                {reading.data.summary}
              </p>
              <p class="mt-3 text-sm text-ambedkar-900/70">
                {reading.data.location}
              </p>
              {reading.data.participants.length > 0 && (
                <p class="mt-3 text-sm text-ambedkar-900/70">
                  With {reading.data.participants.join(", ")}
                </p>
              )}
              {reading.data.registrationUrl && (
                <a
                  class="mt-6 self-start rounded-full bg-ambedkar-700 px-5 py-2.5 font-semibold text-cream underline-offset-4 hover:bg-ambedkar-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ambedkar-700"
                  href={reading.data.registrationUrl}
                >
                  Register
                  <span class="sr-only"> for {reading.data.title}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )
}
