---
import PageMasthead from "~/components/ui/PageMasthead.astro";
import readingGathering from "~/features/book-readings/assets/reading-gathering-dgxogexaxm8.jpg";
import { loadReadingCircle } from "~/features/book-readings/queries/circle";
import { editorialSections } from "~/features/editorial/sections";
import MeetingTerms from "./MeetingTerms.astro";
import NextSession from "./NextSession.astro";
import ReadingLog from "./ReadingLog.astro";

interface Props {
  practicalitiesHeading: string;
  practicalities: readonly { term: string; description: string }[];
  strandsHeading: string;
  strands: readonly {
    title: string;
    description: string;
    note?: string;
  }[];
}

const { practicalitiesHeading, practicalities, strandsHeading, strands } =
  Astro.props;

const section = editorialSections.bookReadings;
const { entries, opener } = await loadReadingCircle();
---

<!--
  The reading circle, in the order a visitor asks about it: when can I come,
  how does this work, and what have you read?

  The page is composed here rather than through `EditorialIndex`, which puts
  everything in one container because it is drawing a grid of equal cards. This
  page is not an index of cards: it is an ink masthead carrying the next
  sitting, a band of paper stating the arrangement, and the record on the
  page's own ground beneath them.

  The masthead states no totals. Not every session the circle has held has been
  written up yet, so "10 books · 22 sessions · since 2020" would put a precise
  figure on an imprecise record, and a visitor has no way to tell that the
  number is of the archive rather than of the reading.
-->
<section>
  <PageMasthead
    eyebrow={section.eyebrow}
    title={section.title}
    description={section.description}
    backgroundImage={readingGathering}
  >
    {opener && <NextSession session={opener} />}
  </PageMasthead>

  <MeetingTerms
    heading={practicalitiesHeading}
    terms={practicalities}
    strandsHeading={strandsHeading}
    strands={strands}
  />

  <ReadingLog entries={entries} empty={section.empty} />
</section>
