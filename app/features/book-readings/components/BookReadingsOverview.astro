---
import EditorialIndex from "../../editorial/components/EditorialIndex.astro";
import {
  editorialSections,
  loadEditorialEntries,
} from "../../editorial/entries";
import { loadReadingBooks } from "../../books/queries/books";
import { bookReadingRows } from "../presenters";
import BookReadingsTable from "./BookReadingsTable.astro";

interface Props {
  practicalitiesHeading: string;
  practicalities: readonly { term: string; description: string }[];
  strandsHeading: string;
  strands: readonly {
    title: string;
    description: string;
    note?: string;
  }[];
}

const { practicalitiesHeading, practicalities, strandsHeading, strands } =
  Astro.props;

const section = editorialSections.bookReadings;
const readings = await loadEditorialEntries("bookReadings");
const rows = bookReadingRows(readings, await loadReadingBooks());
---

<EditorialIndex
  eyebrow={section.eyebrow}
  title={section.title}
  description={section.description}
  count={`${readings.length} ${readings.length === 1 ? "reading" : "readings"}`}
  empty={section.empty}
  isEmpty={readings.length === 0}
  list={false}
>
  <div slot="intro" class="mt-12 grid gap-6 lg:grid-cols-2">
    <section
      class="rounded-3xl border border-ambedkar-900/10 bg-white p-6 sm:p-8"
    >
      <h2 class="text-lg font-semibold tracking-tight text-ambedkar-950">
        {practicalitiesHeading}
      </h2>
      <dl class="mt-5 space-y-4">
        {
          practicalities.map((item) => (
            <div>
              <dt class="text-xs font-bold tracking-[0.14em] text-ambedkar-700 uppercase">
                {item.term}
              </dt>
              <dd class="mt-1 leading-7 text-ambedkar-900/80">
                {item.description}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section
      class="rounded-3xl border border-ambedkar-900/10 bg-mist p-6 sm:p-8"
    >
      <h2 class="text-lg font-semibold tracking-tight text-ambedkar-950">
        {strandsHeading}
      </h2>
      <ul class="mt-5 space-y-5">
        {
          strands.map((strand) => (
            <li>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <h3 class="font-semibold text-ambedkar-950">{strand.title}</h3>
                {strand.note && (
                  <span class="rounded-full bg-ambedkar-900/10 px-2.5 py-1 text-xs font-bold tracking-wide text-ambedkar-900 uppercase">
                    {strand.note}
                  </span>
                )}
              </div>
              <p class="mt-2 leading-7 text-ambedkar-900/75">
                {strand.description}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm">
        <a
          class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
          href="/books/"
        >
          Browse every book the circle has read &rarr;
        </a>
      </p>
    </section>
  </div>

  <BookReadingsTable rows={rows} />
</EditorialIndex>
