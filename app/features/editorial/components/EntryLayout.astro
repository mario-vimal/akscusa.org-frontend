---
import Container from "~/components/ui/Container.astro";
import EntryHeader from "~/components/ui/EntryHeader.astro";
import Poster from "~/components/ui/Poster.astro";
import {
  editorialSections,
  type EditorialCollection,
} from "~/features/editorial/sections";
import type { Badge, Detail, LinkItem } from "~/features/editorial/presenters";
import { loadTermLabels } from "~/features/editorial/queries/taxonomy";
import ProseContent from "./ProseContent.astro";

interface EntryPoster {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  section: EditorialCollection;
  title: string;
  summary: string;
  badge?: Badge;
  details?: readonly Detail[];
  /** Set apart from the body, used for an intervention's outcome. */
  callout?: { heading: string; text: string };
  links?: { heading: string; items: readonly LinkItem[] };
  topics?: readonly string[];
  heroImage?: { src: string; alt: string };
  /** AKSC's own flyers for the entry, shown in an aside beside its details. */
  posters?: readonly EntryPoster[];
  sourceUrl?: string;
}

const {
  section,
  title,
  summary,
  badge,
  details = [],
  callout,
  links,
  topics = [],
  heroImage,
  posters = [],
  sourceUrl,
} = Astro.props;

const { path, label } = editorialSections[section];

/*
 * The badge now sits on the page's own white rather than on the masthead's
 * ink, so both tones are the dark end of their scale. The light-on-dark pair
 * this replaced — white/40 borders and accent-300 text — would be all but
 * invisible here.
 */
const badgeClasses =
  badge?.tone === "muted"
    ? "border-ambedkar-900/25 text-ambedkar-900/70"
    : "border-accent-600/50 text-accent-700";

const hasPosters = posters.length > 0;
const hasMultiplePosters = posters.length > 1;

const topicLabel = await loadTermLabels("topics");
---

<article>
  <Container class="pt-10 pb-20 sm:pt-12 sm:pb-28">
    <div
      class:list={[
        "items-start",
        hasPosters &&
          "lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(20rem,26rem)] lg:gap-x-14",
      ]}
    >
      {
        /*
        Three grid items rather than two, so the flyer can sit between the
        header and the details on a phone and still hold the right-hand column
        on a wide screen. Reading a poster before the title tells you nothing;
        reading it straight after tells you what the entry is about.
      */
      }
      <div
        class:list={["min-w-0", hasPosters && "lg:col-start-1 lg:row-start-1"]}
      >
        <EntryHeader
          eyebrow={label}
          title={title}
          lede={summary}
          backHref={`${path}/`}
          backLabel={label}
        >
          {
            badge && (
              <p class="mt-5">
                <span
                  class:list={[
                    "inline-block rounded-sm border px-1.5 py-0.5 font-display text-[0.625rem] font-semibold tracking-[0.1em] uppercase",
                    badgeClasses,
                  ]}
                >
                  {badge.label}
                </span>
              </p>
            )
          }
        </EntryHeader>
      </div>

      {
        hasPosters && (
          <aside
            class:list={[
              "mt-10 grid auto-rows-max content-start items-start gap-5 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:grid-cols-1",
              hasMultiplePosters && "sm:grid-cols-2",
            ]}
            aria-label={`Original ${label.toLowerCase()} posters`}
          >
            {posters.map((poster, index) => (
              <Poster
                src={poster.src}
                alt={poster.alt}
                caption={poster.caption}
                loading={index === 0 ? "eager" : "lazy"}
              />
            ))}
          </aside>
        )
      }

      <div
        class:list={["min-w-0", hasPosters && "lg:col-start-1 lg:row-start-2"]}
      >
        {
          details.length > 0 && (
            <dl class="mt-10 max-w-3xl border-t border-ambedkar-950 sm:grid sm:grid-cols-2 sm:gap-x-10">
              {details.map((detail) => (
                <div class="border-b border-rule py-4">
                  <dt class="label text-ambedkar-700">{detail.term}</dt>
                  <dd class="mt-1.5 leading-7 text-ambedkar-900/80">
                    {detail.href ? (
                      <a
                        class="link-underline font-medium text-ambedkar-800"
                        href={detail.href}
                      >
                        {detail.description}
                      </a>
                    ) : (
                      detail.description
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          callout && (
            <div
              class:list={[
                "on-dark relative isolate max-w-3xl overflow-hidden rounded-xl bg-ambedkar-950 px-6 py-7 text-mist sm:px-8",
                details.length > 0 ? "mt-8" : "",
              ]}
            >
              <div
                class="absolute inset-0 -z-10 bg-linear-to-br from-ambedkar-900 to-ambedkar-1000"
                aria-hidden="true"
              />
              <p class="eyebrow eyebrow-light">{callout.heading}</p>
              <p class="mt-4 leading-7">{callout.text}</p>
            </div>
          )
        }

        {
          heroImage && (
            <img
              class="mt-10 w-full max-w-3xl rounded-xl border border-rule shadow-card"
              src={heroImage.src}
              alt={heroImage.alt}
              loading="eager"
              decoding="async"
            />
          )
        }

        <slot name="before-body" />

        <div class="mt-12">
          <ProseContent>
            <slot />
          </ProseContent>
        </div>

        {
          links && links.items.length > 0 && (
            <section class="card mt-12 max-w-3xl p-6 sm:p-8">
              <h2 class="font-display text-xl font-semibold tracking-title text-ambedkar-950">
                {links.heading}
              </h2>
              <ul class="mt-4 space-y-3">
                {links.items.map((item) => (
                  <li>
                    <a
                      class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                      href={item.url}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          topics.length > 0 && (
            <section class="mt-12 max-w-3xl">
              <h2 class="eyebrow">Topics</h2>
              <ul class="mt-4 flex flex-wrap gap-2">
                {topics.map((topic) => (
                  <li class="tag px-3 py-1.5 text-sm">{topicLabel(topic)}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          sourceUrl && (
            <p class="mt-10 max-w-3xl text-sm wrap-break-word text-ambedkar-900/70">
              Originally published at{" "}
              <a
                class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                href={sourceUrl}
                data-provenance
              >
                {sourceUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")}
              </a>
              .
            </p>
          )
        }
      </div>
    </div>
  </Container>
</article>
