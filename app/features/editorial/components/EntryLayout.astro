---
import BackLink from "../../../components/ui/BackLink.astro";
import Container from "../../../components/ui/Container.astro";
import PageMasthead from "../../../components/ui/PageMasthead.astro";
import { editorialSections, type EditorialCollection } from "../entries";
import { topicLabel, type EditorialTopic } from "../taxonomy";
import ProseContent from "./ProseContent.astro";

interface Detail {
  term: string;
  description: string;
  /** Turns the description into a link, used for contacts and registration. */
  href?: string;
}

interface LinkItem {
  label: string;
  url: string;
}

interface Props {
  section: EditorialCollection;
  title: string;
  summary: string;
  badge?: { label: string; tone?: "accent" | "muted" };
  details?: readonly Detail[];
  /** Set apart from the body, used for an intervention's outcome. */
  callout?: { heading: string; text: string };
  links?: { heading: string; items: readonly LinkItem[] };
  topics?: readonly EditorialTopic[];
  heroImage?: { src: string; alt: string };
  sourceUrl?: string;
}

const {
  section,
  title,
  summary,
  badge,
  details = [],
  callout,
  links,
  topics = [],
  heroImage,
  sourceUrl,
} = Astro.props;

const { path, label } = editorialSections[section];

const badgeClasses =
  badge?.tone === "muted"
    ? "bg-white/15 text-white ring-1 ring-white/25 ring-inset"
    : "bg-accent-300 text-ambedkar-950";
---

<article>
  <PageMasthead
    eyebrow={label}
    title={title}
    description={summary}
    size="large"
  >
    <BackLink slot="above" href={`${path}/`} tone="light">
      Back to {label}
    </BackLink>

    {
      badge && (
        <p class="mt-8">
          <span
            class:list={[
              "inline-block rounded-full px-3 py-1 text-xs font-bold tracking-wide uppercase",
              badgeClasses,
            ]}
          >
            {badge.label}
          </span>
        </p>
      )
    }
  </PageMasthead>

  <Container class="pt-12 pb-20 sm:pt-14 sm:pb-28">
    {
      details.length > 0 && (
        <dl class="card max-w-3xl gap-x-8 gap-y-5 p-6 sm:grid sm:grid-cols-2 sm:p-8">
          {details.map((detail) => (
            <div>
              <dt class="text-xs font-bold tracking-[0.14em] text-ambedkar-700 uppercase">
                {detail.term}
              </dt>
              <dd class="mt-1 leading-7 text-ambedkar-900/80">
                {detail.href ? (
                  <a
                    class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                    href={detail.href}
                  >
                    {detail.description}
                  </a>
                ) : (
                  detail.description
                )}
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      callout && (
        <div
          class:list={[
            "on-dark relative isolate max-w-3xl overflow-hidden rounded-3xl bg-ambedkar-950 px-6 py-7 text-mist shadow-soft sm:px-8",
            details.length > 0 ? "mt-8" : "",
          ]}
        >
          <div
            class="absolute inset-0 -z-10 bg-[radial-gradient(80%_120%_at_100%_0%,var(--color-accent-900),transparent_60%)]"
            aria-hidden="true"
          />
          <p class="eyebrow eyebrow-light">{callout.heading}</p>
          <p class="mt-4 leading-7">{callout.text}</p>
        </div>
      )
    }

    {
      heroImage && (
        <img
          class="mt-10 w-full max-w-3xl rounded-3xl border border-ambedkar-900/10 shadow-card"
          src={heroImage.src}
          alt={heroImage.alt}
          loading="eager"
          decoding="async"
        />
      )
    }

    <div class="mt-12">
      <ProseContent>
        <slot />
      </ProseContent>
    </div>

    {
      links && links.items.length > 0 && (
        <section class="card mt-12 max-w-3xl p-6 sm:p-8">
          <h2 class="font-display text-xl font-semibold tracking-[-0.01em] text-ambedkar-950">
            {links.heading}
          </h2>
          <ul class="mt-4 space-y-3">
            {links.items.map((item) => (
              <li>
                <a
                  class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
                  href={item.url}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      topics.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="eyebrow">Topics</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {topics.map((topic) => (
              <li class="tag px-3 py-1.5 text-sm">{topicLabel(topic)}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      sourceUrl && (
        <p class="mt-10 max-w-3xl text-sm wrap-break-word text-ambedkar-900/60">
          Originally published at{" "}
          <a
            class="font-semibold text-ambedkar-700 underline underline-offset-4 hover:text-ambedkar-900"
            href={sourceUrl}
          >
            {sourceUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")}
          </a>
          .
        </p>
      )
    }
  </Container>
</article>
