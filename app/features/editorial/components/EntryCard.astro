---
import { loadTermLabels } from "~/features/editorial/queries/taxonomy";

interface Badge {
  label: string;
  /** `accent` marks something still open, `muted` something closed. */
  tone?: "accent" | "muted";
}

interface Props {
  href: string;
  title: string;
  summary: string;
  /** Date or other short line printed above the title. */
  eyebrow?: string;
  badge?: Badge;
  /** Short supporting facts such as authors, venue, or who issued a statement. */
  meta?: readonly string[];
  topics?: readonly string[];
}

const {
  href,
  title,
  summary,
  eyebrow,
  badge,
  meta = [],
  topics = [],
} = Astro.props;

const badgeClasses =
  badge?.tone === "muted"
    ? "border-rule text-ambedkar-900/70"
    : "border-accent-600 text-accent-700";

const topicLabel = await loadTermLabels("topics");
---

<article class="card group p-6 sm:p-7">
  {
    (eyebrow || badge) && (
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        {eyebrow && <p class="label text-accent-700">{eyebrow}</p>}
        {badge && (
          <span
            class:list={[
              "rounded-sm border px-1.5 py-0.5 font-display text-[0.625rem] font-semibold tracking-[0.1em] uppercase",
              badgeClasses,
            ]}
          >
            {badge.label}
          </span>
        )}
      </div>
    )
  }

  <h2
    class="card-title mt-4 font-display text-[1.375rem] leading-[1.14] font-semibold tracking-title text-balance text-ambedkar-950 sm:text-2xl"
  >
    <a
      class="after:absolute after:inset-0 focus-visible:outline-none"
      href={href}
    >
      {title}
    </a>
  </h2>

  <p class="card-summary mt-3 leading-7 text-ambedkar-900/72">{summary}</p>

  {
    meta.length > 0 && (
      <ul class="mt-4 space-y-1 text-sm text-ambedkar-900/70">
        {meta.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }

  {
    /*
     * No "Read more →" line. It said nothing the card did not already say, and
     * an index of seventeen statements printed it seventeen times: the same
     * three words and the same arrow down the whole page, which is the tell of
     * a template rather than of an editor. The card already answers that it can
     * be followed — the accent rule draws across its top edge, its border
     * firms, and the title underlines itself — so the corner is given back to
     * the topics, which actually differ from one entry to the next.
     */
  }
  {
    topics.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-1.5 pt-6">
        {topics.map((topic) => (
          <li class="tag">{topicLabel(topic)}</li>
        ))}
      </ul>
    )
  }
</article>
