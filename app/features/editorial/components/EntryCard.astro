---
import { topicLabel, type EditorialTopic } from "../taxonomy";

interface Badge {
  label: string;
  /** `accent` marks something still open, `muted` something closed. */
  tone?: "accent" | "muted";
}

interface Props {
  href: string;
  title: string;
  summary: string;
  /** Date or other short line printed above the title. */
  eyebrow?: string;
  badge?: Badge;
  /** Short supporting facts such as authors, venue, or who issued a statement. */
  meta?: readonly string[];
  topics?: readonly EditorialTopic[];
}

const {
  href,
  title,
  summary,
  eyebrow,
  badge,
  meta = [],
  topics = [],
} = Astro.props;

const badgeClasses =
  badge?.tone === "muted"
    ? "bg-ambedkar-900/10 text-ambedkar-900"
    : "bg-accent-300 text-ambedkar-950";
---

<article class="card group p-6 sm:p-8">
  {
    (eyebrow || badge) && (
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        {eyebrow && (
          <p class="text-xs font-bold tracking-[0.14em] text-ambedkar-700 uppercase">
            {eyebrow}
          </p>
        )}
        {badge && (
          <span
            class:list={[
              "rounded-full px-2.5 py-1 text-xs font-bold tracking-wide uppercase",
              badgeClasses,
            ]}
          >
            {badge.label}
          </span>
        )}
      </div>
    )
  }

  <h2
    class="mt-3 font-display text-[1.375rem] leading-[1.2] font-semibold tracking-[-0.015em] text-balance text-ambedkar-950 sm:text-2xl"
  >
    <a
      class="after:absolute after:inset-0 focus-visible:outline-none"
      href={href}
    >
      {title}
    </a>
  </h2>

  <p class="mt-3 leading-7 text-ambedkar-900/75">{summary}</p>

  {
    meta.length > 0 && (
      <ul class="mt-4 space-y-1 text-sm text-ambedkar-900/65">
        {meta.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }

  <div class="mt-auto pt-6">
    {
      topics.length > 0 && (
        <ul class="flex flex-wrap gap-2">
          {topics.map((topic) => (
            <li class="tag">{topicLabel(topic)}</li>
          ))}
        </ul>
      )
    }
    <p
      class="mt-5 flex items-center gap-2 text-sm font-bold tracking-[0.06em] text-ambedkar-700 uppercase group-hover:text-ambedkar-900"
      aria-hidden="true"
    >
      Read more
      <span
        class="inline-block transition-transform duration-300 group-hover:translate-x-1"
        >&rarr;</span
      >
    </p>
  </div>
</article>
