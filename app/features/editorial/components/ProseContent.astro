---
/**
 * Long-form Markdown rendered by a content collection. The rules live here so
 * every editorial entry reads the same, whatever collection it came from.
 */
---

<div class="prose-editorial">
  <slot />
</div>

<style>
  .prose-editorial {
    max-width: 44rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: color-mix(in srgb, var(--color-ambedkar-900) 82%, transparent);
    overflow-wrap: break-word;
  }

  .prose-editorial :global(> :first-child) {
    margin-top: 0;
  }

  .prose-editorial :global(p),
  .prose-editorial :global(ul),
  .prose-editorial :global(ol) {
    margin-top: 1.25rem;
  }

  /*
   * Headings are set in the display serif, so a reader can tell the structure
   * of a piece from the shape of the type rather than from size alone. The
   * scroll offset clears the sticky header when a heading is jumped to.
   */
  .prose-editorial :global(h2) {
    margin-top: 3.5rem;
    scroll-margin-top: 7rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-ambedkar-900) 14%, transparent);
    padding-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 4vw, 2.125rem);
    line-height: 1.18;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-ambedkar-950);
    text-wrap: balance;
  }

  .prose-editorial :global(h3) {
    margin-top: 2.5rem;
    scroll-margin-top: 7rem;
    border-left: 0.1875rem solid var(--color-accent-600);
    padding-left: 1rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ambedkar-950);
    text-wrap: pretty;
  }

  .prose-editorial :global(h4),
  .prose-editorial :global(h5),
  .prose-editorial :global(h6) {
    margin-top: 2rem;
    scroll-margin-top: 7rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ambedkar-700);
  }

  .prose-editorial :global(h2 + h3),
  .prose-editorial :global(h3 + h4) {
    margin-top: 1.5rem;
  }

  .prose-editorial :global(a) {
    font-weight: 600;
    color: var(--color-ambedkar-700);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-ambedkar-700) 35%,
      transparent
    );
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.2em;
    transition:
      color 200ms var(--ease-out-soft),
      text-decoration-color 200ms var(--ease-out-soft);
  }

  .prose-editorial :global(a:hover) {
    color: var(--color-ambedkar-900);
    text-decoration-color: currentColor;
  }

  .prose-editorial :global(strong) {
    font-weight: 700;
    color: var(--color-ambedkar-950);
  }

  .prose-editorial :global(ul),
  .prose-editorial :global(ol) {
    padding-left: 1.5rem;
  }

  .prose-editorial :global(ul) {
    list-style: disc;
  }

  .prose-editorial :global(ol) {
    list-style: decimal;
  }

  .prose-editorial :global(li) {
    margin-top: 0.5rem;
    padding-left: 0.25rem;
  }

  .prose-editorial :global(li::marker) {
    color: var(--color-accent-600);
  }

  .prose-editorial :global(li > ul),
  .prose-editorial :global(li > ol) {
    margin-top: 0.5rem;
  }

  /*
   * A quotation is lifted onto its own card rather than only indented, because
   * these entries quote at length and an indent alone gets lost in a long page.
   */
  .prose-editorial :global(blockquote) {
    margin-top: 1.75rem;
    border-left: 0.1875rem solid var(--color-accent-600);
    border-radius: 0 1rem 1rem 0;
    background: linear-gradient(
      to right,
      var(--color-accent-50),
      transparent 85%
    );
    padding: 1rem 1.25rem 1rem 1.5rem;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--color-ambedkar-900);
  }

  .prose-editorial :global(blockquote p) {
    margin-top: 0.75rem;
  }

  .prose-editorial :global(blockquote > :first-child) {
    margin-top: 0;
  }

  .prose-editorial :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid
      color-mix(in srgb, var(--color-ambedkar-900) 14%, transparent);
  }

  .prose-editorial :global(img) {
    display: block;
    margin: 2rem 0;
    height: auto;
    max-width: 100%;
    border-radius: 1rem;
    box-shadow: var(--shadow-card);
  }

  .prose-editorial :global(figure) {
    margin: 2rem 0;
  }

  .prose-editorial :global(figcaption) {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-ambedkar-900) 65%, transparent);
  }

  /* Tables carry schedules and coverage lists, which are wide. Let them scroll
     inside their own box rather than pushing the page sideways on a phone. */
  .prose-editorial :global(table) {
    display: block;
    margin-top: 1.75rem;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .prose-editorial :global(th),
  .prose-editorial :global(td) {
    border: 1px solid
      color-mix(in srgb, var(--color-ambedkar-900) 14%, transparent);
    padding: 0.625rem 0.875rem;
    text-align: left;
    vertical-align: top;
  }

  .prose-editorial :global(th) {
    background: var(--color-ambedkar-50);
    font-weight: 700;
    color: var(--color-ambedkar-950);
  }

  .prose-editorial :global(code) {
    border-radius: 0.375rem;
    background: var(--color-ambedkar-50);
    padding: 0.125rem 0.375rem;
    font-size: 0.9375em;
  }

  .prose-editorial :global(pre) {
    margin-top: 1.75rem;
    overflow-x: auto;
    border-radius: 1rem;
    background: var(--color-ambedkar-950);
    padding: 1.25rem;
    color: var(--color-mist);
  }

  .prose-editorial :global(iframe) {
    margin: 2rem 0;
    aspect-ratio: 16 / 9;
    width: 100%;
    max-width: 100%;
    border-radius: 1rem;
  }
</style>
