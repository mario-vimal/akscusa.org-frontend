---
/**
 * Long-form Markdown rendered by a content collection. The rules live here so
 * every editorial entry reads the same, whatever collection it came from.
 */
---

<div class="prose-editorial">
  <slot />
</div>

<style>
  .prose-editorial {
    max-width: 44rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: color-mix(in srgb, var(--color-ambedkar-900) 82%, transparent);
    overflow-wrap: break-word;
  }

  .prose-editorial :global(> :first-child) {
    margin-top: 0;
  }

  .prose-editorial :global(p),
  .prose-editorial :global(ul),
  .prose-editorial :global(ol) {
    margin-top: 1.25rem;
  }

  .prose-editorial :global(h2) {
    margin-top: 3.5rem;
    scroll-margin-top: 6rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-ambedkar-900) 14%, transparent);
    padding-bottom: 0.75rem;
    font-size: clamp(1.625rem, 4vw, 2rem);
    line-height: 1.2;
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--color-ambedkar-950);
    text-wrap: balance;
  }

  .prose-editorial :global(h3) {
    margin-top: 2.5rem;
    scroll-margin-top: 6rem;
    border-left: 0.25rem solid var(--color-saffron-400);
    padding-left: 1rem;
    font-size: 1.3125rem;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--color-ambedkar-950);
    text-wrap: pretty;
  }

  .prose-editorial :global(h4),
  .prose-editorial :global(h5),
  .prose-editorial :global(h6) {
    margin-top: 2rem;
    scroll-margin-top: 6rem;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-ambedkar-950);
  }

  .prose-editorial :global(h2 + h3),
  .prose-editorial :global(h3 + h4) {
    margin-top: 1.5rem;
  }

  .prose-editorial :global(a) {
    font-weight: 600;
    color: var(--color-ambedkar-700);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .prose-editorial :global(a:hover) {
    color: var(--color-ambedkar-900);
  }

  .prose-editorial :global(strong) {
    font-weight: 700;
    color: var(--color-ambedkar-950);
  }

  .prose-editorial :global(ul),
  .prose-editorial :global(ol) {
    padding-left: 1.5rem;
  }

  .prose-editorial :global(ul) {
    list-style: disc;
  }

  .prose-editorial :global(ol) {
    list-style: decimal;
  }

  .prose-editorial :global(li) {
    margin-top: 0.5rem;
    padding-left: 0.25rem;
  }

  .prose-editorial :global(li > ul),
  .prose-editorial :global(li > ol) {
    margin-top: 0.5rem;
  }

  .prose-editorial :global(blockquote) {
    margin-top: 1.75rem;
    border-left: 0.25rem solid var(--color-saffron-400);
    padding: 0.25rem 0 0.25rem 1.25rem;
    font-size: 1.125rem;
    font-style: italic;
    color: var(--color-ambedkar-900);
  }

  .prose-editorial :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid
      color-mix(in srgb, var(--color-ambedkar-900) 14%, transparent);
  }

  .prose-editorial :global(img) {
    display: block;
    margin: 2rem 0;
    height: auto;
    max-width: 100%;
    border-radius: 1rem;
  }

  .prose-editorial :global(figure) {
    margin: 2rem 0;
  }

  .prose-editorial :global(figcaption) {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-ambedkar-900) 65%, transparent);
  }

  /* Tables carry schedules and coverage lists, which are wide. Let them scroll
     inside their own box rather than pushing the page sideways on a phone. */
  .prose-editorial :global(table) {
    display: block;
    margin-top: 1.75rem;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .prose-editorial :global(th),
  .prose-editorial :global(td) {
    border: 1px solid
      color-mix(in srgb, var(--color-ambedkar-900) 14%, transparent);
    padding: 0.625rem 0.875rem;
    text-align: left;
    vertical-align: top;
  }

  .prose-editorial :global(th) {
    background: var(--color-ambedkar-50);
    font-weight: 700;
    color: var(--color-ambedkar-950);
  }

  .prose-editorial :global(code) {
    border-radius: 0.375rem;
    background: var(--color-ambedkar-50);
    padding: 0.125rem 0.375rem;
    font-size: 0.9375em;
  }

  .prose-editorial :global(pre) {
    margin-top: 1.75rem;
    overflow-x: auto;
    border-radius: 1rem;
    background: var(--color-ambedkar-950);
    padding: 1.25rem;
    color: var(--color-cream);
  }

  .prose-editorial :global(iframe) {
    margin: 2rem 0;
    aspect-ratio: 16 / 9;
    width: 100%;
    max-width: 100%;
    border-radius: 1rem;
  }
</style>
