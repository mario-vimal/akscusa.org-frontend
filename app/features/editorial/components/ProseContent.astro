---
/**
 * Long-form Markdown rendered by a content collection. The rules live here so
 * every editorial entry reads the same, whatever collection it came from.
 */
---

<div class="prose-editorial">
  <slot />
</div>

<style>
  .prose-editorial {
    max-width: 40rem;
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.72;
    color: color-mix(in srgb, var(--color-ambedkar-950) 88%, transparent);
    overflow-wrap: break-word;
    font-variant-numeric: oldstyle-nums proportional-nums;
  }

  .prose-editorial :global(> :first-child) {
    margin-top: 0;
  }

  /*
   * The lede. An entry used to open at exactly the size it closed at, so the
   * masthead's summary was followed by a wall of even grey text with nothing to
   * step down from. Setting the opening paragraph one size up and at full ink
   * strength gives a piece a way in, which is what a lede is for, and it costs
   * the editor nothing: the first paragraph of the Markdown is already the
   * opening of the argument.
   *
   * Scoped to a paragraph that genuinely opens the entry. Some entries begin on
   * a heading or a figure, and enlarging the paragraph after those would put
   * the emphasis in the middle of the piece rather than at its start.
   */
  .prose-editorial :global(> p:first-child) {
    font-size: 1.3125rem;
    line-height: 1.6;
    color: var(--color-ambedkar-950);
  }

  .prose-editorial :global(p),
  .prose-editorial :global(ul),
  .prose-editorial :global(ol) {
    margin-top: 1.35rem;
  }

  /*
   * Headings are set in the display grotesque against a serif body, so a
   * reader can tell the structure of a piece from the shape of the type rather
   * than from size alone. The scroll offset clears the sticky header when a
   * heading is jumped to.
   */
  .prose-editorial :global(h2) {
    margin-top: 3.5rem;
    scroll-margin-top: 7rem;
    font-family: var(--font-display);
    font-variation-settings: "wdth" 104;
    font-size: clamp(1.5rem, 3.6vw, 1.9375rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    color: var(--color-ambedkar-950);
    text-wrap: balance;
  }

  .prose-editorial :global(h3) {
    margin-top: 2.75rem;
    scroll-margin-top: 7rem;
    font-family: var(--font-display);
    font-variation-settings: "wdth" 104;
    font-size: 1.3125rem;
    line-height: 1.22;
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    color: var(--color-ambedkar-950);
    text-wrap: pretty;
  }

  .prose-editorial :global(h4),
  .prose-editorial :global(h5),
  .prose-editorial :global(h6) {
    margin-top: 2rem;
    scroll-margin-top: 7rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ambedkar-700);
  }

  .prose-editorial :global(h2 + h3),
  .prose-editorial :global(h3 + h4) {
    margin-top: 1.5rem;
  }

  .prose-editorial :global(a) {
    color: var(--color-ambedkar-700);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-ambedkar-700) 32%,
      transparent
    );
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
    transition:
      color 200ms var(--ease-out-firm),
      text-decoration-color 200ms var(--ease-out-firm);
  }

  .prose-editorial :global(a:hover) {
    color: var(--color-ambedkar-950);
    text-decoration-color: currentColor;
  }

  .prose-editorial :global(strong) {
    font-weight: 700;
    color: var(--color-ambedkar-950);
  }

  .prose-editorial :global(ul),
  .prose-editorial :global(ol) {
    padding-left: 1.25rem;
  }

  .prose-editorial :global(ul) {
    list-style: disc;
  }

  .prose-editorial :global(ol) {
    list-style: decimal;
  }

  .prose-editorial :global(li) {
    margin-top: 0.5rem;
    padding-left: 0.375rem;
  }

  .prose-editorial :global(li::marker) {
    color: var(--color-accent-600);
    font-size: 0.85em;
  }

  .prose-editorial :global(li > ul),
  .prose-editorial :global(li > ol) {
    margin-top: 0.5rem;
  }

  /*
   * A quotation is set apart by a rule and a size change rather than by a
   * tinted card. These entries quote at length, and a coloured box around
   * every one of them turns an argument into a sequence of callouts.
   */
  .prose-editorial :global(blockquote) {
    margin: 2.25rem 0 2.25rem 0;
    border-left: 2px solid var(--color-accent-600);
    padding: 0.125rem 0 0.125rem 1.5rem;
    font-size: 1.3125rem;
    line-height: 1.5;
    font-style: italic;
    color: var(--color-ambedkar-900);
  }

  .prose-editorial :global(blockquote p) {
    margin-top: 0.75rem;
  }

  .prose-editorial :global(blockquote > :first-child) {
    margin-top: 0;
  }

  .prose-editorial :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--color-rule-strong);
  }

  .prose-editorial :global(img) {
    display: block;
    margin: 2.5rem 0;
    height: auto;
    max-width: 100%;
    border-radius: 0.5rem;
  }

  .prose-editorial :global(figure) {
    margin: 2.5rem 0;
  }

  .prose-editorial :global(figcaption) {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  /* Generated at build time, so keyboard scrolling does not depend on scripts. */
  .prose-editorial :global(.prose-table-scroll) {
    margin-top: 2rem;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-margin-top: 7rem;
  }

  .prose-editorial :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .prose-editorial :global(th),
  .prose-editorial :global(td) {
    border-bottom: 1px solid var(--color-rule);
    padding: 0.75rem 1rem 0.75rem 0;
    text-align: left;
    vertical-align: top;
  }

  .prose-editorial :global(th) {
    border-bottom-color: var(--color-ambedkar-950);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ambedkar-950);
  }

  .prose-editorial :global(code) {
    border-radius: 0.25rem;
    background: var(--color-haze);
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
  }

  .prose-editorial :global(pre) {
    margin-top: 1.75rem;
    overflow-x: auto;
    border-radius: 0.5rem;
    background: var(--color-ambedkar-950);
    padding: 1.25rem;
    color: var(--color-mist);
  }

  .prose-editorial :global(iframe) {
    margin: 2.5rem 0;
    aspect-ratio: 16 / 9;
    width: 100%;
    max-width: 100%;
    border-radius: 0.5rem;
  }
</style>
