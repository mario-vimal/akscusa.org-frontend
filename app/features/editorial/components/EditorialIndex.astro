---
import type { ImageMetadata } from "astro";

import Container from "../../../components/ui/Container.astro";
import PageMasthead from "../../../components/ui/PageMasthead.astro";

interface FilterLink {
  label: string;
  href: string;
  current?: boolean;
}

interface ImageCredit {
  creator: string;
  sourceHref: string;
  license: string;
  licenseHref: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  /** Printed beside the title, for example "38 entries". */
  count?: string;
  filters?: readonly FilterLink[];
  filtersLabel?: string;
  /** Shown in place of the list when nothing has been published yet. */
  empty?: string;
  isEmpty?: boolean;
  /** Optional decorative photograph behind the shared page masthead. */
  backgroundImage?: ImageMetadata;
  backgroundLabel?: string;
  backgroundCredit?: ImageCredit;
  backgroundPosition?: "center" | "portrait";
  /**
   * Whether to wrap the default slot in the shared card grid. Set false when a
   * section renders its own body, such as the book readings table.
   */
  list?: boolean;
}

const {
  eyebrow,
  title,
  description,
  count,
  filters = [],
  filtersLabel = "Filter",
  empty,
  isEmpty = false,
  backgroundImage,
  backgroundLabel,
  backgroundCredit,
  backgroundPosition,
  list = true,
} = Astro.props;
---

<section>
  <PageMasthead
    eyebrow={eyebrow}
    title={title}
    description={description}
    meta={count}
    backgroundImage={backgroundImage}
    backgroundLabel={backgroundLabel}
    backgroundCredit={backgroundCredit}
    backgroundPosition={backgroundPosition}
  >
    {
      filters.length > 0 && (
        <nav class="mt-10" aria-label={filtersLabel}>
          <ul class="flex flex-wrap gap-2">
            {filters.map((filter) => (
              <li>
                <a
                  class:list={[
                    "inline-block rounded-full px-4 py-2 text-sm font-semibold transition-colors",
                    filter.current
                      ? "bg-accent-300 text-ambedkar-950"
                      : "bg-white/10 text-white/85 ring-1 ring-white/20 ring-inset hover:bg-white/20 hover:text-white",
                  ]}
                  href={filter.href}
                  aria-current={filter.current ? "page" : undefined}
                >
                  {filter.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </PageMasthead>

  <Container class="pt-14 pb-20 sm:pt-16 sm:pb-28">
    <!-- Standing context a section may need above its entries, such as how
      the reading circle meets. Most indexes leave this empty. -->
    <slot name="intro" />

    {
      isEmpty ? (
        <p class="card max-w-2xl px-6 py-8 leading-7 text-ambedkar-900/75">
          {empty}
        </p>
      ) : list ? (
        <ul class="reveal-children grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <slot />
        </ul>
      ) : (
        <slot />
      )
    }
  </Container>
</section>
