---
import type { ImageMetadata } from "astro";

import Container from "~/components/ui/Container.astro";
import PageMasthead from "~/components/ui/PageMasthead.astro";
import { ALL_TERMS, type Filter } from "~/features/editorial/presenters";

interface ImageCredit {
  creator: string;
  sourceHref: string;
  license: string;
  licenseHref: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  /** Printed beside the title, for example "38 entries". */
  count?: string;
  filters?: readonly Filter[];
  filtersLabel?: string;
  /**
   * The query key a chosen filter is remembered in, such as `category`. It is
   * what makes a narrowed index linkable without publishing a page per term.
   */
  filterKey?: string;
  /**
   * The term the lead entry is filed under, so the lead is put away with the
   * rest of its category when a different one is chosen.
   */
  leadTerm?: string;
  /** How the count words itself as the filter changes the number shown. */
  countNoun?: { one: string; other: string };
  /** Shown in place of the list when nothing has been published yet. */
  empty?: string;
  isEmpty?: boolean;
  /** Optional decorative photograph behind the shared page masthead. */
  backgroundImage?: ImageMetadata;
  backgroundLabel?: string;
  backgroundCredit?: ImageCredit;
  /**
   * Whether to wrap the default slot in the shared card grid. Set false when a
   * section renders its own body, such as the book readings table.
   */
  list?: boolean;
  /**
   * Names the grid when a lead entry sits above it, for example "Earlier
   * statements". A run of cards under a lead needs to say what it is, or the
   * lead reads as a duplicate of the first card.
   */
  listLabel?: string;
  /**
   * How many entries the default slot holds. Given, a short index stops
   * reserving columns it cannot fill: two comics in a three-column grid left a
   * third of the row empty, which reads as a missing entry rather than as the
   * end of the list.
   */
  itemCount?: number;
}
const {
  eyebrow,
  title,
  description,
  count,
  filters = [],
  filtersLabel = "Filter",
  filterKey,
  leadTerm,
  countNoun,
  empty,
  isEmpty = false,
  backgroundImage,
  backgroundLabel,
  backgroundCredit,
  list = true,
  listLabel = "More",
  itemCount,
} = Astro.props;

/*
 * A grid never wider than the list that has to fill it. Left at three columns a
 * two-entry index reserved a third of the row for nothing, and an empty track
 * at the end of a row reads as an entry that failed to load.
 */
const gridColumns =
  itemCount === 1
    ? "grid-cols-1"
    : itemCount === 2
      ? "grid-cols-1 sm:grid-cols-2"
      : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3";

/*
 * Whether a lead was actually passed, rather than whether the slot exists.
 * `Astro.slots.has` answers the second question: a page that writes
 * `{lead && <EntryLead slot="lead" />}` still declares the slot when `lead` is
 * undefined, so a short index — a blog category with two articles — rendered an
 * empty band of white paper under its masthead. Rendering the slot and looking
 * at what came out is the only reliable answer.
 */
const leadHtml = Astro.slots.has("lead")
  ? (await Astro.slots.render("lead")).trim()
  : "";

/*
 * The meta line, worded here when the caller gives a noun rather than a
 * finished string. A filtered index rewrites it as the number shown changes,
 * and it can only do that if it knows how to say "1 article" as well as "8".
 */
const total =
  itemCount === undefined ? undefined : itemCount + (leadHtml ? 1 : 0);
const meta =
  count ??
  (countNoun && total !== undefined
    ? `${total} ${total === 1 ? countNoun.one : countNoun.other}`
    : undefined);

// A filter row narrows this index in place. It is only wired up when the
// caller says which query key remembers the choice; see `index-filter.ts`.
const filtering = filters.length > 0 && filterKey !== undefined;
---

<section
  data-index-filter={filtering ? filterKey : undefined}
  data-count-one={filtering ? countNoun?.one : undefined}
  data-count-other={filtering ? countNoun?.other : undefined}
>
  <PageMasthead
    eyebrow={eyebrow}
    title={title}
    description={description}
    meta={meta}
    backgroundImage={backgroundImage}
    backgroundLabel={backgroundLabel}
    backgroundCredit={backgroundCredit}
  />

  {
    /*
      The lead sits on its own band of paper between the ink masthead and the
      grid. Banding it rather than running it into the same surface as the
      cards is what makes an index read as a page with parts: ink, then paper,
      then the page's own ground. Every index used to be one flat field from
      the masthead to the footer.
    */
    leadHtml && (
      <div
        class="border-b border-rule bg-paper"
        data-filter-lead={filtering ? "" : undefined}
        data-filter-term={filtering ? leadTerm : undefined}
      >
        <Container class="py-14 sm:py-16">
          <Fragment set:html={leadHtml} />
        </Container>
      </div>
    )
  }

  <Container class="pt-16 pb-20 sm:pt-20 sm:pb-28">
    <!-- Standing context a section may need above its entries, such as how
      the reading circle meets. Most indexes leave this empty. -->
    <slot name="intro" />

    {
      /*
        The filter row sits with the cards it filters, not up in the masthead.
        On a phone the masthead is a screen of its own, so a chip pressed up
        there changed a list the reader could not see and the page appeared not
        to have done anything. Here the result of a press is the next thing
        under it at every width.
      */
      filters.length > 0 && (
        <div
          class="mb-9"
          role="group"
          aria-label={filtersLabel}
          data-filter-controls
        >
          <ul class="flex flex-wrap gap-x-5 gap-y-2">
            {filters.map((filter) => (
              <li>
                <button
                  type="button"
                  class="inline-block cursor-pointer border-b-2 border-transparent py-2 font-display text-[0.875rem] font-medium text-ambedkar-900/70 transition-colors hover:border-ambedkar-900/25 hover:text-ambedkar-900 aria-pressed:border-accent-600 aria-pressed:text-ambedkar-900"
                  data-filter-value={filter.value}
                  aria-pressed={filter.value === ALL_TERMS}
                >
                  {filter.label}
                </button>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      isEmpty ? (
        <p class="card max-w-2xl px-6 py-8 leading-7 text-ambedkar-900/75">
          {empty}
        </p>
      ) : list ? (
        <>
          {leadHtml && (
            <h2
              class="label mb-7 text-ambedkar-900/55"
              data-filter-list-label={filtering ? "" : undefined}
            >
              {listLabel}
            </h2>
          )}
          {/*
            `grid-cols-1` is not redundant. Without a column definition the base
            grid has a single implicit `auto` track, which is content-sized: a
            card holding a 1800px poster can size the track to the poster's
            intrinsic width and push the row far past the container. The larger
            breakpoints never had the bug because `grid-cols-*` expands to
            `minmax(0, 1fr)`, which ignores max-content, so the fault only ever
            showed on a phone. This states the same track for the base.
          */}
          <ul class:list={["reveal-children grid gap-5", gridColumns]}>
            <slot />
          </ul>
        </>
      ) : (
        <slot />
      )
    }
  </Container>
</section>

<script>
  import { mountIndexFilters } from "~/features/editorial/index-filter";

  mountIndexFilters();
</script>
