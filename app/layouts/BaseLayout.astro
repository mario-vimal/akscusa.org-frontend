---
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import instrumentSansLatin from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-normal.woff2?url";

import appleTouchIcon from "~/assets/brand/apple-touch-icon.png";
import favicon from "~/assets/brand/favicon.png";
import logo from "~/assets/brand/aksc-logo.webp";
import "~/styles/global.css";

interface Props {
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const siteName = "Ambedkar King Study Circle USA";
const documentTitle = title ? `${title} | ${siteName}` : siteName;
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const socialImageUrl = new URL(logo.src, canonicalUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!--
      `initial-scale=1` is what stops iOS Safari rescaling the whole document.
      Without it Safari is free to pick the initial scale, and it picks one that
      fits the widest thing on the page: a single overflowing element then
      shrinks every other page to a quarter size rather than just scrolling
      sideways. Pinning the scale keeps overflow a local bug. `maximum-scale`
      and `user-scalable` are deliberately absent so pinch zoom still works.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:alt" content={`${siteName} logo`} />
    <meta property="og:image:width" content={String(logo.width)} />
    <meta property="og:image:height" content={String(logo.height)} />
    <meta name="twitter:card" content="summary" />
    <!-- Both faces appear in every header; serif and italic files stay demand-loaded. -->
    <link
      rel="preload"
      href={archivoLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={instrumentSansLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <title>{documentTitle}</title>
  </head>
  <body>
    <a
      class="sr-only z-50 rounded-md bg-white px-4 py-2 font-semibold text-ambedkar-950 focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
      href="#main-content"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
