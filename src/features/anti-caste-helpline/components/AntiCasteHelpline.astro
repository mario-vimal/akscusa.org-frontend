---
import type { CollectionEntry } from "astro:content";

import Container from "../../../components/ui/Container.astro";
import ResponsiveImage from "../../../components/ui/ResponsiveImage.astro";
import helplineBanner from "../assets/helpline-banner.jpg";
import helplineFlyer from "../assets/helpline-flyer.jpg";

type Props = Extract<
  CollectionEntry<"pages">["data"],
  { pageType: "helpline" }
>;

const {
  title,
  eyebrow,
  emergencyDanger,
  emergencyCrisis,
  supportQuestions,
  phone,
  email,
  contactNote,
  bannerAlt,
  flyerAlt,
  flyerCaption,
} = Astro.props;
---

<section
  class="border-b border-red-950/10 bg-red-50 text-red-950"
  aria-label="Emergency information"
>
  <Container class="py-3 text-center text-sm leading-6 font-semibold">
    {emergencyDanger}{" "}
    <a class="underline decoration-2 underline-offset-2" href="tel:911">911</a>. {
      emergencyCrisis
    }{" "}
    <a class="underline decoration-2 underline-offset-2" href="tel:988">988</a>.
  </Container>
</section>

<section aria-labelledby="helpline-title">
  <Container class="py-8 sm:py-12">
    <ResponsiveImage
      src={helplineBanner}
      alt={bannerAlt}
      class="w-full rounded-2xl border border-ambedkar-900/10 shadow-soft"
      loading="eager"
      sizes="(min-width: 1152px) 1152px, calc(100vw - 3rem)"
    />

    <div
      class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,26rem)] lg:items-start"
    >
      <div>
        <p
          class="text-sm font-bold tracking-[0.18em] text-ambedkar-700 uppercase"
        >
          {eyebrow}
        </p>
        <h1
          id="helpline-title"
          class="mt-4 text-4xl leading-tight font-semibold tracking-[-0.04em] text-balance text-ambedkar-950 sm:text-6xl"
        >
          {title}
        </h1>

        <ul class="mt-8 space-y-4 text-lg leading-8 text-ambedkar-900/80">
          {
            supportQuestions.map((question) => (
              <li class="flex gap-3">
                <span
                  class="mt-3 size-2 shrink-0 rounded-full bg-saffron-400"
                  aria-hidden="true"
                />
                <span>{question}</span>
              </li>
            ))
          }
        </ul>

        <div
          class="mt-10 rounded-3xl bg-ambedkar-900 p-6 text-white shadow-soft sm:p-8"
          aria-labelledby="contact-title"
        >
          <h2 id="contact-title" class="text-2xl font-semibold">
            Contact the helpline
          </h2>
          <div class="mt-5 flex flex-col gap-3">
            <a
              class="w-fit text-xl font-semibold text-saffron-300 underline decoration-2 underline-offset-4 sm:text-2xl"
              href={phone.href}
            >
              {phone.display}
            </a>
            <a
              class="w-fit text-lg font-semibold break-all text-saffron-300 underline decoration-2 underline-offset-4 sm:text-xl"
              href={`mailto:${email}`}
            >
              {email}
            </a>
          </div>
          <p class="mt-5 leading-7 text-white/80">
            {contactNote}
          </p>
        </div>

        <div
          class="helpline-content mt-10 text-base leading-8 text-ambedkar-900/75"
        >
          <slot />
        </div>
      </div>

      <figure
        class="rounded-3xl border border-ambedkar-900/10 bg-white p-3 shadow-soft sm:p-4"
      >
        <ResponsiveImage
          src={helplineFlyer}
          alt={flyerAlt}
          class="w-full rounded-2xl"
          sizes="(min-width: 1024px) 416px, calc(100vw - 5rem)"
          widths={[320, 640, 960]}
        />
        <figcaption
          class="px-2 pt-4 pb-2 text-sm leading-6 text-ambedkar-900/65"
        >
          {flyerCaption}
        </figcaption>
      </figure>
    </div>
  </Container>
</section>

<style>
  .helpline-content :global(p + p) {
    margin-top: 1.5rem;
  }

  .helpline-content :global(ol) {
    margin-top: 1.5rem;
    list-style-type: decimal;
    padding-left: 1.5rem;
  }

  .helpline-content :global(li + li) {
    margin-top: 0.75rem;
  }

  .helpline-content :global(strong) {
    color: var(--color-ambedkar-950);
  }

  .helpline-content :global(a) {
    color: var(--color-ambedkar-700);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
</style>
