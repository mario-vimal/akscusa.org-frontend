# Sveltia CMS backend repository.
#
# `cms/admin/config.yml` deliberately ships a placeholder, so a local dev server
# can never commit to the live site. Signing in to the CMS with GitHub commits to
# whichever repository is named here.
#
# Leave this unset and choose "Work with Local Repository" on /admin/ to edit
# your working copy only. Set it to your own fork to test the GitHub sign-in
# flow. The live deployment sets CMS_REPO=akscsfba/akscusa.org-frontend.
#
# CMS_REPO=your-username/akscusa.org-frontend
